<rml>
<head>
  <title>LastToSurvive Editor</title>
  <link type="text/rcss" href="EditorLauncher.rcss"/>
</head>
<body>
  <div id="launcher">
    <div class="brand"><h1>LAST TO SURVIVE</h1><p>EDITOR HUB</p></div>
    <div class="menu">
      <button id="launch-test-game">TEST GAME</button>
      <button id="open-level-editor">LEVEL EDITOR</button>
      <button id="open-character-editor">CHARACTER EDITOR</button>
      <button id="open-physics-editor">PHYSICS EDITOR</button>
      <button id="open-fbx-importer">FBX IMPORTER</button>
      <button id="open-icon-generator">ICON GENERATOR</button>
      <button id="exit-editor" class="danger">EXIT</button>
    </div>
    <div id="launcher-status">READY</div>
  </div>
</body>
</rml>
