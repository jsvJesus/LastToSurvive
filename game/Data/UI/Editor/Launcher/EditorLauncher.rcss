* {
  box-sizing: border-box;
}

body {
  margin: 0;
  width: 100%;
  height: 100%;
  background: #090d0d;
  color: #d8dfd9;
  font-family: Roboto;
}

#launcher {
  position: relative;
  width: 100%;
  height: 100%;
  background: linear-gradient(120deg, #101817, #090c0c 70%);
}

.brand {
  position: absolute;
  left: 86px;
  top: 64px;
  width: 620px;
  padding-left: 18px;
  border-left: 4px #8ea75c;
}

h1 {
  display: block;
  margin: 0;
  color: #edf1e8;
  font-size: 38px;
  letter-spacing: 5px;
}

.brand p {
  display: block;
  margin: 8px 0 0;
  color: #8ea75c;
  letter-spacing: 7px;
}

.menu {
  position: absolute;
  left: 86px;
  top: 190px;
  width: 430px;
}

button {
  display: block;
  width: 430px;
  height: 54px;
  margin: 8px 0;
  padding: 0 18px;
  background: #18211f;
  border: 1px #34423c;
  color: #d8dfd9;
  font-size: 17px;
  letter-spacing: 2px;
  line-height: 54px;
  text-align: left;
}

button:hover {
  background: #28372f;
  border-color: #8ea75c;
  color: #ffffff;
}

button:active {
  background: #8ea75c;
  color: #101410;
}

button.danger {
  margin-top: 24px;
  border-color: #5c3230;
}

button.danger:hover {
  background: #4a2524;
  border-color: #b65b55;
}

#launcher-status {
  position: absolute;
  left: 86px;
  bottom: 42px;
  color: #718079;
  letter-spacing: 2px;
}
