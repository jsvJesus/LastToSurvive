body {
  margin: 0;
  width: 100%;
  height: 100%;
  background: #0e1313;
  color: #d9dfda;
  font-family: Roboto;
}

.module {
  width: 720px;
  padding: 48px;
}

h1 {
  color: #9aaa70;
  letter-spacing: 4px;
}

label {
  display: block;
  margin-top: 18px;
  color: #84918a;
}

input[type=text] {
  display: block;
  width: 100%;
  height: 36px;
  margin: 6px 0 16px;
  background: #171e1d;
  border: 1px #39443f;
  color: white;
}

button {
  display: block;
  margin-top: 22px;
  padding: 12px 20px;
  background: #26312e;
  border: 1px #71805c;
  color: #e3e8e3;
}

#import-result {
  margin-top: 18px;
  color: #87938c;
}
