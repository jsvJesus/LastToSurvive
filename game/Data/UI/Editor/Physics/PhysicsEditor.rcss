body {
  margin: 0;
  width: 100%;
  height: 100%;
  background: #0e1313;
  color: #d9dfda;
  font-family: Roboto;
}

.module {
  padding: 48px;
}

h1 {
  color: #9aaa70;
  letter-spacing: 4px;
}

#viewport {
  height: 540px;
  margin: 24px 0;
  padding: 20px;
  background: #171e1d;
  border: 1px #39443f;
}

button {
  padding: 12px 20px;
  background: #26312e;
  border: 1px #71805c;
  color: #e3e8e3;
}
