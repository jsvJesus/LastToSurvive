<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WarZ.LegacyHost</RootNamespace>
    <AssemblyName>WarZ.LegacyHost</AssemblyName>
    <UserSecretsId>LastToSurvive-WarZ-Backend</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../../api/Site/App_Code/*.cs"
             Exclude="../../../api/Site/App_Code/IPLocationCheck.cs"
             Link="Legacy/App_Code/%(Filename)%(Extension)" />
    <Compile Include="../../../api/Site/*.aspx.cs"
             Link="Legacy/Endpoints/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
