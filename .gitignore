# Ignore everything in repository root by default
/*

# Keep only project source/backend folders
!/.gitignore
!/.gitattributes
!/README.md
!/src/
!/api/
!/sql/
!/server/
!/External/
!/docs/
!/docs/**
!/tools/
!/tools/RmlLiveEditor/
!/tools/RmlLiveEditor/**

# Keep only RmlUI source package from External
/External/*
!/External/RmlUI/
!/External/RmlUI/**

# Keep only use sdk from External
!/External/dxsdk/Include/
!/External/dxsdk/Include/**
!/External/discord_social_sdk/include/
!/External/discord_social_sdk/include/**

# Explicitly exclude root runtime/build folder
/bin/

# Visual Studio / Rider
.vs/
.idea/
.vscode/.cache/
*.user
*.suo
*.VC.db
*.VC.VC.opendb
*.opensdf
*.sdf
*.ipch
ipch/

# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Ff]inal/
x64/
Win32/
.vsbuild/
GeneratedFiles/

# Native build artifacts
*.exe
*.dll
*.lib
*.obj
*.pch
*.pdb
*.ilk
*.idb
*.iobj
*.ipdb
*.tlog
*.lastbuildstate
*.log
*.exp
*.map
*.res
*.tmp

# RmlUI packaged binaries/build output
/External/RmlUI/Bin-Dynamic/
/External/RmlUI/Bin-Static/
/External/RmlUI/**/[Bb]in/
/External/RmlUI/**/[Oo]bj/
/External/RmlUI/**/[Dd]ebug/
/External/RmlUI/**/[Rr]elease/
/External/RmlUI/**/*.dll
/External/RmlUI/**/*.lib
/External/RmlUI/**/*.pdb
/External/RmlUI/**/*.exe
/External/RmlUI/**/*.ilk
/External/RmlUI/**/*.exp
/External/RmlUI/**/*.map

# Crash/debug/runtime junk
*.dmp
*.mdmp
*.stackdump
*.crash
r3dlog.txt
*.log.*

# Large archives/installers/images
*.zip
*.rar
*.7z
*.tar
*.gz
*.iso
*.msi

# Large media/assets usually should not go to normal git
*.mp4
*.avi
*.wmv
*.mov
*.psd
*.fbx
*.bank
*.fsb
*.fev

# NuGet / .NET / Avalonia
.nuget/
packages/
*.nupkg

# Keep only selected runtime data under root bin
!/bin/
/bin/*
!/tools/
/tools/*
!/bin/Data/
/bin/Data/*
!/bin/Data/Rml/
!/bin/Data/Rml/**
!/bin/Data/Shaders/
/bin/Data/Shaders/*
!/bin/Data/Shaders/DX9_P1/
!/bin/Data/Shaders/DX9_P1/**
!/bin/Data/Shaders/DX11_P1/
!/bin/Data/Shaders/DX11_P1/**
!/bin/Data/Weapons/
!/bin/Data/Weapons/**
