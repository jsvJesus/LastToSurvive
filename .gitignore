# Ignore everything in repository root by default
/*

# Keep only project source/backend folders
!/.gitignore
!/.gitattributes
!/README.md
!/src/
!/api/
!/sql/
!/server/

# Explicitly exclude root runtime/build folder
/bin/
/External/

# Visual Studio / Rider
.vs/
.idea/
.vscode/.cache/
*.user
*.suo
*.VC.db
*.VC.VC.opendb
*.opensdf
*.sdf
*.ipch
ipch/

# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Ff]inal/
x64/
Win32/
.vsbuild/
GeneratedFiles/

# Native build artifacts
*.exe
*.dll
*.lib
*.obj
*.pch
*.pdb
*.ilk
*.idb
*.iobj
*.ipdb
*.tlog
*.lastbuildstate
*.log
*.exp
*.map
*.res
*.tmp

# Crash/debug/runtime junk
*.dmp
*.mdmp
*.stackdump
*.crash
r3dlog.txt
*.log.*

# Large archives/installers/images
*.zip
*.rar
*.7z
*.tar
*.gz
*.iso
*.msi

# Large media/assets usually should not go to normal git
*.mp4
*.avi
*.wmv
*.mov
*.psd
*.fbx
*.bank
*.fsb
*.fev

# NuGet / .NET / Avalonia
.nuget/
packages/
*.nupkg
