/* ============================================================
   SKILLS SCREEN ONLY
   ============================================================ */

.skills_body {
	background-color: #030506;
}

.skills_layout {
	position: absolute;
	left: 28px;
	right: 28px;
	top: 104px;
	bottom: 42px;

	z-index: 12;

	display: flex;
	flex-direction: row;
}

.skills_panel {
	position: relative;

	height: 100%;

	background-color: rgba(8, 12, 15, 0.90);
	decorator: linear-gradient(180deg, #1d262b, #0d1316 58%, #06090b) border-box;

	border-width: 1px;
	border-color: rgba(88, 100, 106, 0.62);

	overflow: hidden;
}

.skills_left_panel {
	width: 292px;

	margin-right: 12px;
	padding: 16px;

	flex-shrink: 0;
}

.skills_tree_panel {
	flex-grow: 1;

	margin-right: 12px;
	padding: 16px;
}

.skills_details_panel {
	width: 318px;

	padding: 16px;

	flex-shrink: 0;
}

.skills_panel_header,
.skills_tree_header {
	width: 100%;
	height: 58px;

	display: flex;
	justify-content: space-between;
	align-items: center;

	border-bottom-width: 1px;
	border-bottom-color: rgba(84, 96, 102, 0.55);
}

.skills_panel_title {
	color: #ffffff;

	font-size: 17px;
	font-weight: bold;
	line-height: 18px;
	letter-spacing: 1px;
}

.skills_panel_subtitle {
	margin-top: 4px;

	color: #e17332;

	font-size: 9px;
	font-weight: bold;
	line-height: 10px;
	letter-spacing: 2px;
}

.skills_points_box {
	width: 58px;
	height: 42px;

	padding-top: 6px;

	background-color: rgba(161, 54, 47, 0.92);

	border-width: 1px;
	border-color: #d75f51;

	text-align: center;
}

.skills_points_label {
	color: #ffffff;

	font-size: 8px;
	font-weight: bold;
	letter-spacing: 1px;
}

.skills_points_value {
	color: #ffffff;

	font-size: 17px;
	font-weight: bold;
	line-height: 18px;
}

.skills_survivor_card {
	width: 100%;
	height: 78px;

	margin-top: 14px;

	display: flex;

	background-color: rgba(5, 8, 10, 0.66);

	border-width: 1px;
	border-color: rgba(67, 78, 84, 0.66);
}

.skills_survivor_level {
	width: 66px;
	height: 76px;

	padding-top: 12px;

	background-color: rgba(160, 55, 47, 0.88);

	text-align: center;

	flex-shrink: 0;
}

.skills_survivor_level_number {
	color: #ffffff;

	font-size: 28px;
	font-weight: bold;
	line-height: 30px;
}

.skills_survivor_level_label {
	margin-top: 2px;

	color: #ffd8d3;

	font-size: 7px;
	font-weight: bold;
	letter-spacing: 1px;
}

.skills_survivor_info {
	width: 192px;

	padding: 12px 12px 8px 12px;
}

.skills_survivor_name {
	color: #ffffff;

	font-size: 14px;
	font-weight: bold;
	line-height: 16px;
}

.skills_survivor_class {
	margin-top: 3px;

	color: #e17332;

	font-size: 8px;
	font-weight: bold;
	letter-spacing: 1px;
}

.skills_xp_bar {
	position: relative;

	width: 100%;
	height: 5px;

	margin-top: 9px;

	background-color: #11191d;

	border-width: 1px;
	border-color: #354047;
}

.skills_xp_fill {
	width: 0%;
	height: 100%;

	background-color: #c44739;
}

.skills_xp_text {
	margin-top: 5px;

	color: #9fa9ad;

	font-size: 8px;
	font-weight: bold;
}

.skills_category_title {
	margin-top: 18px;
	margin-bottom: 8px;

	color: #737f85;

	font-size: 8px;
	font-weight: bold;
	letter-spacing: 2px;
}

.skill_category_button {
	width: 100%;
	height: 58px;

	margin-bottom: 8px;

	display: flex;
	align-items: center;

	text-align: left;

	background-color: rgba(9, 14, 17, 0.82);

	border-color: rgba(64, 76, 82, 0.72);
}

.skill_category_button.active,
.skill_category_button.selected,
.skill_category_button:hover {
	background-color: rgba(91, 35, 29, 0.90);

	border-color: #d45c4c;
	border-left-width: 4px;
	border-left-color: #ff8f55;
}

.skill_category_code {
	width: 46px;

	color: #ffffff;

	font-size: 13px;
	text-align: center;

	flex-shrink: 0;
}

.skill_category_text {
	width: 206px;
}

.skill_category_name {
	color: #ffffff;

	font-size: 13px;
	font-weight: bold;
	line-height: 14px;
}

.skill_category_desc {
	margin-top: 4px;

	color: #8f9a9f;

	font-size: 9px;
	font-weight: normal;
	line-height: 12px;
}

.skills_reset_block {
	position: absolute;
	left: 16px;
	right: 16px;
	bottom: 16px;
}

.skills_reset_button,
.learn_skill_button {
	width: 100%;
	height: 42px;

	background-color: rgba(153, 54, 45, 0.94);
	decorator: linear-gradient(180deg, #cc5548, #96352e 54%, #541b18) border-box;

	border-color: #d75f51;

	font-size: 13px;
	letter-spacing: 1px;
}

.skills_reset_hint,
.skill_details_status {
	margin-top: 10px;

	color: #7c878c;

	font-size: 10px;
	line-height: 14px;
}

.skills_tree_legend {
	display: flex;
	align-items: center;

	color: #9aa4a8;

	font-size: 8px;
	font-weight: bold;
	letter-spacing: 1px;
}

.skill_legend_item {
	margin-left: 12px;

	display: flex;
	align-items: center;
}

.skill_legend_dot {
	width: 9px;
	height: 9px;

	margin-right: 5px;

	border-width: 1px;
}

.skill_legend_dot.learned {
	background-color: #4fb066;
	border-color: #91d99d;
}

.skill_legend_dot.available {
	background-color: #d47332;
	border-color: #ff9a55;
}

.skill_legend_dot.locked {
	background-color: #343c41;
	border-color: #59646a;
}

.skill_tree_map {
	position: absolute;
	left: 16px;
	right: 16px;
	top: 88px;
	bottom: 16px;

	display: flex;
	justify-content: space-between;
}

.skill_tree_column {
	width: 24%;
	height: 100%;

	margin-right: 1%;
}

.skill_tree_column.last {
	margin-right: 0px;
}

.skill_branch_title {
	width: 100%;
	height: 30px;

	color: #e17332;

	font-size: 9px;
	font-weight: bold;
	letter-spacing: 2px;
	text-align: center;
}

.skill_node {
	position: relative;

	width: 100%;
	height: 82px;

	margin-bottom: 8px;
	padding: 10px;

	background-color: rgba(8, 12, 15, 0.92);

	border-width: 1px;
	border-color: rgba(64, 76, 82, 0.72);

	text-align: center;
}

.skill_node.learned {
	border-color: #6ebf78;
}

.skill_node.available {
	border-color: #d47332;
}

.skill_node.locked {
	opacity: 0.62;
	border-color: #59646a;
}

.skill_node.selected,
.skill_node:hover {
	background-color: rgba(91, 35, 29, 0.90);
	border-color: #f1765a;
}

.skill_node_rank {
	color: #e17332;

	font-size: 14px;
	font-weight: bold;
}

.skill_node_name {
	margin-top: 7px;

	color: #ffffff;

	font-size: 11px;
	font-weight: bold;
	line-height: 13px;
}

.skill_node_level {
	margin-top: 5px;

	color: #8f9a9f;

	font-size: 8px;
	font-weight: bold;
}

.skill_connector {
	width: 2px;
	height: 18px;

	margin-left: 50%;
	margin-bottom: 8px;

	background-color: #46535a;
}

.skill_connector.learned {
	background-color: #6ebf78;
}

.skill_connector.available {
	background-color: #d47332;
}

.skill_connector.locked {
	background-color: #343c41;
}

/* DETAILS */

.selected_skill_state {
	width: 88px;
	height: 26px;

	padding-top: 8px;

	color: #ffffff;
	background-color: rgba(161, 54, 47, 0.90);

	border-width: 1px;
	border-color: #d75f51;

	font-size: 8px;
	font-weight: bold;
	text-align: center;
	letter-spacing: 1px;
}

.selected_skill_card {
	width: 100%;
	height: 72px;

	margin-top: 16px;

	display: flex;

	background-color: rgba(5, 8, 10, 0.66);

	border-width: 1px;
	border-color: rgba(67, 78, 84, 0.66);
}

.selected_skill_icon {
	width: 58px;
	height: 70px;

	padding-top: 22px;

	color: #ffffff;
	background-color: rgba(160, 55, 47, 0.88);

	font-size: 18px;
	font-weight: bold;
	text-align: center;
}

.selected_skill_main {
	padding: 16px 12px;
}

.selected_skill_name {
	color: #ffffff;

	font-size: 16px;
	font-weight: bold;
}

.selected_skill_category {
	margin-top: 4px;

	color: #e17332;

	font-size: 8px;
	font-weight: bold;
	letter-spacing: 1px;
}

.selected_skill_description {
	margin-top: 16px;

	color: #aab3b8;

	font-size: 11px;
	line-height: 16px;
}

.skill_detail_rows {
	margin-top: 18px;
}

.skill_detail_row {
	width: 100%;
	height: 32px;

	display: flex;
	justify-content: space-between;
	align-items: center;

	border-bottom-width: 1px;
	border-bottom-color: rgba(67, 78, 84, 0.40);
}

.skill_detail_label {
	color: #737f85;

	font-size: 9px;
	font-weight: bold;
	letter-spacing: 1px;
}

.skill_detail_value {
	color: #ffffff;

	font-size: 11px;
	font-weight: bold;
}

.skill_detail_value.orange {
	color: #e17332;
}

.skill_requirements_box {
	margin-top: 18px;

	padding: 12px;

	background-color: rgba(5, 8, 10, 0.66);

	border-width: 1px;
	border-color: rgba(67, 78, 84, 0.66);
}

.skill_requirements_title {
	color: #e17332;

	font-size: 8px;
	font-weight: bold;
	letter-spacing: 2px;
}

.skill_requirement {
	margin-top: 8px;

	font-size: 9px;
	line-height: 12px;
}

.skill_requirement.passed {
	color: #8cd496;
}

.skill_requirement.failed {
	color: #d96d2a;
}
