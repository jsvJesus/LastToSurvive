<rml>
<head>
	<title>Last To Survive Main Menu</title>
	<link type="text/rcss" href="FrontEnd.rcss"/>
</head>

<body class="frontend_body main_menu_body">

	<div
		id="shop_background_stage"
		class="frontend_static_background"
	>
		<img
			id="shop_background_image"
			class="frontend_static_background_image"
			src="../Assets/bg.png"
		/>

		<div class="frontend_static_background_shade"></div>
		<div class="main_menu_scene_vignette"></div>
		<div class="skills_scene_scrim"></div>
	</div>

	<div
		id="character_preview_stage"
		class="main_menu_scene"
	>
		<img
			id="character_preview_texture"
			class="main_menu_scene_texture"
			src="rml://character-preview"
		/>

		<div class="main_menu_scene_shade"></div>
		<div class="main_menu_scene_vignette"></div>
	</div>

	<div class="frontend_shell_topbar">

		<img
			class="frontend_topbar_background"
			src="../Assets/FrontEnd/Top_Bar.png"
		/>

		<div class="frontend_topbar_content">

			<div class="top_faction_block">
				<div id="top_faction_icon" class="top_faction_icon">F</div>

				<div class="top_faction_info">
					<div class="top_faction_caption">FACTION</div>
					<div id="top_survivor_name" class="top_faction_name">EX MILITARY</div>
					<div id="top_survivor_role" class="top_faction_level">LEVEL 1</div>
				</div>
			</div>

			<div class="top_currency_block">
				<div class="top_currency_item currency_zc">
					<img class="top_currency_icon_image" src="../Assets/btn_store/btn_money_zc.png"/>
					<div id="balance_gc" class="top_currency_value">0</div>
					<button id="btn_money_zc" class="top_currency_add">+</button>
				</div>

				<div class="top_currency_item currency_zd">
					<img class="top_currency_icon_image" src="../Assets/btn_store/btn_money_zd.png"/>
					<div id="balance_gd" class="top_currency_value">0</div>
					<button id="btn_money_zd" class="top_currency_add">+</button>
				</div>

				<div class="top_currency_item currency_zlt">
					<img class="top_currency_icon_image" src="../Assets/btn_store/btn_money_zlt.png"/>
					<div id="balance_zlt" class="top_currency_value">0</div>
				</div>
				<div id="balance_ltc" class="runtime_hidden_value">0</div>
			</div>

			<div class="frontend_navigation">
			<button id="nav_home" class="top_navigation_button active">
				<img class="top_navigation_texture top_navigation_texture_base" src="../Assets/FrontEnd/button_top_bar.png"/>
				<img class="top_navigation_texture top_navigation_texture_active" src="../Assets/FrontEnd/button_active_top_bar.png"/>
				<img class="top_navigation_texture top_navigation_texture_hover" src="../Assets/FrontEnd/button_active_top_bar.png"/>
				<div class="top_navigation_label">HOME</div>
			</button>
			<button id="nav_skills" class="top_navigation_button">
				<img class="top_navigation_texture top_navigation_texture_base" src="../Assets/FrontEnd/button_top_bar.png"/>
				<img class="top_navigation_texture top_navigation_texture_active" src="../Assets/FrontEnd/button_active_top_bar.png"/>
				<img class="top_navigation_texture top_navigation_texture_hover" src="../Assets/FrontEnd/button_active_top_bar.png"/>
				<div class="top_navigation_label">SKILLS</div>
			</button>
			<button id="nav_equipment" class="top_navigation_button">
				<img class="top_navigation_texture top_navigation_texture_base" src="../Assets/FrontEnd/button_top_bar.png"/>
				<img class="top_navigation_texture top_navigation_texture_active" src="../Assets/FrontEnd/button_active_top_bar.png"/>
				<img class="top_navigation_texture top_navigation_texture_hover" src="../Assets/FrontEnd/button_active_top_bar.png"/>
				<div class="top_navigation_label">EQUIPMENT</div>
			</button>
			<button id="nav_shop" class="top_navigation_button">
				<img class="top_navigation_texture top_navigation_texture_base" src="../Assets/FrontEnd/button_top_bar.png"/>
				<img class="top_navigation_texture top_navigation_texture_active" src="../Assets/FrontEnd/button_active_top_bar.png"/>
				<img class="top_navigation_texture top_navigation_texture_hover" src="../Assets/FrontEnd/button_active_top_bar.png"/>
				<div class="top_navigation_label">SHOP</div>
			</button>
			<button id="nav_clan" class="top_navigation_button">
				<img class="top_navigation_texture top_navigation_texture_base" src="../Assets/FrontEnd/button_top_bar.png"/>
				<img class="top_navigation_texture top_navigation_texture_active" src="../Assets/FrontEnd/button_active_top_bar.png"/>
				<img class="top_navigation_texture top_navigation_texture_hover" src="../Assets/FrontEnd/button_active_top_bar.png"/>
				<div class="top_navigation_label">CLAN</div>
			</button>
			<button id="nav_awards" class="top_navigation_button">
				<img class="top_navigation_texture top_navigation_texture_base" src="../Assets/FrontEnd/button_top_bar.png"/>
				<img class="top_navigation_texture top_navigation_texture_active" src="../Assets/FrontEnd/button_active_top_bar.png"/>
				<img class="top_navigation_texture top_navigation_texture_hover" src="../Assets/FrontEnd/button_active_top_bar.png"/>
				<div class="top_navigation_label">AWARDS</div>
			</button>
			</div>

			<div class="frontend_account_actions">
				<button id="btn_change_name" class="top_icon_button">
					<div class="top_icon_glyph cart_icon">
						<img class="top_icon_image" src="../Assets/btn_ico/btn_change_name.png"/>
					</div>
					<div class="account_action_tooltip">CHANGE NAME</div>
				</button>
				<button id="btn_change_character" class="top_icon_button">
					<div class="top_icon_glyph">
						<img class="top_icon_image" src="../Assets/btn_ico/btn_change_character.png"/>
					</div>
					<div class="account_action_tooltip">CHANGE CHARACTER</div>
				</button>
				<button id="btn_find_friend" class="top_icon_button">
					<div class="top_icon_glyph">
						<img class="top_icon_image" src="../Assets/btn_ico/btn_find_friend.png"/>
					</div>
					<div class="account_action_tooltip">FRIENDS</div>
				</button>
				<button id="btn_rewards" class="top_icon_button">
					<div class="top_icon_glyph">
						<img class="top_icon_image" src="../Assets/btn_ico/btn_rewards.png"/>
					</div>
					<div class="account_action_tooltip">MISSIONS</div>
				</button>
				<button id="btn_settings" class="top_icon_button">
					<div class="top_icon_glyph">
						<img class="top_icon_image" src="../Assets/btn_ico/btn_settings.png"/>
					</div>
					<div class="account_action_tooltip">SETTINGS</div>
				</button>
				<button id="btn_frontend_exit" class="top_icon_button">
					<div class="top_icon_glyph">
						<img class="top_icon_image" src="../Assets/btn_ico/btn_frontend_exit.png"/>
					</div>
					<div class="account_action_tooltip">EXIT</div>
				</button>
			</div>

		</div>

	</div>

	<div id="mainmenu_dashboard" class="mainmenu_dashboard">

		<div id="card_news" class="mm_card">
			<div class="mm_card_line"></div>

			<div class="mm_card_top">
				<div class="mm_card_kicker">NEWS</div>
				<div class="mm_card_chip">LIVE</div>
			</div>

			<div id="news_title" class="mm_card_title">SafeZone deployment online</div>

			<div id="news_body" class="mm_card_text">
				SafeZone is now the first deployment point. Open World access is routed through NPC transition.
			</div>

			<button id="btn_news_more" class="mm_card_button">MORE</button>
		</div>

		<div id="card_featured_shop" class="mm_card">
			<div class="mm_card_line"></div>

			<div class="mm_card_top">
				<div class="mm_card_kicker">STORE</div>
				<div id="featured_shop_badge" class="mm_card_chip accent">NEW</div>
			</div>

			<div id="featured_shop_name" class="mm_card_title">Featured item</div>

			<div id="featured_shop_price" class="mm_card_text">0 ZC</div>

			<button id="btn_featured_shop_open" class="mm_card_button">OPEN SHOP</button>
		</div>

		<div id="card_rank" class="mm_card">
			<div class="mm_card_line"></div>

			<div class="mm_card_top">
				<div class="mm_card_kicker">RANK</div>
				<div id="rank_level" class="mm_card_chip">LVL 1</div>
			</div>

			<div id="rank_title" class="mm_card_title">RECRUIT</div>

			<div class="mm_card_progress">
				<div id="rank_xp_fill" class="mm_card_progress_fill"></div>
			</div>

			<div id="rank_xp_text" class="mm_card_text">0 / 100 XP</div>
			<div id="rank_reward_text" class="mm_card_reward">Next reward: 250 ZD</div>
		</div>

		<div id="card_missions" class="mm_card">
			<div class="mm_card_line"></div>

			<div class="mm_card_top">
				<div class="mm_card_kicker">MISSIONS</div>
				<div class="mm_card_chip">MVP</div>
			</div>

			<div id="mission_title" class="mm_card_title">Daily contract unavailable</div>

			<div id="mission_state" class="mm_card_text">
				Mission API is not connected yet.
			</div>

			<div id="mission_reward" class="mm_card_reward">Reward: ZD / XP</div>

			<button id="btn_missions_open" class="mm_card_button">MISSIONS</button>
		</div>

		<div id="card_battlepass" class="mm_card locked">
			<div class="mm_card_line"></div>

			<div class="mm_card_top">
				<div class="mm_card_kicker">BATTLE PASS</div>
				<div class="mm_card_chip locked">LOCKED</div>
			</div>

			<div class="mm_card_title">COMING SOON</div>

			<div class="mm_card_text">
				Season progression will be available later.
			</div>

			<button id="btn_battlepass_stub" class="mm_card_button disabled">LOCKED</button>
		</div>

	</div>

	<div class="premium_badge">
		PREMIUM NOT ACTIVE
	</div>

	<div class="bottom_play_area">

		<button
			id="btn_quick_join"
			class="play_button"
		>
			<div class="play_button_icon">
				*
			</div>

			<div class="play_button_text">
				PLAY
			</div>
		</button>

		<div class="squad_slots">

			<div class="squad_slot">
				<div class="squad_slot_plus">+</div>
				<div>ADD TO SQUAD</div>
			</div>

			<div class="squad_slot disabled">
				<div class="squad_slot_plus">+</div>
				<div>ADD TO SQUAD</div>
			</div>

		</div>

	</div>
	
	<div
		id="play_mode_modal"
		class="play_mode_overlay"
	>
		<div
			id="play_mode_close_area"
			class="play_mode_backdrop"
		></div>

		<div class="play_mode_panel">

			<div class="play_mode_header">
				<div>
					<div class="play_mode_kicker">DEPLOYMENT</div>
					<div class="play_mode_title">SELECT GAME MODE</div>
				</div>

				<button
					id="play_mode_close"
					class="play_mode_close_button"
				>
					X
				</button>
			</div>

			<div class="play_mode_description">
				Play Game sends you to SafeZone first. Open World is entered from SafeZone through NPC transition.
			</div>

			<div class="play_mode_list">

				<button
					id="play_mode_safezone"
					class="play_mode_card available"
				>
					<div class="play_mode_card_status">AVAILABLE</div>
					<div class="play_mode_card_title">SAFEZONE</div>
					<div class="play_mode_card_text">
						Safe buffer map. Meet traders, NPCs, missions and prepare before entering Open World.
					</div>
					<div class="play_mode_card_footer">
						ENTER SAFEZONE
					</div>
				</button>

				<button
					id="play_mode_openworld_info"
					class="play_mode_card route"
				>
					<div class="play_mode_card_status">ROUTE</div>
					<div class="play_mode_card_title">OPEN WORLD</div>
					<div class="play_mode_card_text">
						Open World is entered only from SafeZone through NPC or world transition.
					</div>
					<div class="play_mode_card_footer">
						FROM SAFEZONE
					</div>
				</button>

				<button
					id="play_mode_deathmatch"
					class="play_mode_card locked"
				>
					<div class="play_mode_card_status">RANKED</div>
					<div class="play_mode_card_title">DEATHMATCH</div>
					<div class="play_mode_card_text">
						Ranked combat mode with matchmaking, rating and seasonal rewards.
					</div>
					<div class="play_mode_card_footer">
						COMING SOON
					</div>
				</button>

				<button
					id="play_mode_ctf"
					class="play_mode_card locked"
				>
					<div class="play_mode_card_status">RANKED</div>
					<div class="play_mode_card_title">CAPTURE THE FLAG</div>
					<div class="play_mode_card_text">
						Ranked team objective mode. Capture enemy flag and protect your base.
					</div>
					<div class="play_mode_card_footer">
						COMING SOON
					</div>
				</button>

			</div>

		</div>
	</div>
	
	<div id="frontend_notice_layer" class="frontend_notice_layer">
		<div id="frontend_notice" class="frontend_notice info">
			<div id="frontend_notice_title" class="frontend_notice_title">
				SYSTEM
			</div>

			<div id="frontend_notice_text" class="frontend_notice_text">
				Message
			</div>
		</div>
	</div>

	<div class="survivor_identity">

		<div
			id="survivor_state"
			class="survivor_state ready"
		>
			READY
		</div>

		<div class="survivor_identity_text">
			<div id="survivor_nickname" class="survivor_nickname">
				SURVIVOR
			</div>

			<div id="survivor_class" class="survivor_class">
				EX MILITARY
			</div>
		</div>

	</div>

	<div class="preview_help">
		LMB ROTATE
	</div>

	<div class="main_menu_status_bar">

		<div class="main_menu_status_left">
			<div class="status_indicator"></div>

			<div
				id="main_menu_status"
				class="frontend_status"
			>
				Loading survivor profile...
			</div>
		</div>

		<div class="preview_server_information">

			<div class="server_information_label">
				REGION:
			</div>

			<div
				id="footer_region"
				class="server_information_value"
			>
				AUTO
			</div>

			<div class="server_information_separator">
				|
			</div>

			<div class="server_information_label">
				SERVER:
			</div>

			<div
				id="footer_server"
				class="server_information_value"
			>
				OFFLINE
			</div>

			<div class="connection_bars">
				<div class="connection_bar bar_one"></div>
				<div class="connection_bar bar_two"></div>
				<div class="connection_bar bar_three"></div>
			</div>

		</div>

	</div>

	<div class="frontend_chat_bar">
		<div class="chat_icon">...</div>
		<div class="chat_hint">Press [ENTER] to open chat</div>
	</div>

	<div class="runtime_hidden_value">

		<div id="account_name">ACCOUNT</div>
		<div id="selected_character">SURVIVOR</div>

		<div id="stat_player_kills">0</div>
		<div id="stat_zombie_kills">0</div>
		<div id="stat_time_played">0d 00h 00m</div>
		<div id="stat_health">100%</div>
		<div id="stat_reputation">0</div>
		<div id="stat_rank">UNRANKED</div>

		<div id="survivor_level_value">1</div>
		<div id="survivor_level_xp_text">0 / 100</div>
		<div id="survivor_level_xp_fill"></div>

		<input
			id="rename_character_name"
			type="text"
			maxlength="16"
		/>

		<button id="btn_rename_character">
			APPLY NAME
		</button>

	</div>

</body>
</rml>
