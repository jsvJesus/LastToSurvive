<rml>
<head>
	<title>Last To Survive Main Menu</title>
	<link type="text/rcss" href="FrontEnd.rcss"/>
	<link type="text/rcss" href="MainMenu.rcss"/>
</head>

<body class="frontend_body main_menu_body">

	<div id="home_background_stage" class="home_background_stage">
		<img
			id="home_background_image"
			class="home_background_image"
			src="../Assets/bg.png"
		/>
		<div class="home_background_shadow"></div>
	</div>

	<!-- НЕ УДАЛЯТЬ: сюда C++ кладёт персонажа через rml://character-preview -->
	<div
		id="character_preview_stage"
		class="main_menu_scene"
	>
		<img
			id="character_preview_texture"
			class="main_menu_scene_texture"
			src="rml://character-preview"
		/>

		<div class="main_menu_scene_shade"></div>
		<div class="main_menu_scene_vignette"></div>
	</div>

	<div id="home_xaml_root" class="home_xaml_root">

		<!-- LEVEL / EXP -->
		<div id="home_level_panel" class="home_level_panel">
			<img
				class="home_level_bg"
				src="../Assets/MainMenu/Home/Survivor_Level_Progress_bg.png"
			/>

			<div class="home_level_fill_clip">
				<div
					id="top_level_xp_fill"
					class="home_level_fill"
				></div>
			</div>

			<div
				id="top_level_value"
				class="home_level_number"
			>
				99
			</div>

			<div
				id="rank_title"
				class="home_level_rank"
			>
				RECRUIT
			</div>

			<div
				id="top_level_xp_text"
				class="home_level_xp"
			>
				4579 / 10000000
			</div>

			<div
				id="top_survivor_name"
				class="home_character_name"
			>
				Mazafaka11995
			</div>
		</div>

		<!-- PREMIUM -->
		<div id="home_premium_panel" class="home_premium_panel">
			<img
				class="home_premium_plate"
				src="../Assets/MainMenu/Home/Survivor_Premium_Plate.png"
			/>

			<div class="home_premium_text">
				PREMIUM NOT ACTIVE
			</div>

			<img
				class="home_premium_badge"
				src="../Assets/MainMenu/Home/Survivor_Premium_Badge.png"
			/>
		</div>

		<!-- PLAY GAME -->
		<button
			id="btn_quick_join"
			class="home_play_button"
		>
			<img
				class="home_play_options_plate"
				src="../Assets/MainMenu/Home/PlayGame_Options_Plate.png"
			/>

			<img
				class="home_play_plate"
				src="../Assets/MainMenu/Home/PlayGame_Plate.png"
			/>

			<img
				class="home_play_icon"
				src="../Assets/MainMenu/Home/PlayGame_Ico.png"
			/>

			<div class="home_play_text">
				Play Game
			</div>
		</button>

	</div>

	<!-- MODE SELECT MODAL: оставляем старую логику кнопки PLAY -->
	<div
		id="play_mode_modal"
		class="play_mode_overlay"
	>
		<div
			id="play_mode_close_area"
			class="play_mode_backdrop"
		></div>

		<div class="play_mode_panel">

			<div class="play_mode_header">
				<div>
					<div class="play_mode_kicker">DEPLOYMENT</div>
					<div class="play_mode_title">SELECT GAME MODE</div>
				</div>

				<button
					id="play_mode_close"
					class="play_mode_close_button"
				>
					X
				</button>
			</div>

			<div class="play_mode_description">
				Play Game sends you to SafeZone first. Open World is entered from SafeZone through NPC transition.
			</div>

			<div class="play_mode_list">

				<button
					id="play_mode_safezone"
					class="play_mode_card available"
				>
					<div class="play_mode_card_status">AVAILABLE</div>
					<div class="play_mode_card_title">SAFEZONE</div>
					<div class="play_mode_card_text">
						Safe buffer map. Meet traders, NPCs, missions and prepare before entering Open World.
					</div>
					<div class="play_mode_card_footer">
						ENTER SAFEZONE
					</div>
				</button>

				<button
					id="play_mode_openworld_info"
					class="play_mode_card route"
				>
					<div class="play_mode_card_status">ROUTE</div>
					<div class="play_mode_card_title">OPEN WORLD</div>
					<div class="play_mode_card_text">
						Open World is entered only from SafeZone through NPC or world transition.
					</div>
					<div class="play_mode_card_footer">
						FROM SAFEZONE
					</div>
				</button>

				<button
					id="play_mode_deathmatch"
					class="play_mode_card locked"
				>
					<div class="play_mode_card_status">RANKED</div>
					<div class="play_mode_card_title">DEATHMATCH</div>
					<div class="play_mode_card_text">
						Ranked combat mode with matchmaking, rating and seasonal rewards.
					</div>
					<div class="play_mode_card_footer">
						COMING SOON
					</div>
				</button>

				<button
					id="play_mode_ctf"
					class="play_mode_card locked"
				>
					<div class="play_mode_card_status">RANKED</div>
					<div class="play_mode_card_title">CAPTURE THE FLAG</div>
					<div class="play_mode_card_text">
						Ranked team objective mode. Capture enemy flag and protect your base.
					</div>
					<div class="play_mode_card_footer">
						COMING SOON
					</div>
				</button>

			</div>
		</div>
	</div>

	<!-- скрытые runtime id, чтобы C++ не ломался при SetElementText/SetInputValue -->
	<div class="mainmenu_runtime_values">
		<div id="account_name">SURVIVOR</div>
		<div id="top_survivor_role">SURVIVOR</div>
		<div id="survivor_nickname">SURVIVOR</div>
		<div id="survivor_class">SURVIVOR</div>
		<div id="selected_character">SURVIVOR</div>
		<div id="survivor_state">READY</div>

		<div id="stat_player_kills">0</div>
		<div id="stat_zombie_kills">0</div>
		<div id="stat_time_played">0d 00h 00m</div>
		<div id="stat_health">100%</div>
		<div id="stat_reputation">0</div>
		<div id="stat_rank">UNRANKED</div>

		<div id="survivor_level_value">0</div>
		<div id="survivor_level_xp_text">0 / 100</div>
		<div id="survivor_level_xp_fill"></div>

		<div id="reward_rank_title">RECRUIT</div>
		<div id="reward_xp_text">0 / 100</div>
		<div id="reward_xp_fill"></div>

		<div id="footer_region">AUTO</div>
		<div id="footer_server">OFFLINE</div>

		<div id="news_title">SafeZone deployment online</div>
		<div id="news_body">SafeZone is now the first deployment point.</div>

		<div id="card_featured_shop"></div>
		<div id="featured_shop_badge">NEW</div>
		<div id="featured_shop_name">M16</div>
		<div id="featured_shop_price">1 ZC</div>
		<button id="btn_featured_shop_open">OPEN SHOP</button>

		<div id="card_rank"></div>
		<div id="rank_level">LVL 1</div>
		<div id="rank_xp_fill"></div>
		<div id="rank_xp_text">0 / 100 XP</div>
		<div id="rank_reward_text">Next reward: 250 ZD</div>

		<div id="card_missions"></div>
		<div id="mission_title">Daily contract unavailable</div>
		<div id="mission_state">Mission API is not connected yet.</div>
		<div id="mission_reward">Reward: ZD / XP</div>

		<div id="card_battlepass"></div>
		<button id="btn_battlepass_stub">LOCKED</button>

		<button id="btn_news_more">MORE</button>
		<button id="btn_missions_open">MISSIONS</button>
		<button id="btn_rename_character">RENAME</button>
		<button id="btn_refresh_profile">REFRESH</button>

		<input
			id="rename_character_name"
			type="text"
			value=""
		/>
	</div>

</body>
</rml>