/* ============================================================
   CHARACTER CREATE ONLY
   ============================================================ */

.main_topbar {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 86px;

	padding-left: 32px;
	padding-right: 32px;

	display: flex;
	justify-content: space-between;
	align-items: center;

	background-color: rgba(6, 9, 11, 250);

	border-bottom-width: 1px;
	border-bottom-color: #30393e;
}

.main_logo_block {
	height: 58px;

	padding-top: 4px;
}

.account_block {
	min-width: 240px;

	padding: 9px 12px;

	color: #aab3b8;
	background-color: #0b1013;

	border-left-width: 2px;
	border-left-color: #d96d2a;

	font-size: 9px;
	font-weight: bold;
	letter-spacing: 1px;
	text-align: right;
}

.character_create_layout {
	position: absolute;
	left: 28px;
	right: 28px;
	top: 108px;
	bottom: 61px;

	display: flex;
}

.create_preview_panel {
	position: relative;

	width: 64%;
	height: 100%;

	margin-right: 14px;
	padding: 18px;

	background-color: rgba(8, 13, 16, 230);

	border-width: 1px;
	border-color: #30393e;
}

.create_form_panel {
	position: relative;

	width: 36%;
	height: 100%;

	padding: 18px;

	background-color: rgba(8, 13, 16, 245);

	border-width: 1px;
	border-color: #30393e;
}

.create_preview_area {
	position: absolute;
	left: 18px;
	right: 18px;
	top: 56px;
	bottom: 108px;

	background-color: rgba(0, 0, 0, 71);

	border-width: 1px;
	border-color: #30393e;
}

.create_preview_placeholder {
	position: absolute;
	left: 50%;
	top: 50%;

	width: 320px;
	height: 160px;

	margin-left: -160px;
	margin-top: -80px;

	text-align: center;
}

.preview_character_icon {
	width: 64px;
	height: 64px;

	margin-left: auto;
	margin-right: auto;
	padding-top: 20px;

	color: #d96d2a;
	background-color: rgba(14, 20, 24, 235);

	border-width: 1px;
	border-color: #d96d2a;

	font-size: 22px;
	font-weight: bold;
	text-align: center;
}

.preview_character_name {
	margin-top: 14px;

	color: #ffffff;

	font-size: 18px;
	font-weight: bold;
	letter-spacing: 2px;
}

.preview_character_description {
	margin-top: 8px;

	color: #8c979d;

	font-size: 10px;
	line-height: 14px;
}

.create_character_info {
	position: absolute;
	left: 18px;
	right: 18px;
	bottom: 18px;

	height: 74px;

	background-color: rgba(5, 8, 10, 158);

	border-width: 1px;
	border-color: #30393e;
}

.create_info_row {
	height: 36px;

	padding-left: 12px;
	padding-right: 12px;

	display: flex;
	justify-content: space-between;
	align-items: center;
}

.create_info_label {
	color: #78848a;

	font-size: 9px;
	font-weight: bold;
	letter-spacing: 1px;
}

.create_info_value {
	color: #ffffff;

	font-size: 10px;
	font-weight: bold;
}

.create_help_text {
	margin-top: 8px;

	color: #737f85;

	font-size: 9px;
	line-height: 13px;
}

.appearance_title {
	margin-top: 20px;
	margin-bottom: 8px;

	color: #e17332;

	font-size: 9px;
	font-weight: bold;
	letter-spacing: 2px;
}

.appearance_row {
	width: 100%;
	height: 38px;

	margin-bottom: 8px;

	display: flex;
	align-items: center;
}

.appearance_label {
	width: 120px;

	color: #aeb8bd;

	font-size: 9px;
	font-weight: bold;
	letter-spacing: 1px;
}

.appearance_button {
	width: 40px;
	height: 32px;

	margin-top: 0px;

	text-align: center;
}

.appearance_value {
	width: 80px;
	height: 32px;

	padding-top: 10px;

	color: #ffffff;
	background-color: rgba(5, 8, 10, 184);

	border-width: 1px;
	border-color: #30393e;

	font-size: 9px;
	font-weight: bold;
	text-align: center;
}

.create_status {
	margin-top: 18px;
}

.primary_button.large {
	height: 48px;

	font-size: 13px;
	letter-spacing: 1px;
}
