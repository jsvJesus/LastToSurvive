/* ============================================================
   SHOP SCREEN ONLY
   ============================================================ */

.shop_body {
	background-color: #030506;
}

.shop_layout {
	position: absolute;
	left: 28px;
	right: 28px;
	top: 104px;
	bottom: 42px;

	z-index: 12;

	display: flex;
	flex-direction: row;
}

.shop_panel {
	position: relative;

	height: 100%;

	background-color: rgba(8, 12, 15, 0.90);
	decorator: linear-gradient(180deg, #1d262b, #0d1316 58%, #06090b) border-box;

	border-width: 1px;
	border-color: rgba(88, 100, 106, 0.62);

	overflow: hidden;
}

.shop_categories_panel {
	width: 220px;

	margin-right: 12px;
	padding: 16px;

	flex-shrink: 0;
}

.shop_items_panel {
	width: 760px;

	margin-right: 12px;
	padding: 16px;

	flex-shrink: 0;
}

.shop_preview_panel {
	width: 400px;

	margin-right: 12px;
	padding: 16px;

	flex-shrink: 0;
}

.shop_details_panel {
	width: 330px;

	padding: 16px;

	flex-shrink: 0;
}

.shop_panel_header {
	width: 100%;
	height: 58px;

	display: flex;
	justify-content: space-between;
	align-items: center;

	border-bottom-width: 1px;
	border-bottom-color: rgba(84, 96, 102, 0.55);
}

.shop_panel_title {
	color: #ffffff;

	font-size: 17px;
	font-weight: bold;
	line-height: 18px;
	letter-spacing: 1px;
}

.shop_panel_subtitle {
	margin-top: 4px;

	color: #e17332;

	font-size: 9px;
	font-weight: bold;
	line-height: 10px;
	letter-spacing: 2px;
}

.shop_category_button {
	width: 100%;
	height: 38px;

	margin-top: 7px;

	display: flex;
	align-items: center;

	text-align: left;

	background-color: rgba(9, 14, 17, 0.82);

	border-color: rgba(64, 76, 82, 0.72);

	font-size: 11px;
	letter-spacing: 1px;
}

.shop_category_button.active,
.shop_category_button.selected,
.shop_category_button:hover,
.shop_tab_button.active,
.shop_tab_button.selected,
.shop_tab_button:hover {
	background-color: rgba(91, 35, 29, 0.90);

	border-color: #d45c4c;
	border-left-width: 4px;
	border-left-color: #ff8f55;
}

.shop_category_code {
	width: 38px;

	color: #e17332;

	text-align: center;
}

.shop_actions_stack {
	position: absolute;
	left: 16px;
	right: 16px;
	bottom: 16px;
}

.shop_small_button {
	width: 100%;
	height: 34px;

	margin-top: 8px;

	font-size: 11px;
	letter-spacing: 1px;
}

.shop_tabs {
	width: 100%;
	height: 40px;

	display: flex;
}

.shop_tab_button {
	width: 24%;
	height: 34px;

	margin-right: 1%;

	background-color: rgba(9, 14, 17, 0.82);

	border-color: rgba(64, 76, 82, 0.72);

	font-size: 10px;
	letter-spacing: 1px;
}

.shop_items_grid {
	position: absolute;
	left: 16px;
	right: 16px;
	top: 66px;
	bottom: 16px;

	display: flex;
	flex-wrap: wrap;
	align-content: flex-start;

	background-color: rgba(3, 5, 6, 0.50);
	decorator: linear-gradient(180deg, #10161a, #070b0d) border-box;

	border-width: 1px;
	border-color: rgba(74, 86, 92, 0.56);

	padding: 0px;

	overflow: auto;
}

.shop_grid_spacer {
	position: relative;

	width: 728px;
}

.shop_item_card {
	position: absolute;

	width: 64px;
	height: 64px;

	margin-right: 0px;
	margin-bottom: 0px;
	padding: 4px;

	text-align: left;

	background-color: rgba(9, 14, 17, 0.88);

	border-color: rgba(64, 76, 82, 0.74);
	border-width: 1px;
}

.shop_item_card.item_size_1x1 {
	width: 64px;
	height: 64px;
}

.shop_item_card.item_size_2x1 {
	width: 128px;
	height: 64px;
}

.shop_item_card.item_size_1x2 {
	width: 64px;
	height: 128px;
}

.shop_item_card.item_size_2x2 {
	width: 128px;
	height: 128px;
}

.shop_item_card.item_size_2x3 {
	width: 128px;
	height: 192px;
}

.shop_item_card.item_size_4x2 {
	width: 256px;
	height: 128px;
}

.shop_item_card:hover,
.shop_item_card.selected {
	background-color: rgba(82, 34, 29, 0.94);

	border-color: #f1765a;

	filter: drop-shadow(#e879324c 0px 0px 8px);
}

.shop_item_card.locked {
	color: #707a7f;
	background-color: rgba(7, 10, 12, 0.84);

	border-color: #30393e;
}

.shop_item_badge {
	position: absolute;
	left: 4px;
	right: 4px;
	top: 4px;

	height: 12px;

	color: #e17332;

	font-size: 7px;
	font-weight: bold;
	letter-spacing: 1px;
	white-space: nowrap;

	overflow: hidden;
}

.shop_item_image {
	position: absolute;
	left: 50%;
	top: 50%;

	width: 46px;
	height: 30px;

	margin-left: -23px;
	margin-top: -19px;

	image-color: #ffffff;
}

.item_size_2x1 .shop_item_image {
	width: 100px;
	height: 30px;

	margin-left: -50px;
	margin-top: -19px;
}

.item_size_1x2 .shop_item_image {
	width: 46px;
	height: 80px;

	margin-left: -23px;
	margin-top: -44px;
}

.item_size_2x2 .shop_item_image {
	width: 96px;
	height: 74px;

	margin-left: -48px;
	margin-top: -43px;
}

.item_size_2x3 .shop_item_image {
	width: 96px;
	height: 138px;

	margin-left: -48px;
	margin-top: -75px;
}

.item_size_4x2 .shop_item_image {
	width: 210px;
	height: 74px;

	margin-left: -105px;
	margin-top: -43px;
}

.shop_item_stack {
	position: absolute;
	right: 4px;
	top: 18px;

	min-width: 22px;
	height: 14px;

	padding-top: 2px;

	color: #ffffff;
	background-color: rgba(5, 8, 10, 0.82);

	border-width: 1px;
	border-color: rgba(97, 109, 116, 0.70);

	font-size: 8px;
	font-weight: bold;
	text-align: center;
}

.shop_item_name {
	position: absolute;
	left: 5px;
	right: 5px;
	bottom: 20px;

	height: 18px;

	color: #ffffff;

	font-size: 7px;
	font-weight: bold;
	line-height: 9px;
	text-align: center;

	overflow: hidden;
}

.item_size_1x1 .shop_item_name {
	display: none;
}

.shop_item_type {
	display: none;
}

.shop_item_price {
	position: absolute;
	left: 4px;
	right: 4px;
	bottom: 3px;

	height: 14px;

	padding-top: 2px;

	color: #f4d061;
	background-color: rgba(5, 8, 10, 0.62);

	font-size: 7px;
	font-weight: bold;
	text-align: center;
	white-space: nowrap;

	overflow: hidden;
}

.shop_empty_text {
	width: 100%;

	padding-top: 130px;

	color: #79858a;

	font-size: 11px;
	font-weight: bold;
	letter-spacing: 2px;
	text-align: center;
}

.shop_model_stage {
	position: absolute;
	left: 16px;
	right: 16px;
	top: 66px;
	bottom: 72px;

	background-color: rgba(3, 5, 6, 0.46);

	border-width: 1px;
	border-color: rgba(74, 86, 92, 0.56);

	overflow: hidden;
}

.selected_item_store_icon {
	position: absolute;
	left: 50%;
	top: 50%;

	width: 320px;
	height: 210px;

	margin-left: -160px;
	margin-top: -120px;

	image-color: #ffffff;
}

.selected_item_preview_name {
	position: absolute;
	left: 14px;
	right: 14px;
	bottom: 18px;

	color: #ffffff;

	font-size: 17px;
	font-weight: bold;
	line-height: 20px;
	text-align: center;
}

.shop_preview_hint {
	position: absolute;
	left: 16px;
	right: 16px;
	bottom: 16px;

	height: 38px;

	padding-top: 12px;

	color: #78848a;
	background-color: rgba(5, 8, 10, 0.58);

	border-width: 1px;
	border-color: rgba(67, 78, 84, 0.55);

	font-size: 9px;
	font-weight: bold;
	letter-spacing: 2px;
	text-align: center;
}

/* DETAILS */

.selected_item_card {
	width: 100%;
	height: 72px;

	margin-top: 16px;

	display: flex;

	background-color: rgba(5, 8, 10, 0.66);

	border-width: 1px;
	border-color: rgba(67, 78, 84, 0.66);
}

.selected_item_icon {
	width: 58px;
	height: 70px;

	padding-top: 22px;

	color: #ffffff;
	background-color: rgba(160, 55, 47, 0.88);

	font-size: 18px;
	font-weight: bold;
	text-align: center;
}

.selected_item_main {
	padding: 16px 12px;
}

.selected_item_name {
	color: #ffffff;

	font-size: 16px;
	font-weight: bold;
}

.selected_item_category {
	margin-top: 4px;

	color: #e17332;

	font-size: 8px;
	font-weight: bold;
	letter-spacing: 1px;
}

.selected_item_description {
	margin-top: 16px;

	color: #aab3b8;

	font-size: 11px;
	line-height: 16px;
}

.selected_item_prices {
	margin-top: 16px;

	display: flex;
}

.selected_price {
	width: 48%;
	height: 46px;

	margin-right: 2%;
	padding-top: 8px;

	background-color: rgba(5, 8, 10, 0.62);

	border-width: 1px;
	border-color: rgba(67, 78, 84, 0.55);

	text-align: center;
}

.selected_price.selected,
.selected_price:hover {
	background-color: rgba(82, 34, 29, 0.94);

	border-color: #f1765a;
}

.selected_price_label {
	color: #e17332;

	font-size: 9px;
	font-weight: bold;
	letter-spacing: 1px;
}

.selected_price_value {
	margin-top: 3px;

	color: #ffffff;

	font-size: 14px;
	font-weight: bold;
}

.selected_item_stats {
	margin-top: 16px;
}

.selected_item_stat {
	width: 100%;
	height: 28px;

	display: flex;
	justify-content: space-between;
	align-items: center;

	color: #737f85;

	font-size: 8px;
	font-weight: bold;
	letter-spacing: 1px;

	border-bottom-width: 1px;
	border-bottom-color: rgba(67, 78, 84, 0.40);
}

.selected_item_stat_value {
	color: #ffffff;

	font-size: 11px;
	font-weight: bold;
}

.shop_buy_button,
.shop_preview_button {
	width: 100%;
	height: 42px;

	margin-top: 12px;

	font-size: 13px;
	letter-spacing: 1px;
}

.shop_buy_button {
	background-color: rgba(153, 54, 45, 0.94);
	decorator: linear-gradient(180deg, #cc5548, #96352e 54%, #541b18) border-box;

	border-color: #d75f51;
}

.shop_preview_button {
	background-color: rgba(18, 25, 29, 0.92);

	border-color: rgba(84, 98, 105, 0.78);
}

.shop_details_status {
	margin-top: 10px;

	color: #7c878c;

	font-size: 10px;
	line-height: 14px;
}
