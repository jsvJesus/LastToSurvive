}

.item_size_4x2 .shop_item_image {
	width: 210px;
	height: 74px;
	margin-left: -105px;
	margin-top: -43px;
}

.shop_item_stack {
	position: absolute;
	right: 4px;
	top: 18px;
	min-width: 22px;
	height: 14px;
	padding-top: 2px;
	color: #ffffff;
	background-color: rgba(5, 8, 10, 0.82);
