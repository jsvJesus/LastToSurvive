/* ============================================================
   LAST TO SURVIVE
   RMLUI FRONTEND
   ============================================================ */

* {
	box-sizing: border-box;
}

div,
button,
input,
img {
	display: block;
}

body {
	margin: 0px;
	padding: 0px;
	color: #d8dde0;
	font-family: "Noto Sans";
}

/* ============================================================
   ROOT
   ============================================================ */

.frontend_body {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	overflow: hidden;
	background-color: #040607;
}

.background_grid {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	background-color: #080c0e;
}

.background_vignette {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	background-color: rgba(0, 0, 0, 0.36);
}

.login_background_light {
	position: absolute;
	left: 24%;
	top: 10%;
	width: 52%;
	height: 80%;
	background-color: rgba(111, 127, 134, 0.04);
}

.screen_edge {
	position: absolute;
	left: 0px;
	width: 100%;
	height: 1px;
	background-color: #5b321b;
}

.screen_edge_top {
	top: 0px;
}

.screen_edge_bottom {
	bottom: 0px;
}

.runtime_hidden_value {
	display: none;
}

@keyframes frontend_button_breathe {
	from {
		filter: drop-shadow(#00000088 0px 2px 2px);
	}
	to {
		filter: drop-shadow(#e8793255 0px 0px 9px);
	}
}

@keyframes frontend_play_breathe {
	from {
		filter: drop-shadow(#00000099 0px 3px 4px);
	}
	to {
		filter: drop-shadow(#ff6f5788 0px 0px 14px);
	}
}

/* ============================================================
   TYPOGRAPHY
   ============================================================ */

.game_title {
	color: #f4f6f7;
	font-size: 28px;
	font-weight: bold;
	letter-spacing: 5px;
}

.game_title.small {
	font-size: 20px;
}

.game_subtitle {
	margin-top: 4px;
	color: #d96d2a;
	font-size: 9px;
	font-weight: bold;
	letter-spacing: 3px;
}

.panel_title {
	color: #ff8337;
	font-size: 10px;
	font-weight: bold;
	letter-spacing: 2px;
}

.panel_subtitle {
	margin-top: 4px;
	color: #657178;
	font-size: 8px;
	font-weight: bold;
	letter-spacing: 2px;
}

.field_label {
	width: 100%;
	margin-top: 15px;
	margin-bottom: 6px;
	color: #8c979d;
	font-size: 8px;
	font-weight: bold;
	letter-spacing: 2px;
}

.compact_label {
	margin-top: 0px;
}

/* ============================================================
   PANELS
   ============================================================ */

.tactical_panel {
	position: relative;
	background-color: rgba(8, 13, 16, 0.97);
	border-width: 1px;
	border-color: #30393e;
}

.panel_top_line {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 2px;
	background-color: #e2732d;
}

.panel_header_row {
	width: 100%;
	height: 25px;
	display: flex;
	justify-content: space-between;
	align-items: center;
}

.panel_accent {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 4px;
	height: 100%;
	background-color: #f17d32;
}

/* ============================================================
   INPUTS / SHARED BUTTONS
   ============================================================ */

.frontend_input {
	width: 100%;
	height: 42px;
	padding-left: 12px;
	padding-right: 12px;
	color: #f0f2f3;
	background-color: #06090b;
	border-width: 1px;
	border-color: #354047;
	font-size: 12px;

	/* Живые переходы */
	transition: color 0.18s, background-color 0.18s, border-color 0.18s;
}

.frontend_input:hover {
	border-color: #59676e;
}

.frontend_input:focus {
	color: #ffffff;
	background-color: #0b1013;
	border-color: #ff8738;
}

.frontend_input.disabled,
.frontend_input:disabled {
	color: #4d565b;
	background-color: #0a0e10;
	border-color: #20272b;
}

button {
	margin: 0px;
	padding: 0px;
	color: #e7eef1;
	background-color: #12191d;
	decorator: linear-gradient(180deg, #2a353a, #12191d 55%, #070b0d) border-box;
	border-width: 1px;
	border-color: #46535a;
	border-bottom-width: 2px;
	border-bottom-color: #20292e;
	font-family: "Noto Sans";
	font-weight: bold;
	text-shadow: 0px 1px 2px rgba(0, 0, 0, 0.80);
	filter: drop-shadow(#00000088 0px 2px 2px);

	/* Живые переходы */
	transition: color 0.16s, background-color 0.16s, border-color 0.16s, border-bottom-color 0.16s, text-shadow 0.16s, filter 0.16s;
}

button:hover {
	color: #ffffff;
	background-color: #1b2429;
	decorator: linear-gradient(180deg, #3a474e, #1a2429 55%, #0b1013) border-box;
	border-color: #76858c;
	border-bottom-color: #e07830;
	text-shadow: 0px 0px 8px rgba(255, 166, 88, 0.42);
	filter: drop-shadow(#e8793255 0px 0px 8px);
}

button:active {
	background-color: #0a0f12;
	decorator: linear-gradient(180deg, #111719, #0a0f12 60%, #06090a) border-box;
	border-bottom-width: 1px;
	filter: drop-shadow(#00000077 0px 1px 1px);
}

button.disabled,
button:disabled {
	color: #4d565b;
	background-color: #0e1214;
	border-color: #20272b;
}

.status_text {
	width: 100%;
	min-height: 40px;
	margin-top: 18px;
	margin-bottom: 14px;
	padding: 10px 12px;
	color: #aeb7bc;
	background-color: #0a0f12;
	border-left-width: 3px;
	border-left-color: #e87731;
	font-size: 10px;
}

.primary_button,
.secondary_button {
	width: 100%;
	height: 44px;
	margin-top: 9px;
}

.primary_button {
	color: #ffffff;
	background-color: #9d4618;
	decorator: linear-gradient(180deg, #ff9d55, #b94f1e 42%, #6d2711) border-box;
	border-color: #ff8b40;
	border-bottom-color: #61220e;
	box-shadow: #00000088 0px 4px 8px 0px;

	/* Живые переходы */
	transition: color 0.16s, background-color 0.16s, border-color 0.16s, border-bottom-color 0.16s, text-shadow 0.16s, filter 0.16s;
}

.primary_button:hover {
	background-color: #c45a20;
	decorator: linear-gradient(180deg, #ffb46f, #d76525 45%, #863113) border-box;
	border-color: #ffad70;
	border-bottom-color: #7d2d12;
	text-shadow: 0px 0px 10px rgba(255, 160, 70, 0.50);
	animation: frontend_button_breathe 0.72s linear infinite alternate;
}

.primary_button:active {
	background-color: #713113;
	decorator: linear-gradient(180deg, #8f3515, #65250f 55%, #3f1609) border-box;
	border-color: #e56f2c;
	border-bottom-color: #3b1508;
}

.secondary_button {
	color: #c8d0d4;
	background-color: #12191d;
	decorator: linear-gradient(180deg, #2d383e, #151d22 52%, #0b1013) border-box;
	border-color: #364149;
	border-bottom-color: #10171a;

	/* Живые переходы */
	transition: color 0.16s, background-color 0.16s, border-color 0.16s, border-bottom-color 0.16s, text-shadow 0.16s, filter 0.16s;
}

.secondary_button:hover {
	color: #ffffff;
	background-color: #1c252a;
	decorator: linear-gradient(180deg, #3b474e, #202b30 52%, #101619) border-box;
	border-color: #65737a;
	border-bottom-color: #df6d2d;
}

.button_code {
	width: 52px;
	color: #ff9a5a;
	font-size: 10px;
	letter-spacing: 1px;
	text-align: center;
}

.button_label {
	flex-grow: 1;
	color: inherit;
	font-size: 12px;
	letter-spacing: 1px;
	text-align: left;
}

/* ============================================================
   LOGIN
   ============================================================ */

.login_topbar {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 86px;
	padding-left: 32px;
	padding-right: 32px;
	display: flex;
	justify-content: space-between;
	align-items: center;
	background-color: rgba(6, 9, 11, 0.98);
	border-bottom-width: 1px;
	border-bottom-color: #30393e;
}

.login_brand {
	height: 58px;
	display: flex;
	align-items: center;
}

.login_brand_mark {
	width: 58px;
	height: 52px;
	margin-right: 15px;
	padding-top: 15px;
	color: #ff8b40;
	background-color: #10171b;
	border-width: 1px;
	border-color: #d96d2a;
	font-size: 13px;
	font-weight: bold;
	letter-spacing: 2px;
	text-align: center;
}

.login_brand_text {
	height: 52px;
	padding-top: 3px;
}

.login_system_readout {
	min-width: 250px;
	padding: 9px 12px;
	background-color: #0b1013;
	border-left-width: 2px;
	border-left-color: #d96d2a;
	text-align: right;
}

.system_label {
	color: #68747a;
	font-size: 8px;
	font-weight: bold;
	letter-spacing: 2px;
}

.system_value {
	margin-top: 4px;
	color: #f0f2f3;
	font-size: 10px;
	font-weight: bold;
	letter-spacing: 1px;
}

.login_layout {
	position: absolute;
	left: 0px;
	top: 86px;
	width: 100%;
	bottom: 0px;
	display: flex;
	justify-content: center;
	align-items: center;
}

.login_panel {
	width: 470px;
	padding: 32px 34px 30px 38px;
}

.login_panel_meta {
	width: 100%;
	height: 18px;
	display: flex;
	justify-content: space-between;
	align-items: center;
}

.login_panel_code,
.login_panel_state {
	color: #59656b;
	font-size: 8px;
	font-weight: bold;
	letter-spacing: 2px;
}

.login_panel_state {
	color: #73c785;
}

.panel_caption {
	width: 100%;
	margin-top: 14px;
	color: #ffffff;
	font-size: 22px;
	font-weight: bold;
	letter-spacing: 3px;
}

.panel_description {
	width: 100%;
	margin-top: 8px;
	margin-bottom: 24px;
	color: #707c82;
	font-size: 10px;
	line-height: 16px;
}

.login_action {
	display: flex;
	align-items: center;
	padding-right: 12px;
}

.frontend_footer {
	position: absolute;
	left: 28px;
	right: 28px;
	bottom: 14px;
	display: flex;
	justify-content: space-between;
	color: #465158;
	font-size: 8px;
	font-weight: bold;
	letter-spacing: 2px;
}


/* ============================================================
   MAIN MENU - SURVARIUM STYLE
   Full-screen character scene with floating HUD elements.
   ============================================================ */

.main_menu_body {
	background-color: #020405;
}

.main_menu_scene {
	position: absolute;

	left: 0px;
	top: 0px;
	right: 0px;
	bottom: 0px;

	width: 100%;
	height: 100%;

	z-index: 2;

	overflow: hidden;
	background-color: transparent;
}

.main_menu_scene_texture {
	position: absolute;

	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	z-index: 1;
}

.main_menu_scene_shade {
	position: absolute;

	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	z-index: 2;

	background-color: rgba(0, 0, 0, 0.00);
	pointer-events: none;
}

.main_menu_scene_vignette {
	position: absolute;

	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	z-index: 3;

	pointer-events: none;
}

.main_menu_scene_disabled {
	display: none;
}

/* ============================================================
   MAIN TOP BAR REDESIGN
   Top_Bar.png = 1920 x 78

   Layout:
   1) Level block      = 160 x 78
   2) Faction block    = 242 x 78
   3) Currency block   = 176 x 78
   4) Navigation block = 942 x 78
   5) Icon block       = 384 x 78
   Edge padding        = 8px left + 8px right
   Total               = 1904 x 78 inside 1920 x 78
   ============================================================ */

.frontend_shell_topbar {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 58px;
	z-index: 30;
	overflow: hidden;
	background-color: rgba(3, 5, 6, 0.00);
}

.frontend_topbar_background {
	position: absolute;
	left: 50%;
	top: 0px;
	width: 1920px;
	height: 58px;
	margin-left: -960px;
	z-index: 0;
	pointer-events: none;
}

.frontend_topbar_content {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 58px;
	margin-left: 0px;
	z-index: 1;
	display: flex;
	flex-direction: row;
}

/* ------------------------------------------------------------
   1. LEVEL INFO : 160 x 78
   ------------------------------------------------------------ */

.top_level_block {
	position: relative;
	width: 118px;
	height: 58px;
	display: flex;
	flex-direction: row;
	flex-shrink: 0;
	overflow: hidden;
}

.top_level_left {
	position: relative;
	width: 50px;
	height: 58px;
	padding-top: 8px;
	padding-left: 9px;
	flex-shrink: 0;
}

.top_level_value {
	width: 40px;
	height: 40px;
	color: #ffffff;
	font-size: 30px;
	font-weight: bold;
	line-height: 40px;
	letter-spacing: 0px;
	text-align: left;
	text-shadow: 0px 1px 3px rgba(0, 0, 0, 0.90);
}

.top_level_right {
	position: relative;
	width: 68px;
	height: 58px;
	padding-top: 9px;
	padding-right: 6px;
	flex-shrink: 0;
}

.top_level_caption {
	height: 10px;
	color: #e97831;
	font-size: 8px;
	font-weight: bold;
	line-height: 12px;
	letter-spacing: 2px;
}

.top_level_progress {
	position: relative;
	width: 62px;
	height: 5px;
	margin-top: 6px;
	background-color: rgba(5, 8, 10, 0.80);
	border-width: 1px;
	border-color: rgba(70, 82, 88, 0.80);
	overflow: hidden;
}

.top_level_progress_fill {
	width: 0%;
	height: 100%;
	background-color: #d15a17;
	border-right-width: 1px;
	border-right-color: #ff9b58;
}

.top_level_xp_text {
	width: 62px;
	margin-top: 5px;
	color: #d7dddf;
	font-size: 8px;
	font-weight: bold;
	line-height: 10px;
	letter-spacing: 1px;
	text-align: left;
	white-space: nowrap;
	overflow: hidden;
}

/* ------------------------------------------------------------
   2. FACTION INFO : 242 x 78
   ------------------------------------------------------------ */

.top_faction_block {
	position: relative;
	width: 192px;
	height: 58px;
	padding-top: 7px;
	padding-left: 8px;
	display: flex;
	flex-direction: row;
	flex-shrink: 0;
	overflow: hidden;
}

.top_faction_icon {
	position: relative;
	width: 42px;
	height: 42px;
	padding-top: 11px;
	color: #ffffff;
	background-color: rgba(18, 24, 28, 0.75);
	border-width: 1px;
	border-color: rgba(94, 108, 116, 0.75);
	font-size: 16px;
	font-weight: bold;
	line-height: 20px;
	letter-spacing: 1px;
	text-align: center;
	flex-shrink: 0;
}

.top_faction_info {
	position: relative;
	width: 134px;
	height: 42px;
	margin-left: 9px;
	padding-top: 2px;
	flex-shrink: 0;
}

.top_faction_caption {
	color: #6f7b82;
	font-size: 7px;
	font-weight: bold;
	line-height: 9px;
	letter-spacing: 2px;
}

.top_faction_name {
	width: 134px;
	margin-top: 4px;
	color: #ffffff;
	font-size: 13px;
	font-weight: bold;
	line-height: 15px;
	letter-spacing: 1px;
	white-space: nowrap;
	overflow: hidden;
	text-shadow: 0px 1px 3px rgba(0, 0, 0, 0.90);
}

.top_faction_level {
	width: 134px;
	margin-top: 4px;
	color: #e97831;
	font-size: 8px;
	font-weight: bold;
	line-height: 10px;
	letter-spacing: 2px;
	white-space: nowrap;
	overflow: hidden;
}

/* ------------------------------------------------------------
   3. CURRENCY : 176 x 78
   Shows 2 currencies only: GC and GD.
   Max display value is clamped by C++ to 999999999.
   ------------------------------------------------------------ */

.top_currency_block {
	position: relative;
	width: 150px;
	height: 58px;
	padding-top: 5px;
	padding-left: 6px;
	padding-right: 6px;
	flex-shrink: 0;
	overflow: hidden;
}

.top_currency_row {
	position: relative;
	width: 138px;
	height: 23px;
	margin-bottom: 3px;
	display: flex;
	flex-direction: row;
	align-items: center;
	background-color: rgba(9, 13, 16, 0.35);
	overflow: hidden;
}

.top_currency_icon {
	width: 16px;
	height: 16px;
	padding-top: 2px;
	margin-left: 0px;
	margin-right: 6px;
	color: #ffffff;
	background-color: rgba(20, 28, 32, 0.80);
	border-width: 1px;
	border-color: rgba(95, 109, 116, 0.70);
	font-size: 8px;
	font-weight: bold;
	line-height: 10px;
	text-align: center;
	flex-shrink: 0;
}

.top_currency_icon.gold {
	color: #ffb15e;
}

.top_currency_icon.dollars {
	color: #d4dde1;
}

.top_currency_label {
	width: 20px;
	color: #e97831;
	font-size: 8px;
	font-weight: bold;
	line-height: 12px;
	letter-spacing: 1px;
	flex-shrink: 0;
}

.top_currency_value {
	width: 70px;
	color: #ffffff;
	font-size: 10px;
	font-weight: bold;
	line-height: 12px;
	letter-spacing: 1px;
	text-align: right;
	white-space: nowrap;
	overflow: hidden;
	flex-shrink: 0;
}

.top_currency_add {
	width: 17px;
	height: 17px;
	margin-left: 5px;
	padding: 0px;
	color: #ffffff;
	background-color: rgba(32, 42, 47, 0.90);
	border-width: 1px;
	border-color: rgba(110, 123, 130, 0.75);
	font-size: 12px;
	font-weight: bold;
	line-height: 16px;
	text-align: center;
	flex-shrink: 0;
}

.top_currency_add:hover {
	background-color: rgba(65, 33, 20, 0.90);
	border-color: #d16b32;
	filter: drop-shadow(#e879324c 0px 0px 6px);
}

.top_currency_add:active {
	background-color: rgba(95, 38, 24, 0.95);
	border-color: #ff8b52;
}

/* ------------------------------------------------------------
   4. MAIN NAVIGATION : 962 x 78
   Each clickable block = 192 x 78
   Button texture       = 140 x 33
   ------------------------------------------------------------ */

.frontend_navigation {
	position: relative;
	width: 0px;
	height: 58px;
	padding-left: 1px;
	padding-right: 1px;
	display: flex;
	flex-direction: row;
	align-items: stretch;
	flex-grow: 1;
	flex-shrink: 1;
	z-index: 1;
	overflow: hidden;
}

.top_navigation_button {
	position: relative;
	width: 115px;
	min-width: 115px;
	height: 58px;
	padding: 0px;
	margin: 0px;
	color: rgba(0, 0, 0, 0);
	background-color: rgba(0, 0, 0, 0.00);
	border-width: 0px;
	font-size: 0px;
	line-height: 0px;
	text-align: center;
	overflow: hidden;
	flex-grow: 1;
	flex-shrink: 1;
}

.top_navigation_texture {
	position: absolute;
	left: 50%;
	top: 13px;
	width: 109px;
	height: 32px;
	margin-left: -54px;
	z-index: 0;
	pointer-events: none;
}

.top_navigation_texture_base {
	display: block;
}

.top_navigation_texture_active,
.top_navigation_texture_hover {
	display: none;
}

.top_navigation_button:hover .top_navigation_texture_base,
.top_navigation_button:hover .top_navigation_texture_active {
	display: none;
}

.top_navigation_button:hover .top_navigation_texture_hover {
	display: block;
}

.top_navigation_button:active .top_navigation_texture_base,
.top_navigation_button:active .top_navigation_texture_hover {
	display: none;
}

.top_navigation_button:active .top_navigation_texture_active {
	display: block;
}

.top_navigation_button.active .top_navigation_texture_base,
.top_navigation_button.selected .top_navigation_texture_base,
.top_navigation_button.active .top_navigation_texture_hover,
.top_navigation_button.selected .top_navigation_texture_hover {
	display: none;
}

.top_navigation_button.active .top_navigation_texture_active,
.top_navigation_button.selected .top_navigation_texture_active {
	display: block;
}

.top_navigation_label {
	position: absolute;
	left: 50%;
	top: 13px;
	width: 109px;
	height: 32px;
	margin-left: -54px;
	z-index: 1;
	color: #ffffff;
	font-size: 15px;
	font-weight: bold;
	line-height: 32px;
	letter-spacing: 1px;
	text-align: center;
	white-space: nowrap;
	text-shadow: 0px 1px 2px rgba(0, 0, 0, 0.90);
	pointer-events: none;
}

.top_navigation_button:hover .top_navigation_label {
	text-shadow: 0px 0px 8px rgba(255, 255, 255, 0.38);
}

.top_navigation_button.active .top_navigation_label,
.top_navigation_button.selected .top_navigation_label {
	text-shadow: 0px 0px 9px rgba(255, 255, 255, 0.36);
}

/* ------------------------------------------------------------
   5. SECONDARY ICON MENU : 384 x 78
   Six icon blocks  = 64 x 78
   Exit block       = 64 x 78
   Icon texture     = 32 x 33
   ------------------------------------------------------------ */

.frontend_account_actions {
	position: relative;
	width: 288px;
	height: 58px;
	display: flex;
	flex-direction: row;
	align-items: stretch;
	justify-content: flex-start;
	flex-shrink: 0;
	z-index: 1;
	overflow: hidden;
}

.top_icon_button {
	position: relative;
	width: 48px;
	min-width: 48px;
	height: 58px;
	padding: 0px;
	margin: 0px;
	color: rgba(0, 0, 0, 0);
	background-color: rgba(0, 0, 0, 0.00);
	border-width: 0px;
	font-size: 0px;
	line-height: 0px;
	overflow: hidden;
	flex-shrink: 0;
}

.top_icon_button.exit {
	width: 48px;
	min-width: 48px;
}

.top_icon_glyph {
	position: absolute;
	left: 6px;
	top: 12px;
	width: 36px;
	height: 34px;
	padding-top: 8px;
	color: #d7dbdd;
	background-color: rgba(8, 11, 13, 0.18);
	border-width: 1px;
	border-color: rgba(130, 138, 142, 0.18);
	font-size: 12px;
	font-weight: bold;
	line-height: 14px;
	text-align: center;
	text-shadow: 0px 1px 2px rgba(0, 0, 0, 0.90);
}

.top_icon_button:hover .top_icon_glyph {
	color: #ffffff;
	border-color: rgba(235, 215, 120, 0.52);
	text-shadow: 0px 0px 8px rgba(255, 230, 110, 0.55);
}

.top_icon_glyph.cart_icon {
	color: #f0d84e;
}

.top_icon_button_texture {
	position: absolute;
	left: 16px;
	top: 22px;
	width: 32px;
	height: 33px;
	z-index: 0;
	pointer-events: none;
}

.top_icon_button.exit .top_icon_button_texture {
	left: 16px;
}

.top_icon_button_no_active {
	display: block;
}

.top_icon_button_active,
.top_icon_button_hover {
	display: none;
}

.top_icon_button:hover .top_icon_button_no_active,
.top_icon_button:hover .top_icon_button_active {
	display: none;
}

.top_icon_button:hover .top_icon_button_hover {
	display: block;
}

.top_icon_button:active .top_icon_button_no_active,
.top_icon_button:active .top_icon_button_hover {
	display: none;
}

.top_icon_button:active .top_icon_button_active {
	display: block;
}

.top_icon_button.active .top_icon_button_no_active,
.top_icon_button.active .top_icon_button_hover {
	display: none;
}

.top_icon_button.active .top_icon_button_active {
	display: block;
}

/* ============================================================
   FLOATING HOME CARDS
   ============================================================ */

.home_overlay {
	position: absolute;
	left: 36px;
	top: 100px;
	width: 404px;
	z-index: 12;
}

.experience_card {
	width: 402px;
	height: 50px;
	padding: 0px;
	display: flex;
	align-items: center;
	color: #ffffff;
	background-color: rgba(24, 29, 33, 0.86);
	decorator: linear-gradient(180deg, #374047, #171e23 55%, #0b0f12) border-box;
	border-width: 1px;
	border-color: #465157;
	border-bottom-width: 2px;
	border-bottom-color: #182024;
	text-align: left;
	box-shadow: #00000088 0px 4px 8px 0px;

	/* Живые переходы */
	transition: background-color 0.20s, border-color 0.20s, border-bottom-color 0.20s, text-shadow 0.20s, filter 0.20s;
}

.experience_card:hover {
	background-color: rgba(33, 41, 45, 0.96);
	decorator: linear-gradient(180deg, #38454c, #202a30 52%, #101619) border-box;
	border-color: #e07830;
	border-bottom-color: #b04e24;
	text-shadow: 0px 0px 8px rgba(255, 150, 60, 0.40);
	filter: drop-shadow(#e8793240 0px 0px 8px);
}

.experience_icon {
	width: 58px;
	height: 48px;
	padding-top: 17px;
	color: #ffffff;
	background-color: #9e352f;
	decorator: linear-gradient(180deg, #d85745, #8f2f29 55%, #4b1715) border-box;
	border-right-width: 1px;
	border-right-color: #d75c4f;
	font-size: 10px;
	font-weight: bold;
	letter-spacing: 1px;
	text-align: center;
	flex-shrink: 0;
}

.experience_content {
	width: 342px;
	height: 48px;
	padding: 8px 13px 6px 13px;
}

.experience_title {
	color: #ffffff;
	font-size: 17px;
	font-weight: bold;
	letter-spacing: 1px;
}

.experience_text {
	margin-top: 2px;
	color: #df8e83;
	font-size: 8px;
	font-weight: bold;
}

.experience_progress {
	position: relative;
	width: 100%;
	height: 4px;
	margin-top: 5px;
	background-color: #172025;
	border-width: 1px;
	border-color: #3b454a;
}

.experience_progress_fill {
	width: 0%;
	height: 100%;
	background-color: #c44739;
}

.mission_card {
	position: relative;
	width: 404px;
	height: 174px;
	margin-top: 30px;
	background-color: rgba(10, 13, 15, 0.78);
	decorator: linear-gradient(90deg, #10161a, #11181c 55%, #541d19) border-box;
	border-width: 1px;
	border-color: rgba(92, 102, 108, 0.42);
	box-shadow: #00000090 0px 4px 12px 0px;
}

.mission_header {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 28px;
	padding-left: 12px;
	padding-right: 11px;
	display: flex;
	justify-content: space-between;
	align-items: center;
	background-color: rgba(8, 11, 13, 0.42);
	border-bottom-width: 0px;
}

.mission_type {
	color: #e97532;
	font-size: 7px;
	font-weight: bold;
	letter-spacing: 2px;
}

.mission_status {
	color: #6fbb7b;
	font-size: 7px;
	font-weight: bold;
	letter-spacing: 1px;
}

.mission_body {
	width: 100%;
	height: 126px;
	padding-top: 27px;
	display: flex;
	align-items: center;
}

.mission_emblem {
	width: 58px;
	height: 58px;
	margin-left: 12px;
	padding-top: 20px;
	color: #ffffff;
	background-color: #a43a32;
	border-width: 1px;
	border-color: #d75f51;
	font-size: 10px;
	font-weight: bold;
	text-align: center;
	flex-shrink: 0;
}

.mission_content {
	padding-left: 12px;
	padding-right: 12px;
	flex-grow: 1;
}

.mission_title {
	color: #ffffff;
	font-size: 20px;
	font-weight: bold;
	letter-spacing: 1px;
}

.mission_description {
	margin-top: 4px;
	color: #a4adb1;
	font-size: 10px;
}

.mission_progress_text {
	margin-top: 7px;
	color: #e57932;
	font-size: 7px;
	font-weight: bold;
	letter-spacing: 1px;
}

.mission_footer {
	width: 100%;
	height: 48px;
	padding-left: 68px;
	padding-right: 16px;
	display: flex;
	justify-content: space-between;
	align-items: center;
	color: #d8dde0;
	background-color: rgba(5, 8, 10, 0.64);
	border-top-width: 1px;
	border-top-color: #303a3f;
	font-size: 13px;
	font-weight: bold;
	letter-spacing: 1px;
}

.premium_badge {
	position: absolute;
	right: 0px;
	top: 100px;
	width: 350px;
	height: 48px;
	z-index: 12;
	padding-top: 14px;
	color: #e7eaec;
	background-color: rgba(24, 29, 33, 0.70);
	border-width: 1px;
	border-color: #3c474d;
	font-size: 12px;
	font-weight: bold;
	letter-spacing: 1px;
	text-align: center;

	/* Живой переход */
	transition: background-color 0.20s, border-color 0.20s, text-shadow 0.20s;
}

.premium_badge:hover {
	background-color: rgba(28, 36, 40, 0.92);
	border-color: #d4a030;
	text-shadow: 0px 0px 10px rgba(220, 170, 50, 0.45);
}

/* ============================================================
   RIGHT ACTION RAIL
   ============================================================ */

.right_action_rail {
	position: absolute;
	right: 0px;
	top: 190px;
	width: 44px;
	z-index: 14;
}

.rail_button {
	position: relative;
	width: 44px;
	height: 41px;
	margin-bottom: 2px;
	color: #aeb6ba;
	background-color: rgba(12, 16, 18, 0.66);
	decorator: linear-gradient(180deg, #33393c, #15191c 55%, #0a0c0d) border-box;
	border-width: 0px;
	border-left-width: 1px;
	border-left-color: rgba(190, 196, 198, 0.18);
	border-bottom-width: 1px;
	border-bottom-color: rgba(0, 0, 0, 0.48);
	box-shadow: #00000088 0px 3px 6px 0px;

	/* Живые переходы */
	transition: color 0.18s, background-color 0.18s, border-color 0.18s, border-bottom-color 0.18s, text-shadow 0.18s, filter 0.18s;
}

.rail_button:hover {
	color: #ffffff;
	background-color: rgba(39, 47, 51, 0.96);
	decorator: linear-gradient(180deg, #39464d, #1e282d 52%, #0c1114) border-box;
	border-color: #e07830;
	border-bottom-color: #b04e24;
	text-shadow: 0px 0px 10px rgba(255, 150, 60, 0.50);
	filter: drop-shadow(#e879324c 0px 0px 8px);
}

.rail_decorative {
	color: #8e979b;
}

.rail_plus {
	color: #ffe954;
	text-shadow: 0px 0px 10px rgba(255, 230, 80, 0.60);
}

.rail_button_code {
	width: 44px;
	height: 41px;
	padding-top: 13px;
	font-size: 9px;
	font-weight: bold;
	letter-spacing: 0px;
	text-align: center;
}

.rail_plus .rail_button_code {
	padding-top: 8px;
	font-size: 26px;
	line-height: 28px;
}

.rail_button_tooltip {
	display: none;
	position: absolute;
	right: 52px;
	top: 4px;
	width: 145px;
	height: 36px;
	padding-top: 12px;
	color: #ffffff;
	background-color: rgba(8, 12, 14, 0.95);
	decorator: linear-gradient(180deg, #263237, #11181c 54%, #070b0d) border-box;
	border-width: 1px;
	border-color: #475258;
	font-size: 8px;
	font-weight: bold;
	letter-spacing: 1px;
	text-align: center;
}

.rail_button:hover .rail_button_tooltip {
	display: block;
}

/* ============================================================
   SURVIVOR IDENTITY
   ============================================================ */

.survivor_identity {
	position: absolute;
	left: 31px;
	bottom: 70px;
	z-index: 13;
	display: flex;
	align-items: center;
}

.survivor_state {
	min-width: 67px;
	height: 28px;
	padding-top: 9px;
	font-size: 7px;
	font-weight: bold;
	letter-spacing: 2px;
	text-align: center;
}

.survivor_state.ready {
	color: #e6f6e9;
	background-color: rgba(24, 72, 35, 0.92);
	border-width: 1px;
	border-color: #4a905a;
}

.survivor_state.wounded {
	color: #fff0c8;
	background-color: rgba(79, 57, 19, 0.92);
	border-width: 1px;
	border-color: #b17a2b;
}

.survivor_state.dead {
	color: #ffd6d6;
	background-color: rgba(79, 21, 23, 0.92);
	border-width: 1px;
	border-color: #a34a4f;
}

.survivor_identity_text {
	margin-left: 11px;
	padding: 6px 11px 7px 11px;
	background-color: rgba(5, 8, 10, 0.72);
	border-left-width: 2px;
	border-left-color: #df6d2d;
}

.survivor_nickname {
	color: #ffffff;
	font-size: 13px;
	font-weight: bold;
	letter-spacing: 1px;
}

.survivor_class {
	margin-top: 3px;
	color: #e57731;
	font-size: 7px;
	font-weight: bold;
	letter-spacing: 2px;
}

/* ============================================================
   PLAY / SQUAD
   ============================================================ */

.bottom_play_area {
	position: absolute;
	left: 31px;
	bottom: 14px;
	height: 49px;
	z-index: 15;
	display: flex;
	align-items: center;
}

.play_button {
	width: 399px;
	height: 49px;
	padding: 0px;
	display: flex;
	align-items: center;
	color: #ffffff;
	background-color: rgba(178, 54, 45, 0.90);
	decorator: linear-gradient(180deg, #d94e43, #a8332d 48%, #68211e) border-box;
	border-width: 1px;
	border-color: #df6555;
	border-bottom-width: 3px;
	border-bottom-color: #591b17;
	text-align: left;
	box-shadow: #000000aa 0px 5px 10px 0px;
	filter: drop-shadow(#00000099 0px 3px 4px);
	transition: background-color 0.16s, border-color 0.16s, border-bottom-color 0.16s, text-shadow 0.16s, filter 0.16s;
}

.play_button:hover {
	background-color: rgba(187, 61, 51, 0.97);
	decorator: linear-gradient(180deg, #ff947d, #d14a3e 45%, #76241f) border-box;
	border-color: #ff8977;
	border-bottom-color: #7d261f;
	text-shadow: 0px 0px 10px rgba(255, 203, 182, 0.45);
	animation: frontend_play_breathe 0.72s linear infinite alternate;
}

.play_button:active {
	background-color: rgba(113, 37, 33, 0.97);
	decorator: linear-gradient(180deg, #8d2f29, #5c1c19 58%, #35100e) border-box;
	border-bottom-width: 1px;
}

.play_button_icon {
	width: 64px;
	height: 47px;
	padding-top: 14px;
	color: #ffffff;
	background-color: rgba(0, 0, 0, 0.15);
	decorator: linear-gradient(180deg, #2a353a, #11181c 52%, #070b0d) border-box;
	border-right-width: 1px;
	border-right-color: rgba(255, 255, 255, 0.16);
	font-size: 14px;
	font-weight: bold;
	letter-spacing: 1px;
	text-align: center;
}

.play_button_text {
	width: 333px;
	padding-left: 0px;
	font-size: 25px;
	font-weight: bold;
	letter-spacing: 1px;
	text-align: center;
}

.squad_slots {
	width: 200px;
	height: 49px;
	margin-left: 34px;
}

.squad_slot {
	width: 195px;
	height: 22px;
	margin-bottom: 3px;
	padding-left: 10px;
	display: flex;
	align-items: center;
	color: #949ea3;
	background-color: rgba(8, 12, 14, 0.80);
	border-width: 1px;
	border-color: #394449;
	font-size: 7px;
	font-weight: bold;
	letter-spacing: 1px;
}

.squad_slot_plus {
	width: 24px;
	color: #d9dfe1;
	font-size: 13px;
	text-align: center;
}

.squad_slot.disabled {
	color: #4e585d;
	border-color: #252e32;
}

/* ============================================================
   PREVIEW HELP / STATUS
   ============================================================ */

.preview_help {
	display: none;
	position: absolute;
	left: 50%;
	bottom: 63px;
	width: 330px;
	margin-left: -165px;
	z-index: 12;
	padding: 7px 10px;
	color: #a4adb1;
	background-color: rgba(4, 7, 9, 0.58);
	border-top-width: 1px;
	border-top-color: rgba(128, 139, 145, 0.34);
	font-size: 10px;
	font-weight: bold;
	letter-spacing: 1px;
	text-align: center;
}

.main_menu_status_bar {
	position: absolute;
	left: 0px;
	right: 0px;
	bottom: 0px;
	height: 23px;
	z-index: 18;
	padding-left: 28px;
	padding-right: 28px;
	display: flex;
	justify-content: space-between;
	align-items: center;
	background-color: rgba(4, 7, 9, 0.45);
	border-top-width: 1px;
	border-top-color: rgba(66, 77, 82, 0.52);
}

.main_menu_status_left {
	height: 23px;
	display: flex;
	align-items: center;
	flex-grow: 1;
}

.status_indicator {
	width: 9px;
	height: 9px;
	margin-right: 10px;
	background-color: #5cc56e;
	border-width: 1px;
	border-color: #88dc96;
}

.frontend_status {
	color: #8e999e;
	font-size: 8px;
}

.preview_server_information {
	height: 23px;
	display: flex;
	align-items: center;
}

.server_information_label {
	margin-left: 7px;
	color: #59656b;
	font-size: 10px;
	font-weight: bold;
}

.server_information_value {
	margin-left: 4px;
	color: #a0aaae;
	font-size: 10px;
	font-weight: bold;
}

.server_information_separator {
	margin-left: 8px;
	color: #414b50;
	font-size: 8px;
}

.connection_bars {
	width: 18px;
	height: 15px;
	margin-left: 10px;
	display: flex;
	align-items: flex-end;
}

.connection_bar {
	width: 3px;
	margin-right: 2px;
	background-color: #5fc878;
}

.connection_bar.bar_one {
	height: 4px;
}

.connection_bar.bar_two {
	height: 8px;
}

.connection_bar.bar_three {
	height: 12px;
}

/* ============================================================
   CHAT BAR
   ============================================================ */

.frontend_chat_bar {
	position: absolute;
	left: 430px;
	right: 300px;
	bottom: 13px;
	height: 22px;
	z-index: 30;
	padding-left: 0px;
	display: flex;
	align-items: center;
	background-color: rgba(5, 8, 10, 0.52);
	border-top-width: 0px;
	border-top-color: rgba(37, 46, 50, 0.00);
}

.chat_icon {
	width: 20px;
	height: 18px;
	margin-right: 12px;
	padding-top: 2px;
	color: #9ca6aa;
	background-color: rgba(21, 29, 33, 0.55);
	font-size: 8px;
	font-weight: bold;
	text-align: center;
}

.chat_hint {
	color: #616d73;
	font-size: 8px;
}

/* ============================================================
   SKILLS / SHOP CONTENT SCREENS
   ============================================================ */

.frontend_static_background {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	z-index: 0;
	overflow: hidden;
	background-color: #030506;
}

.frontend_static_background_image {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	z-index: 1;
}

.frontend_static_background_shade,
.skills_scene_scrim {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	pointer-events: none;
}

.frontend_static_background_shade {
	z-index: 2;
	background-color: rgba(0, 0, 0, 0.46);
}

.skills_scene_scrim {
	z-index: 4;
	background-color: rgba(0, 0, 0, 0.26);
}

.skills_layout,
.shop_layout {
	position: absolute;
	left: 28px;
	right: 4px;
	top: 86px;
	bottom: 42px;
	z-index: 12;
	display: flex;
	flex-direction: row;
}

.skills_panel,
.shop_panel {
	position: relative;
	height: 100%;
	background-color: rgba(8, 12, 15, 0.86);
	decorator: linear-gradient(180deg, #1d262b, #0d1316 58%, #06090b) border-box;
	border-width: 1px;
	border-color: rgba(88, 100, 106, 0.62);
	box-shadow: #00000099 0px 4px 12px 0px;
	overflow: hidden;
}

.skills_left_panel {
	width: 292px;
	margin-right: 12px;
	padding: 16px;
	flex-shrink: 0;
}

.skills_tree_panel {
	flex-grow: 1;
	margin-right: 12px;
	padding: 16px;
}

.skills_details_panel {
	width: 318px;
	padding: 16px;
	flex-shrink: 0;
}

.skills_panel_header,
.skills_tree_header,
.shop_panel_header {
	width: 100%;
	height: 58px;
	display: flex;
	justify-content: space-between;
	align-items: center;
	border-bottom-width: 1px;
	border-bottom-color: rgba(84, 96, 102, 0.55);
}

.skills_panel_title,
.shop_panel_title {
	color: #ffffff;
	font-size: 16px;
	font-weight: bold;
	line-height: 18px;
	letter-spacing: 1px;
}

.skills_panel_subtitle,
.shop_panel_subtitle {
	margin-top: 4px;
	color: #e17332;
	font-size: 8px;
	font-weight: bold;
	line-height: 10px;
	letter-spacing: 2px;
}

.skills_points_box {
	width: 58px;
	height: 42px;
	padding-top: 6px;
	background-color: rgba(161, 54, 47, 0.92);
	border-width: 1px;
	border-color: #d75f51;
	text-align: center;
}

.skills_points_label {
	color: #ffffff;
	font-size: 8px;
	font-weight: bold;
	letter-spacing: 1px;
}

.skills_points_value {
	color: #ffffff;
	font-size: 17px;
	font-weight: bold;
	line-height: 18px;
}

.skills_survivor_card {
	width: 100%;
	height: 78px;
	margin-top: 14px;
	display: flex;
	background-color: rgba(5, 8, 10, 0.66);
	border-width: 1px;
	border-color: rgba(67, 78, 84, 0.66);
}

.skills_survivor_level {
	width: 66px;
	height: 76px;
	padding-top: 12px;
	background-color: rgba(160, 55, 47, 0.88);
	text-align: center;
	flex-shrink: 0;
}

.skills_survivor_level_number {
	color: #ffffff;
	font-size: 28px;
	font-weight: bold;
	line-height: 30px;
}

.skills_survivor_level_label {
	margin-top: 2px;
	color: #ffd8d3;
	font-size: 7px;
	font-weight: bold;
	letter-spacing: 1px;
}

.skills_survivor_info {
	width: 192px;
	padding: 12px 12px 8px 12px;
}

.skills_survivor_name {
	color: #ffffff;
	font-size: 14px;
	font-weight: bold;
	line-height: 16px;
}

.skills_survivor_class {
	margin-top: 3px;
	color: #e17332;
	font-size: 8px;
	font-weight: bold;
