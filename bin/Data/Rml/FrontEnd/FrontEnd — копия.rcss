	font-size: 9px;
	line-height: 14px;
}

.appearance_title {
	width: 100%;
	margin-top: 22px;
	margin-bottom: 9px;
	padding-bottom: 9px;
	color: #e67530;
	border-bottom-width: 1px;
	border-bottom-color: #303a40;
	font-size: 9px;
	font-weight: bold;
	letter-spacing: 2px;
}

.appearance_row {
	width: 100%;
	height: 50px;
	margin-top: 7px;
	padding-left: 10px;
	padding-right: 10px;
	display: flex;
	align-items: center;
	background-color: #090e11;
	border-width: 1px;
	border-color: #303a40;
}

.appearance_label {
	width: 40%;
	color: #8c989e;
	font-size: 9px;
	font-weight: bold;
	letter-spacing: 1px;
}

.appearance_button {
	width: 38px;
