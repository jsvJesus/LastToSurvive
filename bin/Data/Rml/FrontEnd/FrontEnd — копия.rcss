	font-weight: bold;
	letter-spacing: 2px;
}

.preview_character_description {
	width: 330px;
	margin-top: 10px;
	margin-left: auto;
	margin-right: auto;
	color: #748087;
	font-size: 10px;
	line-height: 16px;
	text-align: center;
}

.create_character_info {
	width: 100%;
	margin-top: 14px;
	padding: 12px;
	background-color: #090e11;
	border-width: 1px;
	border-color: #303a40;
}

.create_info_row {
	width: 100%;
	height: 24px;
	display: flex;
	justify-content: space-between;
	align-items: center;
}

.create_info_label {
	color: #77848a;
	font-size: 8px;
