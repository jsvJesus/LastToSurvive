   CHARACTER CREATE
   ============================================================ */

.character_create_layout {
	position: absolute;
	left: 18px;
	right: 18px;
	top: 108px;
	bottom: 61px;
	display: flex;
}

.create_preview_panel {
	position: relative;
	width: 64%;
	height: 100%;
	margin-right: 14px;
	padding: 18px;
	background-color: rgba(8, 13, 16, 0.97);
	border-width: 1px;
	border-color: #30383d;
	overflow: hidden;
}

.create_form_panel {
	position: relative;
	width: 36%;
	height: 100%;
	padding: 18px;
	background-color: rgba(8, 13, 16, 0.97);
	border-width: 1px;
	border-color: #30383d;
	overflow: hidden;
}

.create_preview_area {
	position: relative;
	width: 100%;
	height: 62%;
	margin-top: 14px;
	background-color: #05080a;
	border-width: 1px;
	border-color: #354047;
	overflow: hidden;
}

.create_preview_placeholder {
