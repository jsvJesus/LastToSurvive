/* ============================================================
   TOP BAR ONLY
   ============================================================ */

.topbar_body {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 88px;

	overflow: visible;

	background-color: rgba(0, 0, 0, 0);
}

.topbar_root {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 88px;

	overflow: visible;

	background-color: rgba(6, 9, 11, 255);

	border-bottom-width: 1px;
	border-bottom-color: rgba(217, 109, 42, 255);
}

/* LEFT PROFILE */

.topbar_left_profile {
	position: absolute;
	left: 34px;
	top: 9px;

	width: 250px;
	height: 34px;

	display: flex;
	align-items: center;
}

.topbar_faction_icon {
	width: 44px;
	height: 44px;

	margin-right: 10px;
	padding-top: 15px;

	color: #ffffff;
	background-color: rgba(10, 14, 17, 255);

	border-width: 1px;
	border-color: rgba(89, 101, 108, 255);

	font-size: 13px;
	font-weight: bold;
	text-align: center;
}

.topbar_profile_text {
	width: 190px;
	height: 34px;

	padding-top: 0px;

	overflow: hidden;
}

.topbar_profile_label {
	color: #6f7b82;

	font-size: 8px;
	font-weight: bold;
	letter-spacing: 2px;
	line-height: 11px;
}

.topbar_profile_name {
	width: 190px;
	height: 24px;

	margin-top: 5px;

	overflow: hidden;

	color: #ffffff;

	font-size: 15px;
	font-weight: bold;
	letter-spacing: 2px;
	line-height: 18px;

	white-space: nowrap;
}

.topbar_profile_role {
	margin-top: 1px;

	color: #d96d2a;

	font-size: 8px;
	font-weight: bold;
	letter-spacing: 2px;
	line-height: 11px;
}

.topbar_level_row {
	width: 190px;
	height: 11px;

	margin-top: 2px;

	display: flex;
	align-items: center;
}

.topbar_level_label {
	color: #6f7b82;

	font-size: 7px;
	font-weight: bold;
	letter-spacing: 1px;
}

.topbar_level_value {
	margin-left: 4px;

	color: #ffffff;

	font-size: 8px;
	font-weight: bold;
}

.topbar_xp_text {
	margin-left: 8px;

	color: #7f8a90;

	font-size: 7px;
	font-weight: bold;
}

.topbar_xp_bar {
	width: 160px;
	height: 3px;

	margin-top: 3px;

	background-color: rgba(0, 0, 0, 255);
}

.topbar_xp_fill {
	width: 0%;
	height: 3px;

	background-color: #d96d2a;
}

/* MONEY */

.topbar_money {
	position: absolute;
	left: 292px;
	top: 8px;

	width: 440px;
	height: 36px;

	display: flex;
	align-items: center;

	overflow: visible;
}

.topbar_money_item {
	height: 36px;

	margin-right: 14px;

	display: flex;
	align-items: center;
}

.topbar_money_icon {
	width: 26px;
	height: 26px;

	margin-right: 8px;
}

.topbar_money_value {
	min-width: 76px;
	height: 28px;

	padding-top: 5px;

	color: #ffffff;

	font-size: 15px;
	font-weight: bold;
	line-height: 17px;
	text-align: left;
	letter-spacing: 1px;

	white-space: nowrap;
}

.currency_zc .topbar_money_value {
	color: #ffb15e;
}

.currency_zd .topbar_money_value {
	color: #e8eef0;
}

.currency_zlt .topbar_money_value {
	color: #f1d27a;
}

.topbar_money_add {
	width: 20px;
	height: 20px;

	margin-left: 4px;
	padding: 0px;

	color: #ffffff;
	background-color: rgba(28, 36, 40, 255);

	border-width: 1px;
	border-color: rgba(113, 127, 134, 255);

	font-size: 13px;
	font-weight: bold;
	line-height: 16px;
	text-align: center;

}

.topbar_money_add:hover {
	background-color: rgba(72, 36, 20, 255);
	border-color: #e07830;
}

/* CENTER TABS */

.topbar_tabs {
	position: absolute;
	left: 50%;
	top: 47px;

	width: 640px;
	height: 36px;

	margin-left: -320px;

	display: flex;
	align-items: center;
}

.topbar_tab {
	position: relative;

	width: 128px;
	height: 36px;

	margin-right: 1px;
	padding: 0px;

	color: #d9e1e4;
	background-color: rgba(12, 17, 21, 255);

	border-width: 1px;
	border-color: rgba(63, 75, 83, 255);
	border-bottom-width: 2px;
	border-bottom-color: rgba(0, 0, 0, 255);

	font-size: 0px;

	text-shadow: none;
}

.topbar_tab:hover {
	color: #ffffff;
	background-color: rgba(34, 44, 50, 255);

	border-color: rgba(120, 132, 140, 255);
	border-bottom-color: #d96d2a;

}

.topbar_tab.active {
	color: #ffffff;
	background-color: rgba(144, 43, 32, 255);

	border-color: rgba(255, 137, 82, 255);
	border-bottom-width: 3px;
	border-bottom-color: #ff9a55;
}

.topbar_tab.shop {
	background-color: rgba(86, 68, 31, 255);

	border-color: rgba(170, 146, 76, 255);
}

.topbar_tab.shop.active,
.topbar_tab.shop:hover {
	color: #ffffff;
	background-color: rgba(150, 116, 45, 255);

	border-color: rgba(230, 194, 105, 255);
	border-bottom-color: #f1c864;
}

.topbar_tab_label {
	position: absolute;
	left: 0px;
	top: 9px;

	width: 100%;
	height: 18px;

	color: inherit;

	font-size: 12px;
	font-weight: bold;
	line-height: 15px;
	letter-spacing: 1px;

	text-align: center;
	white-space: nowrap;

	text-shadow: 0px 1px 2px rgba(0, 0, 0, 255);
	pointer-events: none;
}

/* RIGHT ICONS */

.topbar_actions {
	position: absolute;
	right: 34px;
	top: 7px;

	width: 230px;
	height: 42px;

	display: flex;
	align-items: center;
	justify-content: flex-end;

	overflow: visible;
}

.topbar_icon_button {
	position: relative;

	width: 38px;
	height: 38px;

	margin-left: 4px;
	padding: 0px;

	background-color: rgba(16, 21, 25, 255);

	border-width: 1px;
	border-color: rgba(65, 76, 84, 255);
	border-bottom-width: 2px;
	border-bottom-color: rgba(0, 0, 0, 255);

}

.topbar_icon_button:hover {
	background-color: rgba(31, 39, 45, 255);

	border-color: rgba(217, 109, 42, 255);
	border-bottom-color: #d96d2a;

}

.topbar_icon_image {
	width: 38px;
	height: 38px;

	opacity: 0.78;

	pointer-events: none;
}

.topbar_icon_button:hover .topbar_icon_image {
	opacity: 1.00;
}

.topbar_tooltip {
	display: none;

	position: absolute;
	left: -45px;
	top: 50px;

	width: 132px;
	height: 26px;

	padding-top: 7px;

	color: #ffffff;
	background-color: rgba(5, 8, 10, 255);

	border-width: 1px;
	border-color: rgba(232, 120, 50, 255);

	font-size: 9px;
	font-weight: bold;
	line-height: 10px;
	letter-spacing: 1px;
	text-align: center;
	white-space: nowrap;

	z-index: 100;
	pointer-events: none;
}

.topbar_icon_button:hover .topbar_tooltip {
	display: block;
}
