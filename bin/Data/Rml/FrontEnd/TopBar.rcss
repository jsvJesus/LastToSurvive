/* ============================================================
   TOP BAR - NOESIS CONVERTED
   ============================================================ */

.topbar_body {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 78px;

	margin: 0px;
	padding: 0px;

	overflow: visible;

	background-color: rgba(0, 0, 0, 0);
}

.topbar_root {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 78px;

	overflow: visible;

	background-color: #4d5052;
}

.topbar_background {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 1920px;
	height: 78px;

	pointer-events: none;
}


/* LEVEL / CHARACTER */

.topbar_level_block {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 245px;
	height: 78px;

	overflow: visible;
}

.topbar_level_badge {
	position: absolute;
	left: 12px;
	top: 9px;

	width: 67px;
	height: 62px;

	pointer-events: none;
}

.topbar_level_value {
	position: absolute;
	left: 20px;
	top: 14px;

	width: 48px;
	height: 38px;

	color: #ffffff;

	font-family: "Play";
	font-size: 24px;
	font-weight: bold;
	line-height: 38px;
	text-align: center;

	pointer-events: none;
}

.topbar_level_title {
	position: absolute;
	left: 80px;
	top: 27px;

	width: 24px;
	height: 12px;

	color: #e1e9ed;

	font-size: 8px;
	line-height: 12px;
	text-align: left;

	pointer-events: none;
}

.topbar_character_name {
	position: absolute;
	left: 105px;
	top: 27px;

	width: 125px;
	height: 12px;

	overflow: hidden;

	color: #e1e9ed;

	font-size: 8px;
	line-height: 12px;
	text-align: right;

	white-space: nowrap;

	pointer-events: none;
}

.topbar_level_progress_bg {
	position: absolute;
	left: 80px;
	top: 39px;

	width: 150px;
	height: 10px;

	background-color: rgba(0, 0, 0, 0);

	border-width: 1px;
	border-color: #222222;

	overflow: hidden;
}

.topbar_level_progress_fill {
	width: 50%;
	height: 100%;

	background-color: #700d0d;
}


/* MONEY */

.topbar_money {
	position: absolute;
	left: 325px;
	top: 21px;

	width: 590px;
	height: 36px;

	display: flex;
	align-items: center;

	overflow: visible;
}

.topbar_money_item {
	width: 190px;
	height: 36px;

	margin-right: 12px;

	display: flex;
	align-items: center;

	overflow: visible;
}

.topbar_money_icon {
	width: 36px;
	height: 36px;

	margin-right: 0px;

	flex-grow: 0;
	flex-shrink: 0;

	pointer-events: none;
}

.topbar_money_value {
	width: 75px;
	height: 20px;

	margin-left: 0px;
	padding: 0px 5px;

	color: #ffffff;

	background-image: url("../Assets/MainMenu/topbar_money_bg.png");

	font-family: "Play";
	font-size: 14px;
	font-weight: normal;
	line-height: 20px;
	text-align: right;

	white-space: nowrap;

	flex-grow: 0;
	flex-shrink: 0;
}


/* CENTER MENU */

.topbar_tabs {
	position: absolute;
	left: 650px;
	top: 17px;

	width: 1000px;
	height: 43px;

	display: flex;
	align-items: center;

	overflow: visible;
}

.topbar_tab {
	position: relative;

	width: 150px;
	height: 43px;

	margin-right: 20px;
	padding: 0px;

	color: #e1e9ed;

	background-color: rgba(0, 0, 0, 0);
	background-image: url("../Assets/MainMenu/btn_tabs/button_top_bar.png");

	border-width: 0px;

	font-size: 0px;

	flex-grow: 0;
	flex-shrink: 0;
}

.topbar_tab:hover {
	color: #ffffff;

	filter: none;
}

.topbar_tab.active {
	color: #ffffff;

	filter: none;
}

.topbar_tab_label {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 150px;
	height: 43px;

	color: inherit;

	font-family: "Exo 2";
	font-size: 24px;
	font-weight: normal;
	line-height: 43px;
	text-align: center;

	pointer-events: none;
}


/* RIGHT ACTION BUTTONS */

.topbar_actions {
	position: absolute;
	right: 20px;
	top: 10px;

	width: 192px;
	height: 58px;

	display: flex;
	align-items: center;
	justify-content: flex-end;

	overflow: visible;
}

.topbar_action_button {
	position: relative;

	width: 48px;
	height: 58px;

	margin-left: 0px;
	padding: 0px;

	background-color: rgba(0, 0, 0, 0);

	border-width: 0px;

	flex-grow: 0;
	flex-shrink: 0;
}

.topbar_action_button.change_name {
	background-image: url("../Assets/MainMenu/btn_actions/btn_change_name.png");
}

.topbar_action_button.rating {
	background-image: url("../Assets/MainMenu/btn_actions/btn_rating.png");
}

.topbar_action_button.options {
	background-image: url("../Assets/MainMenu/btn_actions/btn_settings.png");
}

.topbar_action_button.exit {
	background-image: url("../Assets/MainMenu/btn_actions/btn_frontend_exit.png");
}

.topbar_action_button:hover {
	filter: none;
}

.topbar_tooltip {
	display: none;

	position: absolute;
	left: -42px;
	top: 62px;

	width: 132px;
	height: 26px;

	padding-top: 7px;

	color: #ffffff;
	background-color: rgba(5, 8, 10, 255);

	border-width: 1px;
	border-color: rgba(232, 120, 50, 255);

	font-size: 9px;
	font-weight: bold;
	line-height: 10px;
	letter-spacing: 1px;
	text-align: center;
	white-space: nowrap;

	z-index: 100;
	pointer-events: none;
}

.topbar_action_button:hover .topbar_tooltip {
	display: block;
}