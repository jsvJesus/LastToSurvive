/* ============================================================
   TOP BAR - MAINMENU.XAML REDESIGN FOR RMLUI
   Source design: tools/Noesis/MainMenu.xaml
   Target runtime: bin/Data/Rml/FrontEnd/TopBar.rml
   ============================================================ */

.topbar_body {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 78px;

	margin: 0px;
	padding: 0px;

	overflow: visible;
	background-color: rgba(0, 0, 0, 0);
}

.topbar_root {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 78px;

	overflow: visible;
	background-color: rgba(0, 0, 0, 0);
}

.topbar_background {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 1920px;
	height: 78px;

	opacity: 1.00;
	pointer-events: none;
}

/* MONEY */

.topbar_money {
	position: absolute;
	left: 56px;
	top: 0px;

	width: 349px;
	height: 78px;

	overflow: visible;
}

.topbar_money_item {
	position: absolute;
	top: 0px;

	width: 164px;
	height: 78px;

	overflow: visible;
}

.topbar_money_item.money_zc {
	left: 0px;
}

.topbar_money_item.money_zd {
	left: 185px;
}

.topbar_money_icon {
	position: absolute;
	left: 0px;
	top: 7px;

	width: 64px;
	height: 64px;

	pointer-events: none;
}

.topbar_money_add {
	position: absolute;
	left: 45px;
	top: 32px;

	width: 14px;
	height: 14px;

	margin: 0px;
	padding: 0px;

	background-color: rgba(0, 0, 0, 0);
	decorator: none;

	border-width: 0px;
	border-color: rgba(0, 0, 0, 0);

	color: rgba(0, 0, 0, 0);
	font-size: 0px;
	line-height: 0px;

	overflow: visible;
}

.topbar_money_add:hover,
.topbar_money_add:active,
.topbar_money_add:focus {
	background-color: rgba(0, 0, 0, 0);
	decorator: none;
	border-width: 0px;
	border-color: rgba(0, 0, 0, 0);
	color: rgba(0, 0, 0, 0);
}

.topbar_money_add_icon {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 14px;
	height: 14px;

	pointer-events: none;
}

.topbar_money_add:hover .topbar_money_add_icon {
	opacity: 0.82;
}

.topbar_money_value {
	position: absolute;
	left: 64px;
	top: 23px;

	width: 100px;
	height: 32px;

	padding-top: 5px;
	padding-bottom: 5px;
	padding-left: 0px;
	padding-right: 0px;

	color: #e1e9ed;

	font-family: "Exo 2", Tahoma, Arial;
	font-size: 18px;
	font-weight: normal;
	line-height: 22px;
	text-align: center;

	white-space: nowrap;
	overflow: hidden;

	pointer-events: none;
}

/* CENTER NAVIGATION */

.topbar_tabs {
	position: absolute;
	left: 460px;
	top: 0px;

	width: 1000px;
	height: 78px;

	overflow: visible;
}

.topbar_tab {
	position: absolute;
	top: 0px;

	width: 200px;
	height: 78px;

	margin: 0px;
	padding: 0px;

	color: #e1e9ed;
	background-color: rgba(0, 0, 0, 0);
	decorator: none;

	border-width: 0px;
	border-color: rgba(0, 0, 0, 0);

	font-size: 0px;
	line-height: 0px;
	text-shadow: none;
	filter: none;

	overflow: visible;
}

.topbar_tab:hover,
.topbar_tab:active,
.topbar_tab:focus {
	background-color: rgba(0, 0, 0, 0);
	decorator: none;
	border-width: 0px;
	border-color: rgba(0, 0, 0, 0);
	color: #ffffff;
	text-shadow: none;
	filter: none;
}

.topbar_tab.tab_home {
	left: 0px;
}

.topbar_tab.tab_skills {
	left: 200px;
}

.topbar_tab.tab_equipment {
	left: 400px;
}

.topbar_tab.tab_shop {
	left: 600px;
}

.topbar_tab.tab_clan {
	left: 800px;
}

.topbar_tab_bg {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 200px;
	height: 78px;

	opacity: 1.00;
	pointer-events: none;
}

.topbar_tab:hover .topbar_tab_bg {
	opacity: 0.90;
}

.topbar_tab.active .topbar_tab_bg {
	opacity: 1.00;
}

.topbar_tab_label {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 200px;
	height: 78px;

	padding-top: 0px;
	padding-left: 0px;
	padding-right: 0px;
	padding-bottom: 0px;

	color: inherit;

	font-family: Play, Tahoma, Arial;
	font-size: 24px;
	font-weight: normal;
	line-height: 78px;
	text-align: center;

	white-space: nowrap;
	pointer-events: none;
}

.topbar_tab.active .topbar_tab_label,
.topbar_tab:hover .topbar_tab_label {
	color: #ffffff;
}

/* RIGHT ACTIONS */

.topbar_actions {
	position: absolute;
	left: 1594px;
	top: 0px;

	width: 256px;
	height: 78px;

	overflow: visible;
}

.topbar_action_button {
	position: absolute;
	top: 0px;

	width: 64px;
	height: 64px;

	margin: 0px;
	padding: 0px;

	background-color: rgba(0, 0, 0, 0);
	decorator: none;

	border-width: 0px;
	border-color: rgba(0, 0, 0, 0);

	color: rgba(0, 0, 0, 0);
	font-size: 0px;
	line-height: 0px;
	text-shadow: none;
	filter: none;

	overflow: visible;
}

.topbar_action_button:hover,
.topbar_action_button:active,
.topbar_action_button:focus {
	background-color: rgba(0, 0, 0, 0);
	decorator: none;
	border-width: 0px;
	border-color: rgba(0, 0, 0, 0);
	color: rgba(0, 0, 0, 0);
	text-shadow: none;
	filter: none;
}

.topbar_action_button.action_awards {
	left: 0px;
	top: 0px;
}

.topbar_action_button.action_rating {
	left: 64px;
	top: 0px;
}

.topbar_action_button.action_options {
	left: 128px;
	top: 0px;
}

.topbar_action_button.action_exit {
	left: 192px;
	top: 0px;
	height: 78px;
}

.topbar_action_icon {
	position: absolute;
	left: 16px;
	top: 16px;

	width: 32px;
	height: 32px;

	opacity: 1.00;
	pointer-events: none;
}

.topbar_action_button.action_exit .topbar_action_icon {
	top: 23px;
}

.topbar_action_button:hover .topbar_action_icon {
	opacity: 0.82;
}

/* TOOLTIP */

.topbar_tooltip {
	position: absolute;
	left: -34px;
	top: 62px;

	width: 132px;
	height: 26px;

	padding-top: 7px;

	color: #ffffff;
	background-color: rgba(5, 8, 10, 230);

	border-width: 1px;
	border-color: rgba(232, 120, 50, 220);

	font-size: 9px;
	font-weight: bold;
	line-height: 10px;
	letter-spacing: 1px;
	text-align: center;
	white-space: nowrap;

	opacity: 0.00;
	z-index: 100;
	pointer-events: none;
}

.topbar_action_button.action_exit .topbar_tooltip {
	left: -48px;
	width: 100px;
}

.topbar_action_button:hover .topbar_tooltip {
	opacity: 1.00;
}

/* VALUES KEPT FOR C++ COMPATIBILITY */

.topbar_runtime_values {
	display: none;
}
