/* ============================================================
   TOP BAR - MAINMENU.XAML REDESIGN FOR RMLUI
   v3: button images are real <img> layers, text is above them.
   ============================================================ */

.topbar_body {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 78px;

	margin: 0px;
	padding: 0px;

	overflow: visible;
	background-color: rgba(0, 0, 0, 0);
}

.topbar_root {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 78px;

	overflow: visible;
	background-color: rgba(0, 0, 0, 0);
}

.topbar_background {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 1920px;
	height: 78px;

	opacity: 1.00;
	z-index: 0;
	pointer-events: none;
}

/* MONEY */

.topbar_money {
	position: absolute;
	left: 56px;
	top: 0px;

	width: 349px;
	height: 78px;

	overflow: visible;
	z-index: 5;
}

.topbar_money_item {
	position: absolute;
	top: 0px;

	width: 164px;
	height: 78px;

	overflow: visible;
}

.topbar_money_item.money_zc {
	left: 0px;
}

.topbar_money_item.money_zd {
	left: 185px;
}

.topbar_money_icon {
	position: absolute;
	left: 0px;
	top: 7px;

	width: 64px;
	height: 64px;

	z-index: 1;
	pointer-events: none;
}

.topbar_money_add {
	position: absolute;
	left: 45px;
	top: 32px;

	width: 14px;
	height: 14px;

	margin: 0px;
	padding: 0px;

	background-color: rgba(0, 0, 0, 0);
	decorator: none;

	border-width: 0px;
	border-color: rgba(0, 0, 0, 0);

	color: rgba(0, 0, 0, 0);
	font-size: 0px;
	line-height: 0px;
	text-shadow: none;
	filter: none;

	overflow: visible;
	z-index: 3;
}

.topbar_money_add:hover,
.topbar_money_add:active,
.topbar_money_add:focus {
	background-color: rgba(0, 0, 0, 0);
	decorator: none;
	border-width: 0px;
	border-color: rgba(0, 0, 0, 0);
	color: rgba(0, 0, 0, 0);
	text-shadow: none;
	filter: none;
}

.topbar_money_add_icon {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 14px;
	height: 14px;

	z-index: 4;
	pointer-events: none;
}

.topbar_money_add:hover .topbar_money_add_icon {
	opacity: 0.82;
}

.topbar_money_value {
	position: absolute;
	left: 64px;
	top: 23px;

	width: 100px;
	height: 32px;

	padding-top: 5px;
	padding-bottom: 5px;
	padding-left: 0px;
	padding-right: 0px;

	color: #e1e9ed;

	font-size: 18px;
	font-weight: normal;
	line-height: 22px;
	text-align: center;

	white-space: nowrap;
	overflow: hidden;

	z-index: 2;
	pointer-events: none;
}

/* ============================================================
   TOPBAR TABS
   each button has own normal / hover / active image
   ============================================================ */

.topbar_tabs {
	position: absolute;
	left: 469px;
	top: 0px;

	width: 1000px;
	height: 78px;

	overflow: visible;
}

.topbar_tab {
	position: absolute;
	top: 0px;

	width: 200px;
	height: 78px;

	margin: 0px;
	padding: 0px;

	background-color: rgba(0, 0, 0, 0);
	decorator: none;

	border-width: 0px;
	border-color: rgba(0, 0, 0, 0);

	color: #d8dce1;

	font-size: 0px;
	line-height: 0px;

	text-shadow: none;
	filter: none;

	overflow: visible;
}

.topbar_tab:hover,
.topbar_tab:active,
.topbar_tab:focus {
	background-color: rgba(0, 0, 0, 0);
	decorator: none;

	border-width: 0px;
	border-color: rgba(0, 0, 0, 0);

	color: #ffffff;

	text-shadow: none;
	filter: none;
}

.topbar_tab_1 {
	left: 0px;
}

.topbar_tab_2 {
	left: 200px;
}

.topbar_tab_3 {
	left: 400px;
}

.topbar_tab_4 {
	left: 600px;
}

.topbar_tab_5 {
	left: 800px;
}

.topbar_tab_img {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 200px;
	height: 78px;

	pointer-events: none;
}

.topbar_tab_img.normal {
	opacity: 1.00;
	z-index: 1;
}

.topbar_tab_img.hover {
	opacity: 0.00;
	z-index: 2;
}

.topbar_tab_img.active_img {
	opacity: 0.00;
	z-index: 3;
}

/* hover state */
.topbar_tab:hover .topbar_tab_img.normal {
	opacity: 0.00;
}

.topbar_tab:hover .topbar_tab_img.hover {
	opacity: 1.00;
}

.topbar_tab:hover .topbar_tab_img.active_img {
	opacity: 0.00;
}

/* mouse pressed state */
.topbar_tab:active .topbar_tab_img.normal {
	opacity: 0.00;
}

.topbar_tab:active .topbar_tab_img.hover {
	opacity: 0.00;
}

.topbar_tab:active .topbar_tab_img.active_img {
	opacity: 1.00;
}

/* selected screen state */
.topbar_tab.active .topbar_tab_img.normal {
	opacity: 0.00;
}

.topbar_tab.active .topbar_tab_img.hover {
	opacity: 0.00;
}

.topbar_tab.active .topbar_tab_img.active_img {
	opacity: 1.00;
}

.topbar_tab.active:hover .topbar_tab_img.normal {
	opacity: 0.00;
}

.topbar_tab.active:hover .topbar_tab_img.hover {
	opacity: 0.00;
}

.topbar_tab.active:hover .topbar_tab_img.active_img {
	opacity: 1.00;
}

.topbar_tab_label {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 200px;
	height: 78px;

	color: inherit;

	font-size: 24px;
	font-weight: normal;
	line-height: 78px;
	text-align: center;

	letter-spacing: 4px;

	text-shadow: 0px 1px 2px rgba(0, 0, 0, 220);

	z-index: 10;

	pointer-events: none;
}

.topbar_tab.active .topbar_tab_label {
	color: #ffffff;
}

.topbar_tab:hover .topbar_tab_label {
	color: #ffffff;
}

/* ============================================================
   ACTION ICONS - XAML MATCH
   Button: 64x78
   Icon:   32x32
   ============================================================ */

.topbar_actions {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 1920px;
	height: 78px;

	overflow: visible;
}

.topbar_action_button {
	position: absolute;
	top: 0px;

	width: 64px;
	height: 78px;

	margin: 0px;
	padding: 0px;

	background-color: rgba(0, 0, 0, 0);
	decorator: none;

	border-width: 0px;
	border-color: rgba(0, 0, 0, 0);

	color: rgba(0, 0, 0, 0);
	font-size: 0px;
	line-height: 0px;

	text-shadow: none;
	filter: none;

	overflow: visible;
}

.topbar_action_button:hover,
.topbar_action_button:active,
.topbar_action_button:focus {
	background-color: rgba(0, 0, 0, 0);
	decorator: none;

	border-width: 0px;
	border-color: rgba(0, 0, 0, 0);

	color: rgba(0, 0, 0, 0);
	text-shadow: none;
	filter: none;
}

.action_awards {
	left: 1594px;
}

.action_rating {
	left: 1658px;
}

.action_options {
	left: 1722px;
}

.action_exit {
	left: 1786px;
}

/* Image Width="32" Height="32", centered in 64x78 */
.topbar_action_icon {
	position: absolute;
	left: 16px;
	top: 23px;

	width: 32px;
	height: 32px;

	pointer-events: none;
}

/* TOOLTIP */

.topbar_tooltip {
	position: absolute;
	left: -34px;
	top: 78px;

	width: 132px;
	height: 26px;

	padding-top: 7px;

	color: #ffffff;
	background-color: rgba(5, 8, 10, 230);

	border-width: 1px;
	border-color: rgba(232, 120, 50, 220);

	font-size: 9px;
	font-weight: bold;
	line-height: 10px;
	letter-spacing: 1px;
	text-align: center;
	white-space: nowrap;

	opacity: 0.00;

	z-index: 100;
	pointer-events: none;
}

.topbar_action_button:hover .topbar_tooltip {
	opacity: 1.00;
}

/* VALUES KEPT FOR C++ COMPATIBILITY */

.topbar_runtime_values {
	display: none;
}
