/* ============================================================
   TOP BAR - NOESIS CONVERTED FOR RMLUI
   ============================================================ */

.topbar_body {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 78px;

	margin: 0px;
	padding: 0px;

	overflow: visible;

	background-color: rgba(0, 0, 0, 0);
}

.topbar_root {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 78px;

	overflow: visible;

	background-color: rgba(0, 0, 0, 0);
}

.topbar_background {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 1920px;
	height: 78px;

	opacity: 0.72;

	pointer-events: none;
}


/* LEVEL / CHARACTER */

.topbar_level_block {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 240px;
	height: 78px;

	overflow: visible;
}

.topbar_level_badge {
	position: absolute;
	left: 12px;
	top: 9px;

	width: 67px;
	height: 62px;

	pointer-events: none;
}

.topbar_level_value {
	position: absolute;
	left: 20px;
	top: 14px;

	width: 50px;
	height: 50px;

	padding-top: 10px;
	padding-bottom: 10px;

	color: #ffffff;

	font-size: 24px;
	font-weight: normal;
	line-height: 30px;
	text-align: center;

	pointer-events: none;
}

.topbar_character_name {
	position: absolute;
	left: 94px;
	top: 14px;

	width: 125px;
	height: 50px;

	padding-top: 10px;

	overflow: hidden;

	color: #ffffff;

	font-size: 24px;
	font-weight: normal;
	line-height: 30px;
	text-align: center;

	white-space: nowrap;

	pointer-events: none;
}


/* MONEY */

.topbar_money {
	position: absolute;
	left: 240px;
	top: 21px;

	width: 410px;
	height: 36px;

	overflow: visible;
}

.topbar_money_item {
	position: absolute;
	top: 0px;

	width: 111px;
	height: 36px;

	overflow: visible;
}

.topbar_money_item.money_gc {
	left: 0px;
}

.topbar_money_item.money_gd {
	left: 120px;
}

.topbar_money_item.money_zlt {
	left: 240px;
}

.topbar_money_icon {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 36px;
	height: 36px;

	pointer-events: none;
}

.topbar_money_value_wrap {
	position: absolute;
	left: 36px;
	top: 8px;

	width: 75px;
	height: 20px;

	overflow: hidden;
}

.topbar_money_value_bg {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 75px;
	height: 20px;

	pointer-events: none;
}

.topbar_money_value {
	position: absolute;
	left: 10px;
	top: 0px;

	width: 65px;
	height: 20px;

	padding-left: 5px;
	padding-right: 5px;

	color: #ffffff;

	font-size: 14px;
	font-weight: normal;
	line-height: 20px;
	text-align: right;

	white-space: nowrap;

	pointer-events: none;
}


/* TABS */

.topbar_tabs {
	position: absolute;
	left: 650px;
	top: 18px;

	width: 1020px;
	height: 43px;

	overflow: visible;
}

.topbar_tab {
	position: absolute;
	top: 0px;

	width: 150px;
	height: 43px;

	margin: 0px;
	padding: 0px;

	color: #e1e9ed;

	background-color: rgba(0, 0, 0, 0);

	border-width: 0px;

	font-size: 0px;
}

#nav_home {
	left: 0px;
}

#nav_skills {
	left: 170px;
}

#nav_equipment {
	left: 340px;
}

#nav_shop {
	left: 510px;
}

#nav_clan {
	left: 680px;
}

#nav_friends {
	left: 850px;
}

.topbar_tab_bg {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 150px;
	height: 43px;

	pointer-events: none;
}

.topbar_tab_bg.normal {
	opacity: 1.00;
}

.topbar_tab_bg.hover {
	opacity: 0.00;
}

.topbar_tab_bg.active_img {
	opacity: 0.00;
}

.topbar_tab:hover .topbar_tab_bg.normal {
	opacity: 0.00;
}

.topbar_tab:hover .topbar_tab_bg.hover {
	opacity: 1.00;
}

.topbar_tab:hover .topbar_tab_bg.active_img {
	opacity: 0.00;
}

.topbar_tab.active .topbar_tab_bg.normal {
	opacity: 0.00;
}

.topbar_tab.active .topbar_tab_bg.hover {
	opacity: 0.00;
}

.topbar_tab.active .topbar_tab_bg.active_img {
	opacity: 1.00;
}

.topbar_tab.active:hover .topbar_tab_bg.normal {
	opacity: 0.00;
}

.topbar_tab.active:hover .topbar_tab_bg.hover {
	opacity: 0.00;
}

.topbar_tab.active:hover .topbar_tab_bg.active_img {
	opacity: 1.00;
}

.topbar_tab.active {
	color: #ffffff;
}

.topbar_tab_label {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 150px;
	height: 43px;

	color: inherit;

	font-size: 24px;
	font-weight: normal;
	line-height: 43px;
	text-align: center;

	pointer-events: none;
}


/* ACTIONS */

.topbar_actions {
	position: absolute;
	left: 1708px;
	top: 10px;

	width: 192px;
	height: 58px;

	overflow: visible;
}

.topbar_action_button {
	position: absolute;
	top: 0px;

	width: 48px;
	height: 58px;

	margin: 0px;
	padding: 0px;

	background-color: rgba(0, 0, 0, 0);
	decorator: none;

	border-width: 0px;
	border-color: rgba(0, 0, 0, 0);

	color: rgba(0, 0, 0, 0);
	font-size: 0px;
	line-height: 0px;
	text-shadow: none;

	filter: none;

	overflow: visible;
}

.topbar_action_button:hover,
.topbar_action_button:active,
.topbar_action_button:focus {
	background-color: rgba(0, 0, 0, 0);
	decorator: none;

	border-width: 0px;
	border-color: rgba(0, 0, 0, 0);

	color: rgba(0, 0, 0, 0);
	text-shadow: none;

	filter: none;
}

.topbar_action_button:nth-child(1) {
	left: 0px;
}

.topbar_action_button:nth-child(2) {
	left: 48px;
}

.topbar_action_button:nth-child(3) {
	left: 96px;
}

.topbar_action_button:nth-child(4) {
	left: 144px;
}

.topbar_action_image {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 48px;
	height: 58px;
	
	background-color: rgba(0, 0, 0, 0);

	pointer-events: none;
}

.topbar_action_image.normal {
	opacity: 1.00;
}

.topbar_action_image.hover {
	opacity: 0.00;
}

.topbar_action_button:hover .topbar_action_image.normal {
	opacity: 0.00;
}

.topbar_action_button:hover .topbar_action_image.hover {
	opacity: 1.00;
}

/* TOOLTIP */

.topbar_tooltip {
	position: absolute;
	left: -42px;
	top: 62px;

	width: 132px;
	height: 26px;

	padding-top: 7px;

	color: #ffffff;
	background-color: rgba(5, 8, 10, 230);

	border-width: 1px;
	border-color: rgba(232, 120, 50, 220);

	font-size: 9px;
	font-weight: bold;
	line-height: 10px;
	letter-spacing: 1px;
	text-align: center;
	white-space: nowrap;

	opacity: 0.00;

	z-index: 100;
	pointer-events: none;
}

.topbar_action_button:nth-child(4) .topbar_tooltip {
	left: -72px;
	width: 100px;
}

.topbar_action_button:hover .topbar_tooltip {
	opacity: 1.00;
}