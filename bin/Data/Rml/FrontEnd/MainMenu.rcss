/* ============================================================
   MAIN MENU - Home.xaml -> RmlUI
   Character preview is preserved through rml://character-preview.
   ============================================================ */

.main_menu_body {
	background-color: #020405;
}

/* BACKGROUND */

.home_background_stage {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	z-index: 0;

	overflow: hidden;
	background-color: #030506;
}

.home_background_image {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	z-index: 1;
}

.home_background_shadow {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	z-index: 2;

	pointer-events: none;
}

/* CHARACTER PREVIEW */

.main_menu_scene {
	position: absolute;
	left: 0px;
	right: 0px;
	bottom: 0px;

	width: 100%;
	height: 100%;

	z-index: 5;

	overflow: hidden;
	background-color: transparent;
}

.main_menu_scene_texture {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	z-index: 1;

	pointer-events: none;
}

.main_menu_scene_shade {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	z-index: 2;

	background-color: rgba(0, 0, 0, 0);
	pointer-events: none;
}

.main_menu_scene_vignette {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	z-index: 3;

	background-color: rgba(0, 0, 0, 35);
	pointer-events: none;
}

/* XAML ROOT AREA */

.home_xaml_root {
	position: absolute;
	left: 0px;
	top: 78px;

	width: 1920px;
	height: 1002px;

	z-index: 30;

	overflow: visible;
	pointer-events: none;
}

/* LEVEL PANEL */

.home_level_panel {
	position: absolute;
	left: 50px;
	top: 75px;

	width: 537px;
	height: 67px;

	z-index: 35;

	overflow: hidden;
	pointer-events: auto;
}

.home_level_bg {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 537px;
	height: 67px;

	z-index: 1;

	pointer-events: none;
}

.home_level_fill_image {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 0px;
	height: 67px;

	z-index: 2;

	pointer-events: none;
}

.home_level_hover {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 537px;
	height: 67px;

	z-index: 20;

	opacity: 0.00;

	pointer-events: none;
}

.home_level_panel:hover .home_level_hover {
	opacity: 1.00;
}

.home_level_number {
	position: absolute;
	left: 20px;
	top: 9px;

	width: 50px;
	height: 50px;

	padding-top: 8px;

	z-index: 5;

	color: #e1e9ed;

	font-family: "Play";
	font-size: 24px;
	font-weight: normal;
	line-height: 30px;
	text-align: center;

	text-shadow: 0px 1px 2px rgba(0, 0, 0, 230);
}

.home_level_rank {
	position: absolute;
	left: 81px;
	top: 14px;

	width: 130px;
	height: 20px;

	z-index: 5;

	color: #e1e9ed;

	font-family: "Play";
	font-size: 14px;
	font-weight: normal;
	line-height: 16px;
	text-align: left;

	letter-spacing: 2px;
	text-shadow: 0px 1px 2px rgba(0, 0, 0, 230);
}

.home_level_xp {
	position: absolute;
	left: 81px;
	top: 34px;

	width: 180px;
	height: 20px;

	z-index: 5;

	color: #aeb8bd;

	font-family: "Play";
	font-size: 12px;
	font-weight: normal;
	line-height: 15px;
	text-align: left;

	text-shadow: 0px 1px 2px rgba(0, 0, 0, 230);
}

.home_character_name {
	position: absolute;
	left: 256px;
	top: 9px;

	width: 264px;
	height: 50px;

	padding-top: 8px;

	z-index: 5;

	color: #e1e9ed;

	font-family: "Play";
	font-size: 24px;
	font-weight: normal;
	line-height: 30px;
	text-align: center;

	white-space: nowrap;
	overflow: hidden;

	text-shadow: 0px 1px 2px rgba(0, 0, 0, 230);
}

/* PREMIUM PANEL */

.home_premium_panel {
	position: absolute;
	left: 1360px;
	top: 75px;

	width: 510px;
	height: 66px;

	z-index: 35;

	overflow: visible;
	pointer-events: auto;
}

.home_premium_plate {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 510px;
	height: 66px;

	pointer-events: none;
}

.home_premium_plate.normal {
	z-index: 1;
	opacity: 1.00;
}

.home_premium_plate.active {
	z-index: 2;
	opacity: 0.00;
}

.home_premium_text {
	position: absolute;
	left: 105px;
	top: 9px;

	width: 300px;
	height: 50px;

	padding-top: 8px;

	z-index: 10;

	color: #e1e9ed;

	font-family: "Play";
	font-size: 24px;
	font-weight: normal;
	line-height: 30px;
	text-align: center;

	letter-spacing: 2px;
	text-shadow: 0px 1px 2px rgba(0, 0, 0, 230);

	pointer-events: none;
}

.home_premium_badge {
	position: absolute;
	left: 420px;
	top: 11px;

	width: 54px;
	height: 44px;

	pointer-events: none;
}

.home_premium_badge.normal {
	z-index: 4;
	opacity: 1.00;
}

.home_premium_badge.active {
	z-index: 5;
	opacity: 0.00;
}

/* hover = active textures */

.home_premium_panel:hover .home_premium_plate.normal,
.home_premium_panel.premium_owned .home_premium_plate.normal {
	opacity: 0.00;
}

.home_premium_panel:hover .home_premium_plate.active,
.home_premium_panel.premium_owned .home_premium_plate.active {
	opacity: 1.00;
}

.home_premium_panel:hover .home_premium_badge.normal,
.home_premium_panel.premium_owned .home_premium_badge.normal {
	opacity: 0.00;
}

.home_premium_panel:hover .home_premium_badge.active,
.home_premium_panel.premium_owned .home_premium_badge.active {
	opacity: 1.00;
}

.home_premium_panel:hover .home_premium_text,
.home_premium_panel.premium_owned .home_premium_text {
	color: #ffffff;
}

/* PLAY GAME */

.home_play_button {
	position: absolute;
	left: 50px;
	top: 783px;

	width: 533px;
	height: 63px;

	z-index: 60;

	margin: 0px;
	padding: 0px;

	background-color: rgba(0, 0, 0, 0);
	decorator: none;

	border-width: 0px;
	border-color: rgba(0, 0, 0, 0);

	color: #ffffff;

	font-family: "Play";
	font-size: 0px;
	line-height: 0px;

	overflow: visible;

	pointer-events: auto;
}

.home_play_button .normal {
	opacity: 1.00;
}

.home_play_button .active {
	opacity: 0.00;
}

.home_play_button:hover .normal,
.home_play_button:active .normal,
.home_play_button.active .normal {
	opacity: 0.00;
}

.home_play_button:hover .active,
.home_play_button:active .active,
.home_play_button.active .active {
	opacity: 1.00;
}

.home_play_options_plate.normal {
	z-index: 1;
}

.home_play_options_plate.active {
	z-index: 2;
}

.home_play_plate.normal {
	z-index: 1;
}

.home_play_plate.active {
	z-index: 2;
}

.home_play_icon.normal {
	z-index: 3;
}

.home_play_icon.active {
	z-index: 4;
}

.home_play_options_plate {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 66px;
	height: 63px;

	z-index: 1;

	pointer-events: none;
}

.home_play_plate {
	position: absolute;
	left: 66px;
	top: 0px;

	width: 467px;
	height: 63px;

	z-index: 1;

	pointer-events: none;
}

.home_play_icon {
	position: absolute;
	left: 14px;
	top: 13px;

	width: 38px;
	height: 38px;

	z-index: 3;

	pointer-events: none;
}

.home_play_text {
	position: absolute;
	left: 168px;
	top: 7px;

	width: 264px;
	height: 50px;

	padding-top: 8px;

	z-index: 4;

	color: #ffffff;

	font-family: "Play";
	font-size: 24px;
	font-weight: normal;
	line-height: 30px;
	text-align: center;

	text-shadow: 0px 1px 2px rgba(0, 0, 0, 235);

	pointer-events: none;
}

/* PLAY MODE MODAL */

.play_mode_overlay {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	z-index: 200;

	display: none;
}

.play_mode_overlay.visible {
	display: block;
}

.play_mode_backdrop {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	background-color: rgba(0, 0, 0, 145);
}

.play_mode_panel {
	position: absolute;
	left: 480px;
	top: 190px;

	width: 960px;
	height: 500px;

	padding: 24px;

	background-color: rgba(8, 12, 15, 245);

	border-width: 1px;
	border-color: rgba(88, 100, 106, 200);

	z-index: 205;
}

.play_mode_header {
	width: 100%;
	height: 64px;

	display: flex;
	justify-content: space-between;
	align-items: center;

	border-bottom-width: 1px;
	border-bottom-color: rgba(88, 100, 106, 160);
}

.play_mode_kicker {
	color: #d96d2a;

	font-family: "Play";
	font-size: 10px;
	font-weight: bold;
	line-height: 12px;

	letter-spacing: 3px;
}

.play_mode_title {
	margin-top: 5px;

	color: #ffffff;

	font-family: "Play";
	font-size: 24px;
	font-weight: normal;
	line-height: 28px;

	letter-spacing: 3px;
}

.play_mode_close_button {
	width: 42px;
	height: 42px;

	padding-top: 8px;

	color: #ffffff;
	background-color: rgba(22, 30, 35, 245);

	border-width: 1px;
	border-color: rgba(90, 105, 112, 200);

	font-family: "Play";
	font-size: 18px;
	text-align: center;
}

.play_mode_close_button:hover {
	background-color: rgba(110, 40, 34, 245);
	border-color: #d96d2a;
}

.play_mode_description {
	width: 100%;
	height: 42px;

	margin-top: 18px;

	color: #aeb8bd;

	font-family: "Play";
	font-size: 13px;
	line-height: 18px;
}

.play_mode_list {
	width: 100%;
	height: 300px;

	margin-top: 22px;

	display: flex;
	flex-direction: row;
}

.play_mode_card {
	width: 210px;
	height: 285px;

	margin-right: 18px;
	padding: 16px;

	background-color: rgba(10, 15, 18, 235);

	border-width: 1px;
	border-color: rgba(72, 86, 94, 190);

	color: #dfe7ea;

	text-align: left;
}

.play_mode_card:hover {
	background-color: rgba(28, 38, 44, 245);
	border-color: #d96d2a;
}

.play_mode_card.available {
	border-color: rgba(210, 100, 55, 220);
}

.play_mode_card.locked {
	opacity: 0.58;
}

.play_mode_card_status {
	width: 100%;
	height: 18px;

	color: #d96d2a;

	font-family: "Play";
	font-size: 9px;
	font-weight: bold;
	line-height: 12px;

	letter-spacing: 2px;
}

.play_mode_card_title {
	width: 100%;
	height: 32px;

	margin-top: 18px;

	color: #ffffff;

	font-family: "Play";
	font-size: 18px;
	font-weight: normal;
	line-height: 24px;

	letter-spacing: 2px;
}

.play_mode_card_text {
	width: 100%;
	height: 120px;

	margin-top: 14px;

	color: #aeb8bd;

	font-family: "Play";
	font-size: 11px;
	line-height: 16px;
}

.play_mode_card_footer {
	width: 100%;
	height: 26px;

	margin-top: 22px;
	padding-top: 6px;

	color: #ffffff;
	background-color: rgba(24, 32, 37, 240);

	border-width: 1px;
	border-color: rgba(82, 96, 104, 190);

	font-family: "Play";
	font-size: 10px;
	font-weight: bold;
	line-height: 12px;

	text-align: center;
	letter-spacing: 1px;
}

/* HIDDEN COMPATIBILITY BLOCK */

.mainmenu_runtime_values {
	display: none;
}