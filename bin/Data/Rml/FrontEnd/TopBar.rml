<rml>
<head>
	<title>Last To Survive TopBar</title>
	<link type="text/rcss" href="FrontEnd.rcss"/>
	<link type="text/rcss" href="TopBar.rcss"/>
</head>

<body class="topbar_body">
	<div class="topbar_root">
		<img class="topbar_background" src="../Assets/MainMenu/top_panel/top_panel_bg.png"/>

		<div class="topbar_money">
			<div class="topbar_money_item money_zc">
				<img class="topbar_money_icon" src="../Assets/MainMenu/btn_money/btn_money_zlt.png"/>
				<button id="btn_buy_gc" class="topbar_money_add">
					<img class="topbar_money_add_icon" src="../Assets/MainMenu/top_panel/Btn/button_plus.png"/>
				</button>
				<div id="balance_gc" class="topbar_money_value">999999999</div>
			</div>

			<div class="topbar_money_item money_zd">
				<img class="topbar_money_icon" src="../Assets/MainMenu/btn_money/btn_money_zd.png"/>
				<button id="btn_buy_gd" class="topbar_money_add">
					<img class="topbar_money_add_icon" src="../Assets/MainMenu/top_panel/Btn/button_plus.png"/>
				</button>
				<div id="balance_gd" class="topbar_money_value">999999999</div>
			</div>
		</div>

		<div class="topbar_tabs">
			<button id="nav_home" class="topbar_tab active tab_home">
				<img class="topbar_tab_bg" src="../Assets/MainMenu/top_panel/Btn/Button_1.png"/>
				<div class="topbar_tab_label">HOME</div>
			</button>

			<button id="nav_skills" class="topbar_tab tab_skills">
				<img class="topbar_tab_bg" src="../Assets/MainMenu/top_panel/Btn/Button_2.png"/>
				<div class="topbar_tab_label">SKILLS</div>
			</button>

			<button id="nav_equipment" class="topbar_tab tab_equipment">
				<img class="topbar_tab_bg" src="../Assets/MainMenu/top_panel/Btn/Button_3.png"/>
				<div class="topbar_tab_label">EQUIPMENT</div>
			</button>

			<button id="nav_shop" class="topbar_tab tab_shop">
				<img class="topbar_tab_bg" src="../Assets/MainMenu/top_panel/Btn/Button_4.png"/>
				<div class="topbar_tab_label">SHOP</div>
			</button>

			<button id="nav_clan" class="topbar_tab tab_clan">
				<img class="topbar_tab_bg" src="../Assets/MainMenu/top_panel/Btn/Button_5.png"/>
				<div class="topbar_tab_label">CLAN</div>
			</button>
		</div>

		<div class="topbar_actions">
			<button id="nav_awards" class="topbar_action_button action_awards">
				<img class="topbar_action_icon" src="../Assets/MainMenu/top_panel/Btn/awards.png"/>
				<div class="topbar_tooltip">AWARDS</div>
			</button>

			<button id="btn_rewards" class="topbar_action_button action_rating">
				<img class="topbar_action_icon" src="../Assets/MainMenu/top_panel/Btn/rating.png"/>
				<div class="topbar_tooltip">RATING</div>
			</button>

			<button id="btn_settings" class="topbar_action_button action_options">
				<img class="topbar_action_icon" src="../Assets/MainMenu/top_panel/Btn/options.png"/>
				<div class="topbar_tooltip">OPTIONS</div>
			</button>

			<button id="btn_frontend_exit" class="topbar_action_button action_exit">
				<img class="topbar_action_icon" src="../Assets/MainMenu/top_panel/Btn/exit.png"/>
				<div class="topbar_tooltip">EXIT</div>
			</button>
		</div>

		<div class="topbar_runtime_values">
			<div id="balance_ltc">0</div>
			<div id="balance_zlt">0</div>
			<div id="top_level_value">0</div>
			<div id="top_survivor_name">SURVIVOR</div>
			<div id="top_survivor_role">SURVIVOR</div>
			<div id="survivor_nickname">SURVIVOR</div>
			<div id="survivor_class">SURVIVOR</div>
			<div id="survivor_state">READY</div>
		</div>
	</div>
</body>
</rml>
