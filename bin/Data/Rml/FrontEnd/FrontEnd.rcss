/* ============================================================
   LAST TO SURVIVE
   FRONTEND COMMON BASE
   Shared by Login / MainMenu / TopBar / Skills / Shop / CharacterCreate
   ============================================================ */

* {
	box-sizing: border-box;
}

div,
button,
input,
img {
	display: block;
}

body {
	margin: 0px;
	padding: 0px;
	color: #e0e6e9;
	font-family: "Noto Sans";
}

.frontend_body {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	overflow: hidden;

	background-color: #040607;
}

.runtime_hidden_value {
	display: none;
}

/* ============================================================
   SHARED BACKGROUNDS
   ============================================================ */

.background_grid {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	background-color: #080c0e;
}

.background_vignette {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	background-color: rgba(0, 0, 0, 92);
}

.login_background_light {
	position: absolute;
	left: 24%;
	top: 10%;

	width: 52%;
	height: 80%;

	background-color: rgba(111, 127, 134, 10);
}

.screen_edge {
	position: absolute;
	left: 0px;

	width: 100%;
	height: 1px;

	background-color: #5b321b;
}

.screen_edge_top {
	top: 0px;
}

.screen_edge_bottom {
	bottom: 0px;
}

.frontend_static_background {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	z-index: 0;

	overflow: hidden;

	background-color: #030506;
}

.frontend_static_background_image {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	z-index: 1;
}

.frontend_static_background_shade {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	z-index: 2;

	background-color: rgba(0, 0, 0, 117);

	pointer-events: none;
}

.main_menu_scene_vignette {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	z-index: 3;

	background-color: rgba(0, 0, 0, 41);

	pointer-events: none;
}

.skills_scene_scrim {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	z-index: 4;

	background-color: rgba(0, 0, 0, 66);

	pointer-events: none;
}

/* ============================================================
   SHARED TYPOGRAPHY
   ============================================================ */

.game_title {
	color: #f4f6f7;

	font-size: 28px;
	font-weight: bold;
	letter-spacing: 5px;
}

.game_title.small {
	font-size: 20px;
}

.game_subtitle {
	margin-top: 4px;

	color: #d96d2a;

	font-size: 9px;
	font-weight: bold;
	letter-spacing: 3px;
}

.panel_title {
	color: #ff8337;

	font-size: 11px;
	font-weight: bold;
	letter-spacing: 2px;
}

.panel_subtitle {
	margin-top: 4px;

	color: #657178;

	font-size: 9px;
	font-weight: bold;
	letter-spacing: 2px;
}

.field_label {
	width: 100%;

	margin-top: 15px;
	margin-bottom: 6px;

	color: #8c979d;

	font-size: 9px;
	font-weight: bold;
	letter-spacing: 2px;
}

.compact_label {
	margin-top: 0px;
}

.section_header {
	width: 100%;
	height: 24px;

	color: #ff8337;

	font-size: 11px;
	font-weight: bold;
	letter-spacing: 2px;
	line-height: 18px;
}

/* ============================================================
   SHARED PANELS
   ============================================================ */

.tactical_panel {
	position: relative;

	background-color: rgba(8, 13, 16, 247);

	border-width: 1px;
	border-color: #30393e;
}

.panel_top_line {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 2px;

	background-color: #e2732d;
}

.panel_header_row {
	width: 100%;
	height: 25px;

	display: flex;
	justify-content: space-between;
	align-items: center;
}

.panel_accent {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 4px;
	height: 100%;

	background-color: #f17d32;
}

/* ============================================================
   SHARED INPUTS / BUTTONS
   ============================================================ */

.frontend_input {
	width: 100%;
	height: 42px;

	padding-left: 12px;
	padding-right: 12px;

	color: #f0f2f3;
	background-color: #06090b;

	border-width: 1px;
	border-color: #354047;

	font-size: 13px;
}

.frontend_input:hover {
	border-color: #59676e;
}

.frontend_input:focus {
	color: #ffffff;
	background-color: #0b1013;
	border-color: #ff8738;
}

.frontend_input.disabled,
.frontend_input:disabled {
	color: #4d565b;
	background-color: #0a0e10;
	border-color: #20272b;
}

button {
	margin: 0px;
	padding: 0px;

	color: #e7eef1;
	background-color: #12191d;
	border-width: 1px;
	border-color: #46535a;
	border-bottom-width: 2px;
	border-bottom-color: #20292e;

	font-family: "Noto Sans";
	font-weight: bold;

	text-shadow: 0px 1px 2px rgba(0, 0, 0, 92);
}

button:hover {
	color: #ffffff;
	background-color: #1b2429;
	border-color: #76858c;
	border-bottom-color: #e07830;
}

button:active {
	background-color: #0a0f12;
	border-bottom-width: 1px;
}

button.disabled,
button:disabled {
	color: #4d565b;
	background-color: #0e1214;
	border-color: #20272b;
}

.status_text {
	width: 100%;
	min-height: 40px;

	margin-top: 18px;
	margin-bottom: 14px;

	padding: 10px 12px;

	color: #bac4c8;
	background-color: #0a0f12;

	border-left-width: 3px;
	border-left-color: #e87731;

	font-size: 11px;
	line-height: 15px;
}

.primary_button,
.secondary_button {
	width: 100%;
	height: 44px;

	margin-top: 9px;
}

.primary_button {
	color: #ffffff;
	background-color: #9d4618;
	border-color: #ff8b40;
	border-bottom-color: #61220e;
}

.primary_button:hover {
	background-color: #c45a20;
	border-color: #ffad70;
	border-bottom-color: #7d2d12;
}

.secondary_button {
	color: #c8d0d4;
	background-color: #12191d;
	border-color: #364149;
	border-bottom-color: #10171a;
}

.secondary_button:hover {
	color: #ffffff;
	background-color: #1c252a;
	border-color: #65737a;
	border-bottom-color: #df6d2d;
}

.button_code {
	width: 52px;

	color: #ff9a5a;

	font-size: 10px;
	letter-spacing: 1px;
	text-align: center;
}

.button_label {
	flex-grow: 1;

	color: inherit;

	font-size: 13px;
	letter-spacing: 1px;
	text-align: left;
}

/* ============================================================
   SHARED STATUS BAR
   ============================================================ */

.main_menu_status_bar {
	position: absolute;
	left: 0px;
	right: 0px;
	bottom: 0px;

	height: 24px;

	z-index: 60;

	padding-left: 28px;
	padding-right: 28px;

	display: flex;
	justify-content: space-between;
	align-items: center;

	background-color: rgba(4, 7, 9, 148);

	border-top-width: 1px;
	border-top-color: rgba(66, 77, 82, 158);
}

.main_menu_status_left {
	height: 24px;

	display: flex;
	align-items: center;

	flex-grow: 1;
}

.status_indicator {
	width: 9px;
	height: 9px;

	margin-right: 10px;

	background-color: #5cc56e;

	border-width: 1px;
	border-color: #88dc96;
}

.frontend_status {
	color: #a6b1b6;

	font-size: 9px;
	font-weight: bold;
	letter-spacing: 1px;
}

.frontend_footer {
	position: absolute;
	left: 28px;
	right: 28px;
	bottom: 14px;

	display: flex;
	justify-content: space-between;

	color: #465158;

	font-size: 8px;
	font-weight: bold;
	letter-spacing: 2px;
}
