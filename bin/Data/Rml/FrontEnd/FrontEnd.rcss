/* ============================================================
   LAST TO SURVIVE
   RMLUI FRONTEND
   ============================================================ */

* {
	box-sizing: border-box;
}

div,
button,
input,
img {
	display: block;
}

body {
	margin: 0px;
	padding: 0px;
	color: #d8dde0;
	font-family: "Noto Sans";
}

/* ============================================================
   ROOT
   ============================================================ */

.frontend_body {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	overflow: hidden;
	background-color: #040607;
}

.background_grid {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	background-color: #080c0e;
}

.background_vignette {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	background-color: rgba(0, 0, 0, 0.36);
}

.login_background_light {
	position: absolute;
	left: 24%;
	top: 10%;
	width: 52%;
	height: 80%;
	background-color: rgba(111, 127, 134, 0.04);
}

.screen_edge {
	position: absolute;
	left: 0px;
	width: 100%;
	height: 1px;
	background-color: #5b321b;
}

.screen_edge_top {
	top: 0px;
}

.screen_edge_bottom {
	bottom: 0px;
}

.runtime_hidden_value {
	display: none;
}

@keyframes frontend_button_breathe {
	from {
		filter: drop-shadow(#00000088 0px 2px 2px);
	}
	to {
		filter: drop-shadow(#e8793255 0px 0px 9px);
	}
}

@keyframes frontend_play_breathe {
	from {
		filter: drop-shadow(#00000099 0px 3px 4px);
	}
	to {
		filter: drop-shadow(#ff6f5788 0px 0px 14px);
	}
}

/* ============================================================
   TYPOGRAPHY
   ============================================================ */

.game_title {
	color: #f4f6f7;
	font-size: 28px;
	font-weight: bold;
	letter-spacing: 5px;
}

.game_title.small {
	font-size: 20px;
}

.game_subtitle {
	margin-top: 4px;
	color: #d96d2a;
	font-size: 9px;
	font-weight: bold;
	letter-spacing: 3px;
}

.panel_title {
	color: #ff8337;
	font-size: 10px;
	font-weight: bold;
	letter-spacing: 2px;
}

.panel_subtitle {
	margin-top: 4px;
	color: #657178;
	font-size: 8px;
	font-weight: bold;
	letter-spacing: 2px;
}

.field_label {
	width: 100%;
	margin-top: 15px;
	margin-bottom: 6px;
	color: #8c979d;
	font-size: 8px;
	font-weight: bold;
	letter-spacing: 2px;
}

.compact_label {
	margin-top: 0px;
}

/* ============================================================
   PANELS
   ============================================================ */

.tactical_panel {
	position: relative;
	background-color: rgba(8, 13, 16, 0.97);
	border-width: 1px;
	border-color: #30393e;
}

.panel_top_line {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 2px;
	background-color: #e2732d;
}

.panel_header_row {
	width: 100%;
	height: 25px;
	display: flex;
	justify-content: space-between;
	align-items: center;
}

.panel_accent {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 4px;
	height: 100%;
	background-color: #f17d32;
}

/* ============================================================
   INPUTS / SHARED BUTTONS
   ============================================================ */

.frontend_input {
	width: 100%;
	height: 42px;
	padding-left: 12px;
	padding-right: 12px;
	color: #f0f2f3;
	background-color: #06090b;
	border-width: 1px;
	border-color: #354047;
	font-size: 12px;

	/* Живые переходы */
	transition: color 0.18s, background-color 0.18s, border-color 0.18s;
}

.frontend_input:hover {
	border-color: #59676e;
}

.frontend_input:focus {
	color: #ffffff;
	background-color: #0b1013;
	border-color: #ff8738;
}

.frontend_input.disabled,
.frontend_input:disabled {
	color: #4d565b;
	background-color: #0a0e10;
	border-color: #20272b;
}

button {
	margin: 0px;
	padding: 0px;
	color: #e7eef1;
	background-color: #12191d;
	decorator: linear-gradient(180deg, #2a353a, #12191d 55%, #070b0d) border-box;
	border-width: 1px;
	border-color: #46535a;
	border-bottom-width: 2px;
	border-bottom-color: #20292e;
	font-family: "Noto Sans";
	font-weight: bold;
	text-shadow: 0px 1px 2px rgba(0, 0, 0, 0.80);
	filter: drop-shadow(#00000088 0px 2px 2px);

	/* Живые переходы */
	transition: color 0.16s, background-color 0.16s, border-color 0.16s, border-bottom-color 0.16s, text-shadow 0.16s, filter 0.16s;
}

button:hover {
	color: #ffffff;
	background-color: #1b2429;
	decorator: linear-gradient(180deg, #3a474e, #1a2429 55%, #0b1013) border-box;
	border-color: #76858c;
	border-bottom-color: #e07830;
	text-shadow: 0px 0px 8px rgba(255, 166, 88, 0.42);
	filter: drop-shadow(#e8793255 0px 0px 8px);
}

button:active {
	background-color: #0a0f12;
	decorator: linear-gradient(180deg, #111719, #0a0f12 60%, #06090a) border-box;
	border-bottom-width: 1px;
	filter: drop-shadow(#00000077 0px 1px 1px);
}

button.disabled,
button:disabled {
	color: #4d565b;
	background-color: #0e1214;
	border-color: #20272b;
}

.status_text {
	width: 100%;
	min-height: 40px;
	margin-top: 18px;
	margin-bottom: 14px;
	padding: 10px 12px;
	color: #aeb7bc;
	background-color: #0a0f12;
	border-left-width: 3px;
	border-left-color: #e87731;
	font-size: 10px;
}

.primary_button,
.secondary_button {
	width: 100%;
	height: 44px;
	margin-top: 9px;
}

.primary_button {
	color: #ffffff;
	background-color: #9d4618;
	decorator: linear-gradient(180deg, #ff9d55, #b94f1e 42%, #6d2711) border-box;
	border-color: #ff8b40;
	border-bottom-color: #61220e;
	box-shadow: #00000088 0px 4px 8px 0px;

	/* Живые переходы */
	transition: color 0.16s, background-color 0.16s, border-color 0.16s, border-bottom-color 0.16s, text-shadow 0.16s, filter 0.16s;
}

.primary_button:hover {
	background-color: #c45a20;
	decorator: linear-gradient(180deg, #ffb46f, #d76525 45%, #863113) border-box;
	border-color: #ffad70;
	border-bottom-color: #7d2d12;
	text-shadow: 0px 0px 10px rgba(255, 160, 70, 0.50);
	animation: frontend_button_breathe 0.72s linear infinite alternate;
}

.primary_button:active {
	background-color: #713113;
	decorator: linear-gradient(180deg, #8f3515, #65250f 55%, #3f1609) border-box;
	border-color: #e56f2c;
	border-bottom-color: #3b1508;
}

.secondary_button {
	color: #c8d0d4;
	background-color: #12191d;
	decorator: linear-gradient(180deg, #2d383e, #151d22 52%, #0b1013) border-box;
	border-color: #364149;
	border-bottom-color: #10171a;

	/* Живые переходы */
	transition: color 0.16s, background-color 0.16s, border-color 0.16s, border-bottom-color 0.16s, text-shadow 0.16s, filter 0.16s;
}

.secondary_button:hover {
	color: #ffffff;
	background-color: #1c252a;
	decorator: linear-gradient(180deg, #3b474e, #202b30 52%, #101619) border-box;
	border-color: #65737a;
	border-bottom-color: #df6d2d;
}

.button_code {
	width: 52px;
	color: #ff9a5a;
	font-size: 10px;
	letter-spacing: 1px;
	text-align: center;
}

.button_label {
	flex-grow: 1;
	color: inherit;
	font-size: 12px;
	letter-spacing: 1px;
	text-align: left;
}

/* ============================================================
   LOGIN
   ============================================================ */

.login_topbar {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 86px;
	padding-left: 32px;
	padding-right: 32px;
	display: flex;
	justify-content: space-between;
	align-items: center;
	background-color: rgba(6, 9, 11, 0.98);
	border-bottom-width: 1px;
	border-bottom-color: #30393e;
}

.login_brand {
	height: 58px;
	display: flex;
	align-items: center;
}

.login_brand_mark {
	width: 58px;
	height: 52px;
	margin-right: 15px;
	padding-top: 15px;
	color: #ff8b40;
	background-color: #10171b;
	border-width: 1px;
	border-color: #d96d2a;
	font-size: 13px;
	font-weight: bold;
	letter-spacing: 2px;
	text-align: center;
}

.login_brand_text {
	height: 52px;
	padding-top: 3px;
}

.login_system_readout {
	min-width: 250px;
	padding: 9px 12px;
	background-color: #0b1013;
	border-left-width: 2px;
	border-left-color: #d96d2a;
	text-align: right;
}

.system_label {
	color: #68747a;
	font-size: 8px;
	font-weight: bold;
	letter-spacing: 2px;
}

.system_value {
	margin-top: 4px;
	color: #f0f2f3;
	font-size: 10px;
	font-weight: bold;
	letter-spacing: 1px;
}

.login_layout {
	position: absolute;
	left: 0px;
	top: 86px;
	width: 100%;
	bottom: 0px;
	display: flex;
	justify-content: center;
	align-items: center;
}

.login_panel {
	width: 470px;
	padding: 32px 34px 30px 38px;
}

.login_panel_meta {
	width: 100%;
	height: 18px;
	display: flex;
	justify-content: space-between;
	align-items: center;
}

.login_panel_code,
.login_panel_state {
	color: #59656b;
	font-size: 8px;
	font-weight: bold;
	letter-spacing: 2px;
}

.login_panel_state {
	color: #73c785;
}

.panel_caption {
	width: 100%;
	margin-top: 14px;
	color: #ffffff;
	font-size: 22px;
	font-weight: bold;
	letter-spacing: 3px;
}

.panel_description {
	width: 100%;
	margin-top: 8px;
	margin-bottom: 24px;
	color: #707c82;
	font-size: 10px;
	line-height: 16px;
}

.login_action {
	display: flex;
	align-items: center;
	padding-right: 12px;
}

.frontend_footer {
	position: absolute;
	left: 28px;
	right: 28px;
	bottom: 14px;
	display: flex;
	justify-content: space-between;
	color: #465158;
	font-size: 8px;
	font-weight: bold;
	letter-spacing: 2px;
}


/* ============================================================
   MAIN MENU - SURVARIUM STYLE
   Full-screen character scene with floating HUD elements.
   ============================================================ */

.main_menu_body {
	background-color: #020405;
}

.main_menu_scene {
	position: absolute;

	left: 0px;
	top: 0px;
	right: 0px;
	bottom: 0px;

	width: 100%;
	height: 100%;

	z-index: 2;

	overflow: hidden;
	background-color: transparent;
}

.main_menu_scene_texture {
	position: absolute;

	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	z-index: 1;
}

.main_menu_scene_shade {
	position: absolute;

	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	z-index: 2;

	background-color: rgba(0, 0, 0, 0.00);
	pointer-events: none;
}

.main_menu_scene_vignette {
	position: absolute;

	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	z-index: 3;

	pointer-events: none;
}

.main_menu_scene_disabled {
	display: none;
}

/* ============================================================
   FLOATING HOME CARDS
   ============================================================ */

.home_overlay {
	position: absolute;
	left: 36px;
	top: 100px;
	width: 404px;
	z-index: 12;
}

.experience_card {
	width: 402px;
	height: 50px;
	padding: 0px;
	display: flex;
	align-items: center;
	color: #ffffff;
	background-color: rgba(24, 29, 33, 0.86);
	decorator: linear-gradient(180deg, #374047, #171e23 55%, #0b0f12) border-box;
	border-width: 1px;
	border-color: #465157;
	border-bottom-width: 2px;
	border-bottom-color: #182024;
	text-align: left;
	box-shadow: #00000088 0px 4px 8px 0px;

	/* Живые переходы */
	transition: background-color 0.20s, border-color 0.20s, border-bottom-color 0.20s, text-shadow 0.20s, filter 0.20s;
}

.experience_card:hover {
	background-color: rgba(33, 41, 45, 0.96);
	decorator: linear-gradient(180deg, #38454c, #202a30 52%, #101619) border-box;
	border-color: #e07830;
	border-bottom-color: #b04e24;
	text-shadow: 0px 0px 8px rgba(255, 150, 60, 0.40);
	filter: drop-shadow(#e8793240 0px 0px 8px);
}

.experience_icon {
	width: 58px;
	height: 48px;
	padding-top: 17px;
	color: #ffffff;
	background-color: #9e352f;
	decorator: linear-gradient(180deg, #d85745, #8f2f29 55%, #4b1715) border-box;
	border-right-width: 1px;
	border-right-color: #d75c4f;
	font-size: 10px;
	font-weight: bold;
	letter-spacing: 1px;
	text-align: center;
	flex-shrink: 0;
}

.experience_content {
	width: 342px;
	height: 48px;
	padding: 8px 13px 6px 13px;
}

.experience_title {
	color: #ffffff;
	font-size: 17px;
	font-weight: bold;
	letter-spacing: 1px;
}

.experience_text {
	margin-top: 2px;
	color: #df8e83;
	font-size: 8px;
	font-weight: bold;
}

.experience_progress {
	position: relative;
	width: 100%;
	height: 4px;
	margin-top: 5px;
	background-color: #172025;
	border-width: 1px;
	border-color: #3b454a;
}

.experience_progress_fill {
	width: 0%;
	height: 100%;
	background-color: #c44739;
}

.mission_card {
	position: relative;
	width: 404px;
	height: 174px;
	margin-top: 30px;
	background-color: rgba(10, 13, 15, 0.78);
	decorator: linear-gradient(90deg, #10161a, #11181c 55%, #541d19) border-box;
	border-width: 1px;
	border-color: rgba(92, 102, 108, 0.42);
	box-shadow: #00000090 0px 4px 12px 0px;
}

.mission_header {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 28px;
	padding-left: 12px;
	padding-right: 11px;
	display: flex;
	justify-content: space-between;
	align-items: center;
	background-color: rgba(8, 11, 13, 0.42);
	border-bottom-width: 0px;
}

.mission_type {
	color: #e97532;
	font-size: 7px;
	font-weight: bold;
	letter-spacing: 2px;
}

.mission_status {
	color: #6fbb7b;
	font-size: 7px;
	font-weight: bold;
	letter-spacing: 1px;
}

.mission_body {
	width: 100%;
	height: 126px;
	padding-top: 27px;
	display: flex;
	align-items: center;
}

.mission_emblem {
	width: 58px;
	height: 58px;
	margin-left: 12px;
	padding-top: 20px;
	color: #ffffff;
	background-color: #a43a32;
	border-width: 1px;
	border-color: #d75f51;
	font-size: 10px;
	font-weight: bold;
	text-align: center;
	flex-shrink: 0;
}

.mission_content {
	padding-left: 12px;
	padding-right: 12px;
	flex-grow: 1;
}

.mission_title {
	color: #ffffff;
	font-size: 20px;
	font-weight: bold;
	letter-spacing: 1px;
}

.mission_description {
	margin-top: 4px;
	color: #a4adb1;
	font-size: 10px;
}

.mission_progress_text {
	margin-top: 7px;
	color: #e57932;
	font-size: 7px;
	font-weight: bold;
	letter-spacing: 1px;
}

.mission_footer {
	width: 100%;
	height: 48px;
	padding-left: 68px;
	padding-right: 16px;
	display: flex;
	justify-content: space-between;
	align-items: center;
	color: #d8dde0;
	background-color: rgba(5, 8, 10, 0.64);
	border-top-width: 1px;
	border-top-color: #303a3f;
	font-size: 13px;
	font-weight: bold;
	letter-spacing: 1px;
}

/* ============================================================
   PREMIUM BADGE
   ============================================================ */

.premium_badge {
	position: absolute;
	right: 48px;
	top: 116px;
	width: 300px;
	height: 48px;
	z-index: 18;
	padding-top: 16px;
	color: #f0f4f6;
	background-color: rgba(6, 10, 12, 0.72);
	border-width: 1px;
	border-color: rgba(75, 89, 97, 0.60);
	font-size: 10px;
	font-weight: bold;
	letter-spacing: 2px;
	text-align: center;
	filter: none;
	text-shadow: none;
}

.premium_badge:hover {
	background-color: rgba(11, 16, 19, 0.88);
	border-color: rgba(217, 109, 42, 0.70);
	text-shadow: 0px 0px 8px rgba(217, 109, 42, 0.35);
}

/* ============================================================
   RIGHT ACTION RAIL
   ============================================================ */

.right_action_rail {
	position: absolute;
	right: 0px;
	top: 190px;
	width: 44px;
	z-index: 14;
}

.rail_button {
	position: relative;
	width: 44px;
	height: 41px;
	margin-bottom: 2px;
	color: #aeb6ba;
	background-color: rgba(12, 16, 18, 0.66);
	decorator: linear-gradient(180deg, #33393c, #15191c 55%, #0a0c0d) border-box;
	border-width: 0px;
	border-left-width: 1px;
	border-left-color: rgba(190, 196, 198, 0.18);
	border-bottom-width: 1px;
	border-bottom-color: rgba(0, 0, 0, 0.48);
	box-shadow: #00000088 0px 3px 6px 0px;

	/* Живые переходы */
	transition: color 0.18s, background-color 0.18s, border-color 0.18s, border-bottom-color 0.18s, text-shadow 0.18s, filter 0.18s;
}

.rail_button:hover {
	color: #ffffff;
	background-color: rgba(39, 47, 51, 0.96);
	decorator: linear-gradient(180deg, #39464d, #1e282d 52%, #0c1114) border-box;
	border-color: #e07830;
	border-bottom-color: #b04e24;
	text-shadow: 0px 0px 10px rgba(255, 150, 60, 0.50);
	filter: drop-shadow(#e879324c 0px 0px 8px);
}

.rail_decorative {
	color: #8e979b;
}

.rail_plus {
	color: #ffe954;
	text-shadow: 0px 0px 10px rgba(255, 230, 80, 0.60);
}

.rail_button_code {
	width: 44px;
	height: 41px;
	padding-top: 13px;
	font-size: 9px;
	font-weight: bold;
	letter-spacing: 0px;
	text-align: center;
}

.rail_plus .rail_button_code {
	padding-top: 8px;
	font-size: 26px;
	line-height: 28px;
}

.rail_button_tooltip {
	display: none;
	position: absolute;
	right: 52px;
	top: 4px;
	width: 145px;
	height: 36px;
	padding-top: 12px;
	color: #ffffff;
	background-color: rgba(8, 12, 14, 0.95);
	decorator: linear-gradient(180deg, #263237, #11181c 54%, #070b0d) border-box;
	border-width: 1px;
	border-color: #475258;
	font-size: 8px;
	font-weight: bold;
	letter-spacing: 1px;
	text-align: center;
}

.rail_button:hover .rail_button_tooltip {
	display: block;
}

/* ============================================================
   SURVIVOR IDENTITY
   ============================================================ */

.survivor_identity {
	position: absolute;
	left: 34px;
	bottom: 104px;

	width: 430px;
	height: 52px;

	z-index: 30;

	display: flex;
	align-items: center;

	background-color: rgba(6, 10, 12, 0.86);

	border-width: 1px;
	border-color: rgba(75, 89, 97, 0.74);
}

.survivor_state {
	width: 92px;
	height: 52px;

	padding-top: 18px;

	font-size: 8px;
	font-weight: bold;
	letter-spacing: 2px;
	text-align: center;
}

.survivor_state.ready {
	color: #e6f6e9;
	background-color: rgba(24, 72, 35, 0.92);
	border-width: 0px;
	border-right-width: 1px;
	border-right-color: #4a905a;
}

.survivor_state.wounded {
	color: #fff0c8;
	background-color: rgba(79, 57, 19, 0.92);
	border-width: 0px;
	border-right-width: 1px;
	border-right-color: #b17a2b;
}

.survivor_state.dead {
	color: #ffd6d6;
	background-color: rgba(79, 21, 23, 0.92);
	border-width: 0px;
	border-right-width: 1px;
	border-right-color: #a34a4f;
}

.survivor_identity_text {
	width: 336px;
	height: 52px;

	margin-left: 0px;
	padding: 9px 14px 7px 14px;

	background-color: rgba(5, 8, 10, 0.00);

	overflow: hidden;
}

.survivor_nickname {
	width: 308px;
	height: 18px;

	overflow: hidden;

	color: #ffffff;

	font-size: 14px;
	font-weight: bold;
	letter-spacing: 1px;
	line-height: 17px;

	white-space: nowrap;
}

.survivor_class {
	width: 308px;
	height: 12px;

	margin-top: 4px;

	color: #e57731;

	font-size: 8px;
	font-weight: bold;
	letter-spacing: 2px;
	line-height: 10px;

	white-space: nowrap;
}

/* ============================================================
   MAIN MENU DASHBOARD
   ============================================================ */

.mainmenu_dashboard {
	position: absolute;
	left: 34px;
	top: 132px;
	width: 440px;
	height: 610px;
	z-index: 20;
	display: flex;
	flex-direction: column;
}

.mm_card {
	position: relative;
	width: 440px;
	height: 102px;
	min-height: 102px;
	margin-bottom: 10px;
	padding: 13px 15px 12px 17px;
	background-color: rgba(6, 10, 12, 0.90);
	decorator: linear-gradient(180deg, rgba(31, 40, 45, 0.97), rgba(9, 14, 17, 0.98) 58%, rgba(4, 7, 8, 0.98)) border-box;
	border-width: 1px;
	border-color: rgba(84, 98, 106, 0.82);
	border-left-width: 3px;
	border-left-color: #d96d2a;
	border-bottom-width: 2px;
	border-bottom-color: rgba(0, 0, 0, 0.72);
	box-shadow: #000000aa 0px 4px 14px 0px;
	filter: none;
}

.mm_card.locked {
	opacity: 0.78;
	border-left-color: #59666c;
	border-color: rgba(55, 66, 72, 0.72);
}

.mm_card_header,
.mm_card_top {
	position: relative;
	width: 100%;
	height: 18px;
	display: flex;
	justify-content: space-between;
	align-items: center;
}

.mm_card_kicker {
	height: 18px;
	color: #d96d2a;
	font-size: 8px;
	font-weight: bold;
	letter-spacing: 2px;
	line-height: 14px;
}

.mm_card_chip {
	min-width: 52px;
	height: 18px;
	padding-top: 4px;
	padding-left: 8px;
	padding-right: 8px;
	color: #aeb8bd;
	background-color: rgba(10, 15, 18, 0.94);
	border-width: 1px;
	border-color: rgba(70, 83, 90, 0.78);
	font-size: 7px;
	font-weight: bold;
	letter-spacing: 1px;
	text-align: center;
}

.mm_card_chip.hot,
.mm_card_chip.accent {
	color: #ffffff;
	background-color: rgba(137, 45, 34, 0.92);
	border-color: rgba(214, 96, 67, 0.90);
}

.mm_card_chip.locked {
	color: #677279;
	background-color: rgba(8, 12, 14, 0.90);
	border-color: rgba(42, 50, 55, 0.82);
}

.mm_card_title {
	width: 280px;
	height: 20px;
	margin-top: 7px;
	color: #f1f5f7;
	font-size: 15px;
	font-weight: bold;
	letter-spacing: 1px;
	line-height: 18px;
}

.mm_card_text {
	width: 280px;
	min-height: 16px;
	margin-top: 4px;
	color: #9fa9ae;
	font-size: 10px;
	line-height: 14px;
}

.mm_card_reward {
	width: 280px;
	height: 14px;
	margin-top: 4px;
	color: #d96d2a;
	font-size: 9px;
	font-weight: bold;
	letter-spacing: 1px;
	line-height: 12px;
}

.mm_card_action,
.mm_card_button {
	position: absolute;
	right: 14px;
	bottom: 13px;
	width: 112px;
	height: 28px;
	padding-top: 8px;
	color: #dfe7ea;
	background-color: rgba(23, 32, 37, 0.96);
	decorator: linear-gradient(180deg, rgba(46, 58, 64, 0.96), rgba(22, 30, 35, 0.98)) border-box;
	border-width: 1px;
	border-color: rgba(88, 105, 114, 0.80);
	border-bottom-width: 2px;
	border-bottom-color: rgba(8, 11, 13, 0.95);
	font-size: 8px;
	font-weight: bold;
	letter-spacing: 1px;
	text-align: center;
	filter: none;
}

.mm_card_action:hover,
.mm_card_button:hover {
	color: #ffffff;
	background-color: rgba(37, 48, 54, 0.98);
	border-color: rgba(217, 109, 42, 0.90);
	border-bottom-color: #d96d2a;
	filter: none;
}

.mm_card_action.disabled,
.mm_card_action.disabled:hover,
.mm_card_button.disabled,
.mm_card_button.disabled:hover {
	color: #59656b;
	background-color: rgba(12, 16, 18, 0.92);
	border-color: rgba(39, 47, 51, 0.82);
	border-bottom-color: rgba(18, 24, 27, 0.90);
	filter: none;
	text-shadow: none;
}

.mm_progress,
.mm_card_progress {
	width: 280px;
	height: 8px;
	margin-top: 9px;
	background-color: rgba(3, 6, 8, 0.96);
	border-width: 1px;
	border-color: rgba(60, 72, 78, 0.82);
}

.mm_progress_fill,
.mm_card_progress_fill {
	width: 0%;
	height: 6px;
	background-color: #d96d2a;
}

.mm_card_news,
.mm_card_featured_shop,
.mm_card_rank,
.mm_card_missions,
.mm_card_battlepass {
	min-height: 102px;
}

/* ============================================================
   PLAY / SQUAD
   ============================================================ */

.bottom_play_area {
	position: absolute;
	left: 34px;
	bottom: 34px;

	width: 650px;
	height: 56px;

	z-index: 29;

	display: flex;
	align-items: center;
}

.play_button {
	width: 340px;
	height: 56px;

	padding: 0px;

	display: flex;
	align-items: center;

	color: #ffffff;
	background-color: #b94335;
	decorator: linear-gradient(180deg, #e05b4d, #b94335 54%, #7e251d) border-box;

	border-width: 1px;
	border-color: #eb7669;
	border-bottom-width: 2px;
	border-bottom-color: #5b1712;

	filter: none;
}

.play_button:hover {
	background-color: #cf5041;
	decorator: linear-gradient(180deg, #ff8977, #cf5041 54%, #7a211a) border-box;
	border-color: #ff9285;
	border-bottom-color: #7a2018;
	filter: none;
	animation: none;
}

.play_button:active {
	background-color: #7a2924;
	decorator: linear-gradient(180deg, #9a352d, #6a211c 58%, #35100e) border-box;
	border-bottom-width: 2px;
}

.play_button_icon {
	width: 56px;
	height: 56px;

	padding-top: 19px;

	font-size: 14px;
	font-weight: bold;
	text-align: center;

	border-right-width: 1px;
	border-right-color: rgba(255, 255, 255, 0.18);
}

.play_button_text {
	width: 284px;
	height: 56px;

	padding-top: 15px;

	font-size: 25px;
	font-weight: bold;
	letter-spacing: 1px;
	text-align: center;
}

.squad_slots {
	width: 280px;
	height: 54px;
	margin-left: 18px;
	display: flex;
	flex-direction: column;
}

.squad_slot {
	width: 280px;
	height: 25px;
	margin-bottom: 4px;
	padding-left: 10px;
	display: flex;
	align-items: center;
	color: #9fa9ae;
	background-color: rgba(6, 10, 12, 0.62);
	border-width: 1px;
	border-color: rgba(75, 89, 97, 0.62);
	font-size: 8px;
	font-weight: bold;
	letter-spacing: 1px;
}

.squad_slot_plus {
	width: 24px;
	color: #d9dfe1;
	font-size: 13px;
	text-align: center;
}

.squad_slot.disabled {
	color: #4e585d;
	border-color: #252e32;
}

/* ============================================================
   PREVIEW HELP / STATUS
   ============================================================ */

.preview_help {
	display: none;
	position: absolute;
	left: 50%;
	bottom: 63px;
	width: 330px;
	margin-left: -165px;
	z-index: 12;
	padding: 7px 10px;
	color: #a4adb1;
	background-color: rgba(4, 7, 9, 0.58);
	border-top-width: 1px;
	border-top-color: rgba(128, 139, 145, 0.34);
	font-size: 10px;
	font-weight: bold;
	letter-spacing: 1px;
	text-align: center;
}

.main_menu_status_bar {
	position: absolute;
	left: 0px;
	right: 0px;
	bottom: 0px;
	height: 23px;
	z-index: 18;
	padding-left: 28px;
	padding-right: 28px;
	display: flex;
	justify-content: space-between;
	align-items: center;
	background-color: rgba(4, 7, 9, 0.45);
	border-top-width: 1px;
	border-top-color: rgba(66, 77, 82, 0.52);
}

.main_menu_status_left {
	height: 23px;
