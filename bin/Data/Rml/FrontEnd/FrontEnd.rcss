	font-size: 10px;
	font-weight: bold;
}

.server_information_value {
	margin-left: 4px;
	color: #a0aaae;
	font-size: 10px;
	font-weight: bold;
}

.server_information_separator {
	margin-left: 8px;
	color: #414b50;
	font-size: 8px;
}

.connection_bars {
	width: 18px;
	height: 15px;
	margin-left: 10px;
	display: flex;
	align-items: flex-end;
}

.connection_bar {
	width: 3px;
	margin-right: 2px;
	background-color: #5fc878;
}

.connection_bar.bar_one {
	height: 4px;
}

.connection_bar.bar_two {
	height: 8px;
}

.connection_bar.bar_three {
	height: 12px;
}

