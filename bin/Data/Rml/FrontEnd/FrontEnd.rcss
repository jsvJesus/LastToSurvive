}

.create_character_info {
	width: 100%;
	margin-top: 14px;
	padding: 12px;
	background-color: #090e11;
	border-width: 1px;
	border-color: #303a40;
}

.create_info_row {
	width: 100%;
	height: 24px;
	display: flex;
	justify-content: space-between;
	align-items: center;
}

.create_info_label {
	color: #77848a;
	font-size: 8px;
	font-weight: bold;
	letter-spacing: 2px;
}

.create_info_value {
	color: #ffffff;
	font-size: 10px;
	font-weight: bold;
}

.create_help_text {
	width: 100%;
	margin-top: 7px;
	color: #657178;
	font-size: 9px;
	line-height: 14px;
}

.appearance_title {
	width: 100%;
	margin-top: 22px;
	margin-bottom: 9px;
	padding-bottom: 9px;
	color: #e67530;
	border-bottom-width: 1px;
	border-bottom-color: #303a40;
	font-size: 9px;
	font-weight: bold;
	letter-spacing: 2px;
}

.appearance_row {
	width: 100%;
	height: 50px;
	margin-top: 7px;
	padding-left: 10px;
	padding-right: 10px;
	display: flex;
	align-items: center;
	background-color: #090e11;
	border-width: 1px;
	border-color: #303a40;
}

.appearance_label {
	width: 40%;
	color: #8c989e;
	font-size: 9px;
	font-weight: bold;
