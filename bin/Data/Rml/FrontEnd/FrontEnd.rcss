}

.appearance_button {
	width: 38px;
	height: 34px;
	color: #e7eaec;
	background-color: #12191d;
	border-color: #354148;
	font-size: 15px;
	text-align: center;
}

.appearance_button:hover {
	color: #ffffff;
	background-color: #1d272c;
	border-color: #e67530;
}

.appearance_value {
	width: 82px;
	color: #ffffff;
	font-size: 11px;
	font-weight: bold;
	text-align: center;
}

.create_status {
	width: 100%;
	margin-top: 18px;
	margin-bottom: 10px;
}

/* ============================================================
   PLAY MODE MODAL
   ============================================================ */

.play_mode_overlay {
	display: none;

	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	z-index: 80;
}

.play_mode_overlay.visible {
	display: block;
}

.play_mode_backdrop {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 100%;

	padding: 0px;
	margin: 0px;

	display: block;

	color: rgba(0, 0, 0, 0);
	background-color: rgba(0, 0, 0, 0.62);

	decorator: none;

	border-width: 0px;
	border-color: rgba(0, 0, 0, 0);
	border-bottom-width: 0px;
	border-bottom-color: rgba(0, 0, 0, 0);

	filter: none;
	text-shadow: none;

	z-index: 81;
}

.play_mode_backdrop:hover,
.play_mode_backdrop:active,
.play_mode_backdrop:focus {
	color: rgba(0, 0, 0, 0);
	background-color: rgba(0, 0, 0, 0.62);

	decorator: none;

	border-width: 0px;
	border-color: rgba(0, 0, 0, 0);
	border-bottom-width: 0px;
	border-bottom-color: rgba(0, 0, 0, 0);

	filter: none;
	text-shadow: none;
}

.play_mode_panel {
	position: absolute;
	left: 50%;
	top: 50%;

	width: 860px;
	height: 520px;

	margin-left: -430px;
	margin-top: -260px;

	background-color: rgba(8, 12, 14, 0.96);
	decorator: linear-gradient(180deg, #20282d, #0b1013 45%, #06090b) border-box;

	border-width: 1px;
	border-color: rgba(92, 108, 116, 0.82);
	border-bottom-width: 2px;
	border-bottom-color: rgba(224, 112, 48, 0.80);

	box-shadow: #000000cc 0px 10px 26px 0px;

	z-index: 82;
}

.play_mode_header {
	position: absolute;
	left: 0px;
	top: 0px;

	width: 100%;
	height: 76px;

	padding-left: 24px;
	padding-right: 18px;
	padding-top: 16px;

	display: flex;
	justify-content: space-between;

	background-color: rgba(3, 6, 8, 0.72);

	border-bottom-width: 1px;
	border-bottom-color: rgba(68, 82, 90, 0.70);
}

.play_mode_kicker {
	color: #e07830;

	font-size: 8px;
	font-weight: bold;
	line-height: 10px;
	letter-spacing: 3px;
}

.play_mode_title {
	margin-top: 5px;

	color: #ffffff;

	font-size: 24px;
	font-weight: bold;
	line-height: 28px;
	letter-spacing: 2px;
}

.play_mode_close_button {
	width: 36px;
	height: 36px;

	padding: 0px;
	margin-top: 3px;

	color: #d8dde0;
	background-color: rgba(20, 27, 31, 0.92);

	decorator: none;

	border-width: 1px;
	border-color: rgba(92, 108, 116, 0.72);

	font-size: 14px;
	font-weight: bold;
	line-height: 34px;
	text-align: center;

	filter: none;
	text-shadow: none;
}

.play_mode_close_button:hover {
	color: #ffffff;
	background-color: rgba(80, 32, 24, 0.96);
	border-color: #e07830;
	filter: drop-shadow(#e8793248 0px 0px 8px);
}

.play_mode_description {
	position: absolute;
	left: 24px;
	top: 94px;

	width: 812px;
	height: 32px;

	color: #9da8ad;

	font-size: 11px;
	font-weight: bold;
	line-height: 16px;
	letter-spacing: 1px;
}

.play_mode_list {
	position: absolute;
	left: 24px;
	top: 148px;

	width: 812px;
	height: 330px;

	display: flex;
	flex-direction: row;
}

.play_mode_card {
	position: relative;

	width: 194px;
	height: 320px;

	margin-right: 12px;
	padding: 0px;

	color: #ffffff;
	background-color: rgba(18, 24, 28, 0.92);

	decorator: linear-gradient(180deg, #263137, #11171b 55%, #070a0c) border-box;

	border-width: 1px;
	border-color: rgba(78, 92, 100, 0.76);
	border-bottom-width: 2px;
	border-bottom-color: rgba(28, 36, 41, 0.95);

	text-align: left;

	filter: none;
	text-shadow: none;

	overflow: hidden;

	transition: background-color 0.20s, border-color 0.20s, filter 0.20s;
}

.play_mode_card.available:hover {
	background-color: rgba(32, 41, 46, 0.98);
	border-color: #e07830;
	border-bottom-color: #b04e24;
	filter: drop-shadow(#e8793244 0px 0px 10px);
}

.play_mode_card.locked {
	opacity: 0.55;
}

.play_mode_card.locked:hover {
	background-color: rgba(24, 29, 33, 0.96);
	border-color: rgba(110, 120, 126, 0.80);
	filter: none;
}

.play_mode_card_status {
	position: absolute;
	left: 12px;
	top: 14px;

	width: 170px;
	height: 18px;

	color: #e07830;

	font-size: 8px;
	font-weight: bold;
	line-height: 12px;
	letter-spacing: 2px;
}

.play_mode_card.locked .play_mode_card_status {
	color: #8e979b;
}

.play_mode_card_title {
	position: absolute;
	left: 12px;
	top: 48px;

	width: 170px;

	color: #ffffff;

	font-size: 17px;
	font-weight: bold;
	line-height: 20px;
	letter-spacing: 1px;
}

.play_mode_card_text {
	position: absolute;
	left: 12px;
	top: 112px;

	width: 166px;
	height: 96px;

	color: #a7b0b5;

	font-size: 10px;
	font-weight: normal;
	line-height: 15px;
}

.play_mode_card_footer {
	position: absolute;
	left: 0px;
	bottom: 0px;

	width: 100%;
	height: 44px;

	padding-top: 15px;

	color: #d8dde0;
	background-color: rgba(5, 8, 10, 0.70);

	border-top-width: 1px;
	border-top-color: rgba(64, 76, 84, 0.72);

	font-size: 9px;
	font-weight: bold;
	letter-spacing: 2px;
	text-align: center;
}

.play_mode_card.available .play_mode_card_footer {
	color: #ffb15e;
}

.play_mode_card.route {
	opacity: 0.72;
}

.play_mode_card.route:hover {
	background-color: rgba(24, 31, 35, 0.96);
	border-color: rgba(118, 138, 148, 0.90);
	filter: none;
}

.play_mode_card.route .play_mode_card_status {
	color: #82a9c8;
}

.play_mode_card.route .play_mode_card_footer {
	color: #9fb8c9;
}

/* ============================================================
   FRONTEND CENTER NOTICES
   ============================================================ */

.frontend_notice_layer {
	display: none;

	position: absolute;
	left: 50%;
	top: 30%;

	width: 560px;
	min-height: 82px;

	margin-left: -280px;

	z-index: 96;
}

.frontend_notice_layer.visible {
	display: block;
}

.frontend_notice {
	width: 560px;
	min-height: 82px;

	padding: 17px 20px;

	background-color: rgba(7, 11, 13, 0.96);
	decorator: linear-gradient(180deg, #202a2f, #0b1013 52%, #06090b) border-box;

	border-width: 1px;
	border-color: rgba(94, 110, 118, 0.88);
	border-left-width: 4px;
	border-left-color: #d96d2a;
	border-bottom-width: 2px;
	border-bottom-color: rgba(0, 0, 0, 0.72);

	box-shadow: #000000cc 0px 8px 24px 0px;
	filter: drop-shadow(#000000cc 0px 6px 10px);
}

.frontend_notice.info {
	border-left-color: #d96d2a;
}

.frontend_notice.success {
	border-left-color: #5fc878;
}

.frontend_notice.warning {
	border-left-color: #e5b84a;
}

.frontend_notice.error {
	border-left-color: #cf3d32;
}

.frontend_notice.system {
	border-left-color: #7fa0b6;
}

.frontend_notice_title {
	width: 100%;

	color: #ff8b40;
	font-size: 10px;
	font-weight: bold;
	letter-spacing: 2px;
	text-align: center;
}

.frontend_notice.success .frontend_notice_title {
	color: #8ee69e;
}

.frontend_notice.warning .frontend_notice_title {
	color: #ffd36a;
}

.frontend_notice.error .frontend_notice_title {
	color: #ff7568;
}

.frontend_notice.system .frontend_notice_title {
	color: #a9c5d8;
}

.frontend_notice_text {
	width: 100%;

	margin-top: 8px;

	color: #d8dde0;
	font-size: 13px;
	font-weight: bold;
	line-height: 18px;
	text-align: center;
}