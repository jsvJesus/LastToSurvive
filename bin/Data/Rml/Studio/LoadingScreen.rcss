body
{
	width: 100%;
	height: 100%;

	margin: 0;
	padding: 0;

	font-family: Arial;
	color: #d6dce0;

	background-color: transparent;
}

#loading_root
{
	width: 100%;
	height: 100%;
}

/* MAIN PANEL */

#loading_panel
{
	position: absolute;

	left: 60px;
	right: 60px;
	bottom: 44px;

	height: 176px;

	margin: 0;
	padding: 0;

	background-color: #10161aee;
	border: 1px #2d3941;
}

/* ICON */

#loading_icon
{
	position: absolute;

	left: 24px;
	top: 24px;

	width: 48px;
	height: 48px;

	margin: 0;
	padding: 0;

	background-color: #141c22;
	border: 1px #46535d;
}

#loading_icon_inner
{
	position: absolute;

	left: 15px;
	top: 15px;

	width: 18px;
	height: 18px;

	margin: 0;
	padding: 0;

	background-color: #8e3b3d;

	animation: loading_icon_pulse 0.75s linear infinite alternate;
}

/* TEXT */

#loading_text_block
{
	position: absolute;

	left: 88px;
	top: 22px;

	width: 760px;
	height: 56px;

	margin: 0;
	padding: 0;
}

#loading_title
{
	width: 100%;
	height: 30px;

	margin: 0;
	padding: 0;

	color: #edf2f5;

	font-size: 24px;
	line-height: 30px;

	text-align: left;
}

#loading_description
{
	width: 100%;
	height: 22px;

	margin: 0;
	padding: 0;

	color: #87939b;

	font-size: 13px;
	line-height: 22px;

	text-align: left;
}

/* PROGRESS */

#loading_progress
{
	position: absolute;

	left: 24px;
	right: 24px;
	top: 92px;

	height: 28px;

	margin: 0;
	padding: 0;
}

#loading_bar
{
	position: absolute;

	left: 0;
	right: 74px;
	top: 6px;

	height: 16px;

	margin: 0;
	padding: 0;

	background-color: #172027;
	border: 1px #39464f;
}

#loading_bar_fill
{
	position: absolute;

	left: 0;
	top: 0;

	width: 1%;
	height: 100%;

	margin: 0;
	padding: 0;

	background-color: #8e3b3d;

	transition: width 0.14s linear;
}

#loading_bar_glow
{
	position: absolute;

	right: 0;
	top: 0;

	width: 36px;
	height: 100%;

	margin: 0;
	padding: 0;

	background-color: #b95a5d;

	opacity: 0.45;

	animation: loading_glow_pulse 0.65s linear infinite alternate;
}

#loading_percent
{
	position: absolute;

	right: 0;
	top: 0;

	width: 64px;
	height: 28px;

	margin: 0;
	padding: 0;

	color: #d8e0e4;

	font-size: 14px;
	line-height: 28px;

	text-align: right;
}

/* TIP */

#loading_tip
{
	position: absolute;

	left: 24px;
	right: 24px;
	bottom: 18px;

	height: 22px;

	margin: 0;
	padding: 0;

	color: #6e7980;

	font-size: 12px;
	line-height: 22px;

	text-align: left;
}

/* SIMPLE SAFE ANIMATION */

@keyframes loading_icon_pulse
{
	from
	{
		background-color: #703033;
	}
	to
	{
		background-color: #b95a5d;
	}
}

@keyframes loading_glow_pulse
{
	from
	{
		opacity: 0.25;
	}
	to
	{
		opacity: 0.65;
	}
}