body {
	width: 100%;
	height: 100%;
	margin: 0;
	padding: 0;
	font-family: Arial;
	color: #d8ded9;
}

#screen {
	width: 100%;
	height: 100%;
	background-color: rgba(0, 0, 0, 0);
}

#panel {
	position: absolute;
	left: 64px;
	top: 64px;
	width: 520px;
	min-height: 260px;
	padding: 28px;
	background-color: rgba(8, 13, 12, 230);
	border-width: 1px;
	border-color: #31534a;
}

#title {
	font-size: 34px;
	font-weight: bold;
	color: #f07b2a;
	margin-bottom: 8px;
}

#subtitle {
	font-size: 16px;
	color: #aeb8b2;
	margin-bottom: 24px;
}

#status-grid {
	width: 100%;
	margin-bottom: 24px;
}

.status-row {
	display: flex;
	flex-direction: row;
	width: 100%;
	height: 34px;
	margin-bottom: 6px;
	background-color: rgba(255, 255, 255, 18);
}

.status-label {
	width: 180px;
	padding: 8px 12px;
	color: #89948f;
}

.status-value {
	flex: 1;
	padding: 8px 12px;
	color: #ffffff;
}

#footer {
	font-size: 15px;
	color: #77c08f;
}