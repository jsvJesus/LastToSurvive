	font-weight: bold;
	line-height: 22px;
	letter-spacing: 1px;
	text-align: left;
}

#selection_line
{
	position: absolute;
	left: 20px;
	top: 47px;
	width: 238px;
	height: 1px;
	background-color: #292b2a;
}

#appmain_selected_label
{
	position: absolute;
	left: 20px;
	top: 76px;
	width: 238px;
	height: 20px;
	margin: 0;
	padding: 0;
	color: #777773;
	font-size: 10px;
	font-weight: bold;
	line-height: 20px;
	letter-spacing: 1px;
	text-align: left;
}

#appmain_selected_value
{
	position: absolute;
	left: 20px;
	top: 104px;
	width: 238px;
	height: 58px;
	margin: 0;
	padding: 0;
	background-color: #07090a;
	border: 1px #3a3c3b;
	color: #e6e5e1;
	font-size: 13px;
	font-weight: bold;
	line-height: 58px;
	text-align: center;
}

#selection_hint
{
	position: absolute;
	left: 20px;
	top: 184px;
	width: 238px;
	height: 64px;
	margin: 0;
	padding: 0;
	color: #777773;
	font-size: 11px;
	line-height: 18px;
	text-align: left;
}

.main_button
{
	position: absolute;
	margin: 0;
	padding: 0;
	background-color: #0d0f10;
	border: 1px #a85a16;
	color: #e77b17;
	font-size: 13px;
	font-weight: bold;
	line-height: 44px;
	letter-spacing: 1px;
	text-align: center;
}

#btn_appmain_load_level
{
	left: 20px;
	bottom: 22px;
	width: 238px;
	height: 44px;
}

.main_button:hover
{
	background-color: #2c190d;
	border: 1px #ff8a16;
	color: #ff9a31;
}

.main_button:active
{
	background-color: #4a240d;
	border: 1px #ff9a31;
	color: #ffffff;
}

