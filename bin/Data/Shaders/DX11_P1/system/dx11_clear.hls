cbuffer FrameCB : register(b0)
{
	float4x4 gViewProj;
	float4x4 gView;
	float4x4 gProj;
	float4 gCameraPos;
	float4 gScreenSize;
	float4 gNearFar;
};

struct VS_OUTPUT
{
	float4 Position : SV_POSITION;
	float2 TexCoord : TEXCOORD0;
};

struct PS_OUTPUT
{
	float4 Color : SV_Target0;
	float4 Normal : SV_Target1;
	float DepthLinear : SV_Target2;
	float4 Aux : SV_Target3;
};

VS_OUTPUT VSMain(uint VertexID : SV_VertexID)
{
	VS_OUTPUT Output;

	float2 Positions[3] =
	{
		float2(-1.0f, -1.0f),
		float2(-1.0f,  3.0f),
		float2( 3.0f, -1.0f)
	};

	float2 TexCoords[3] =
	{
		float2(0.0f, 1.0f),
		float2(0.0f, -1.0f),
		float2(2.0f, 1.0f)
	};

	Output.Position = float4(Positions[VertexID], 0.0f, 1.0f);
	Output.TexCoord = TexCoords[VertexID];

	return Output;
}

PS_OUTPUT PSMain(VS_OUTPUT Input)
{
	// Distinct color for DX11 smoke test.
	// Expected readback approximately:
	// R=26, G=51, B=89, A=255
	float2 SizeCheck =
		saturate(gScreenSize.xy * gScreenSize.zw);

	float NearFarCheck =
		saturate(gNearFar.x / max(gNearFar.y, 1.0f));

	float TexCoordCheck =
		dot(Input.TexCoord, float2(0.0f, 0.0f));

	PS_OUTPUT Output;
	Output.Color = float4(
		0.10f * SizeCheck.x + TexCoordCheck,
		0.20f * SizeCheck.y,
		0.35f + NearFarCheck * 0.01f,
		1.0f
	);
	Output.Normal = float4(0.5f, 0.5f, 1.0f, 1.0f);
	Output.DepthLinear = NearFarCheck;
	Output.Aux = float4(gScreenSize.zw, 0.0f, 1.0f);

	return Output;
}
