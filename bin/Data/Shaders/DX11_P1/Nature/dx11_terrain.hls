cbuffer FrameCB : register(b0)
{
	row_major float4x4 gViewProj;
	row_major float4x4 gView;
	row_major float4x4 gProj;
	float4 gCameraPos;
	float4 gScreenSize;
	float4 gNearFar;
};

cbuffer TerrainCB : register(b1)
{
	float4 gTerrainBaseColor;
	float4 gTerrainColorScale;
	float4 gTerrainDebugParams;
	float4 gTerrainSize;
	float4 gTerrainLayerScale0;
	float4 gTerrainLayerScale1;
	float4 gTerrainAtlasTexTransform;
	float4 gTerrainAtlasWorld;
};

cbuffer ObjectCB : register(b2)
{
	row_major float4x4 gWorld;
	row_major float4x4 gPrevWorld;
	float4 gObjectColor;
	float4 gObjectParams;
};

cbuffer MaterialCB : register(b3)
{
	float4 gDiffuseScale;
	float4 gNormalScale;
	float4 gSpecularGloss;
	float4 gMaterialParams;
};

cbuffer LightCB : register(b4)
{
	float4 gSunDir;
	float4 gSunColor;
	float4 gAmbientColor;
	float4 gFogColor;
	float4 gFogParams;
};

cbuffer ShadowCB : register(b5)
{
	float4 gShadowParams;
	float4 gShadowAtlasParams;
};

cbuffer WaterCB : register(b6)
{
	float4 gWaterColor;
	float4 gWaterParams;
	float4 gWaterUVParams;
};

cbuffer GrassCB : register(b7)
{
	float4 gGrassParams;
	float4 gWindParams;
};

Texture2D gTerrainColorTexture : register(t0);
Texture2D gTerrainNormalTexture : register(t1);
Texture2D gTerrainHeightTexture : register(t2);
Texture2D gTerrainLayer0DiffuseTexture : register(t3);
Texture2D gTerrainLayer0NormalTexture : register(t4);

Texture2D gTerrainMask0Texture : register(t5);
Texture2D gTerrainLayer1DiffuseTexture : register(t6);
Texture2D gTerrainLayer2DiffuseTexture : register(t7);
Texture2D gTerrainLayer3DiffuseTexture : register(t8);
Texture2D gTerrainAtlasDiffuseTexture : register(t9);
Texture2D gTerrainAtlasNormalTexture : register(t10);

SamplerState gTerrainWrapSampler : register(s0);
SamplerState gTerrainClampSampler : register(s1);

struct VS_INPUT
{
	float3 Position : POSITION;
	float3 Normal : NORMAL;
};

struct VS_OUTPUT
{
	float4 Position : SV_POSITION;
	float3 WorldPos : TEXCOORD0;
	float3 Normal : TEXCOORD1;
};

struct PS_OUTPUT
{
	float4 Color : SV_Target0;
	float4 Normal : SV_Target1;
	float DepthLinear : SV_Target2;
	float4 Aux : SV_Target3;
};

float3 TerrainSafeNormalize(float3 Value, float3 Fallback)
{
	float LenSq = dot(Value, Value);

	if (LenSq <= 0.000001f)
		return Fallback;

	return Value * rsqrt(LenSq);
}

bool Terrain2MaskHasBit(float Bit)
{
	float Mask =
		gTerrainDebugParams.z;

	return fmod(
		floor(Mask / Bit),
		2.0f
	) >= 1.0f;
}

bool Terrain2HasColorTexture()
{
	return Terrain2MaskHasBit(1.0f);
}

bool Terrain2HasNormalTexture()
{
	return Terrain2MaskHasBit(2.0f);
}

bool Terrain2HasHeightTexture()
{
	return Terrain2MaskHasBit(4.0f);
}

bool Terrain2HasLayer0DiffuseTexture()
{
	return Terrain2MaskHasBit(8.0f);
}

bool Terrain2HasLayer0NormalTexture()
{
	return Terrain2MaskHasBit(16.0f);
}

bool Terrain2HasMask0Texture()
{
	return Terrain2MaskHasBit(32.0f);
}

bool Terrain2HasLayer1DiffuseTexture()
{
	return Terrain2MaskHasBit(64.0f);
}

bool Terrain2HasLayer2DiffuseTexture()
{
	return Terrain2MaskHasBit(128.0f);
}

bool Terrain2HasLayer3DiffuseTexture()
{
	return Terrain2MaskHasBit(256.0f);
}

bool Terrain2HasAtlasDiffuseTexture()
{
	return Terrain2MaskHasBit(512.0f);
}

bool Terrain2HasAtlasNormalTexture()
{
	return Terrain2MaskHasBit(1024.0f);
}

float2 Terrain2GetLayerUV(float3 WorldPos, float2 Scale)
{
	return float2(
		WorldPos.x * Scale.x,
		WorldPos.z * Scale.y
	);
}

float2 Terrain2GetLayer0UV(float3 WorldPos)
{
	return Terrain2GetLayerUV(
		WorldPos,
		gTerrainLayerScale0.xy
	);
}

float2 Terrain2GetTerrainUV(float3 WorldPos)
{
	return saturate(
		float2(
			WorldPos.x * gTerrainSize.z,
			WorldPos.z * gTerrainSize.w
		)
	);
}

float2 Terrain2GetMaskUV(float3 WorldPos)
{
	return Terrain2GetTerrainUV(
		WorldPos
	);
}

float2 Terrain2GetAtlasUV(float3 WorldPos)
{
	float InvWorldDim =
		gTerrainAtlasWorld.w;

	float2 Local01 =
		saturate(
			float2(
				(WorldPos.x - gTerrainAtlasWorld.x) * InvWorldDim,
				(WorldPos.z - gTerrainAtlasWorld.y) * InvWorldDim
			)
		);

	float2 LocalSigned =
		Local01 * 2.0f - 1.0f;

	return LocalSigned * gTerrainAtlasTexTransform.xy +
		gTerrainAtlasTexTransform.zw;
}

VS_OUTPUT VSMain(VS_INPUT Input)
{
	VS_OUTPUT Output;

	Output.WorldPos = Input.Position;
	Output.Normal = TerrainSafeNormalize(
		Input.Normal,
		float3(0.0f, 1.0f, 0.0f)
	);
	Output.Position = mul(float4(Input.Position, 1.0f), gViewProj);

	return Output;
}

PS_OUTPUT PSMain(VS_OUTPUT Input)
{
	PS_OUTPUT Output;

	float HeightTint =
	saturate(
		(Input.WorldPos.y - gCameraPos.y + gTerrainDebugParams.x) *
		gTerrainDebugParams.y
	);

	float CameraDistance =
		length(Input.WorldPos - gCameraPos.xyz);

	float DepthLinear =
		saturate(CameraDistance / max(gNearFar.y, 1.0f));

	float3 Normal = TerrainSafeNormalize(
		Input.Normal,
		float3(0.0f, 1.0f, 0.0f)
	);

	float Slope = saturate(1.0f - Normal.y);

	float3 DebugColor = float3(
		gTerrainBaseColor.r + Slope * gTerrainColorScale.r,
		gTerrainBaseColor.g + HeightTint * gTerrainColorScale.g,
		gTerrainBaseColor.b + Normal.y * gTerrainColorScale.b
	);

	float3 FinalColor = DebugColor;
	float3 TerrainColorMod = float3(
		1.0f,
		1.0f,
		1.0f
	);

	if (Terrain2HasColorTexture())
	{
		TerrainColorMod =
			gTerrainColorTexture.Sample(
				gTerrainClampSampler,
				Terrain2GetTerrainUV(
					Input.WorldPos
				)
			).rgb;
	}

	float3 MaskDebug = float3(0.0f, 0.0f, 0.0f);
	float MaskSumDebug = 0.0f;

	if (Terrain2HasLayer0DiffuseTexture())
	{
		float2 Layer0UV =
			Terrain2GetLayer0UV(
				Input.WorldPos
			);

		float3 Layer0Color =
			gTerrainLayer0DiffuseTexture.Sample(
				gTerrainWrapSampler,
				Layer0UV
			).rgb *
			TerrainColorMod;

		FinalColor =
			saturate(
				Layer0Color
			);

		if (Terrain2HasMask0Texture())
		{
			float3 Mask =
				saturate(
					gTerrainMask0Texture.Sample(
						gTerrainClampSampler,
						Terrain2GetMaskUV(
							Input.WorldPos
						)
					).rgb
				);

			MaskDebug = Mask;
			MaskSumDebug =
				saturate(
					Mask.r + Mask.g + Mask.b
				);

			float W1 =
				Terrain2HasLayer1DiffuseTexture()
				? Mask.r
				: 0.0f;

			float W2 =
				Terrain2HasLayer2DiffuseTexture()
				? Mask.g
				: 0.0f;

			float W3 =
				Terrain2HasLayer3DiffuseTexture()
				? Mask.b
				: 0.0f;

			float W0 =
				saturate(
					1.0f - W1 - W2 - W3
				);

			float WeightSum =
				max(
					W0 + W1 + W2 + W3,
					0.0001f
				);

			float3 BlendColor =
				Layer0Color * W0;

			if (Terrain2HasLayer1DiffuseTexture())
			{
				float3 Layer1Color =
					gTerrainLayer1DiffuseTexture.Sample(
						gTerrainWrapSampler,
						Terrain2GetLayerUV(
							Input.WorldPos,
							gTerrainLayerScale0.zw
						)
					).rgb *
					TerrainColorMod;

				BlendColor +=
					Layer1Color * W1;
			}

			if (Terrain2HasLayer2DiffuseTexture())
			{
				float3 Layer2Color =
					gTerrainLayer2DiffuseTexture.Sample(
						gTerrainWrapSampler,
						Terrain2GetLayerUV(
							Input.WorldPos,
							gTerrainLayerScale1.xy
						)
					).rgb *
					TerrainColorMod;

				BlendColor +=
					Layer2Color * W2;
			}

			if (Terrain2HasLayer3DiffuseTexture())
			{
				float3 Layer3Color =
					gTerrainLayer3DiffuseTexture.Sample(
						gTerrainWrapSampler,
						Terrain2GetLayerUV(
							Input.WorldPos,
							gTerrainLayerScale1.zw
						)
					).rgb *
					TerrainColorMod;

				BlendColor +=
					Layer3Color * W3;
			}

			FinalColor =
				saturate(
					BlendColor / WeightSum
				);
		}
	}

	// Disabled for now.
	// The DX11 atlas path currently hides the real layer/mask result.
	// Re-enable only after direct layer/mask blending matches DX9.
	/*
	if (Terrain2HasAtlasDiffuseTexture())
	{
		float2 AtlasUV =
			Terrain2GetAtlasUV(
				Input.WorldPos
			);

		FinalColor =
			gTerrainAtlasDiffuseTexture.Sample(
				gTerrainClampSampler,
				AtlasUV
			).rgb;

		if (Terrain2HasAtlasNormalTexture())
		{
			Normal =
				TerrainSafeNormalize(
					gTerrainAtlasNormalTexture.Sample(
						gTerrainClampSampler,
						AtlasUV
					).xyz * 2.0f - 1.0f,
					Normal
				);
		}
	}
	*/

	Output.Color = float4(
		FinalColor,
		1.0f
	);
	
	Output.Normal = float4(Normal * 0.5f + 0.5f, 1.0f);
	Output.DepthLinear = DepthLinear;
	Output.Aux = float4(
		MaskDebug.r,
		MaskDebug.g,
		MaskDebug.b,
		MaskSumDebug
	);

	return Output;
}
