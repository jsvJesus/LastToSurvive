cbuffer FrameCB : register(b0)
{
	row_major float4x4 gViewProj;
	row_major float4x4 gView;
	row_major float4x4 gProj;
	float4 gCameraPos;
	float4 gScreenSize;
	float4 gNearFar;
};

cbuffer TerrainCB : register(b1)
{
	float4 gTerrainBaseColor;
	float4 gTerrainColorScale;
	float4 gTerrainDebugParams;
};

cbuffer ObjectCB : register(b2)
{
	row_major float4x4 gWorld;
	row_major float4x4 gPrevWorld;
	float4 gObjectColor;
	float4 gObjectParams;
};

cbuffer MaterialCB : register(b3)
{
	float4 gDiffuseScale;
	float4 gNormalScale;
	float4 gSpecularGloss;
	float4 gMaterialParams;
};

cbuffer LightCB : register(b4)
{
	float4 gSunDir;
	float4 gSunColor;
	float4 gAmbientColor;
	float4 gFogColor;
	float4 gFogParams;
};

cbuffer ShadowCB : register(b5)
{
	float4 gShadowParams;
	float4 gShadowAtlasParams;
};

cbuffer WaterCB : register(b6)
{
	float4 gWaterColor;
	float4 gWaterParams;
	float4 gWaterUVParams;
};

cbuffer GrassCB : register(b7)
{
	float4 gGrassParams;
	float4 gWindParams;
};

Texture2D gTerrainColorTexture : register(t0);
Texture2D gTerrainNormalTexture : register(t1);
Texture2D gTerrainHeightTexture : register(t2);
Texture2D gTerrainLayer0DiffuseTexture : register(t3);
Texture2D gTerrainLayer0NormalTexture : register(t4);

Texture2D gTerrainMask0Texture : register(t5);
Texture2D gTerrainLayer1DiffuseTexture : register(t6);
Texture2D gTerrainLayer2DiffuseTexture : register(t7);
Texture2D gTerrainLayer3DiffuseTexture : register(t8);

SamplerState gTerrainSampler : register(s0);

struct VS_INPUT
{
	float3 Position : POSITION;
	float3 Normal : NORMAL;
};

struct VS_OUTPUT
{
	float4 Position : SV_POSITION;
	float3 WorldPos : TEXCOORD0;
	float3 Normal : TEXCOORD1;
};

struct PS_OUTPUT
{
	float4 Color : SV_Target0;
	float4 Normal : SV_Target1;
	float DepthLinear : SV_Target2;
	float4 Aux : SV_Target3;
};

float3 TerrainSafeNormalize(float3 Value, float3 Fallback)
{
	float LenSq = dot(Value, Value);

	if (LenSq <= 0.000001f)
		return Fallback;

	return Value * rsqrt(LenSq);
}

bool Terrain2MaskHasBit(float Bit)
{
	float Mask =
		gTerrainDebugParams.z;

	return fmod(
		floor(Mask / Bit),
		2.0f
	) >= 1.0f;
}

bool Terrain2HasColorTexture()
{
	return Terrain2MaskHasBit(1.0f);
}

bool Terrain2HasNormalTexture()
{
	return Terrain2MaskHasBit(2.0f);
}

bool Terrain2HasHeightTexture()
{
	return Terrain2MaskHasBit(4.0f);
}

bool Terrain2HasLayer0DiffuseTexture()
{
	return Terrain2MaskHasBit(8.0f);
}

bool Terrain2HasLayer0NormalTexture()
{
	return Terrain2MaskHasBit(16.0f);
}

bool Terrain2HasMask0Texture()
{
	return Terrain2MaskHasBit(32.0f);
}

bool Terrain2HasLayer1DiffuseTexture()
{
	return Terrain2MaskHasBit(64.0f);
}

bool Terrain2HasLayer2DiffuseTexture()
{
	return Terrain2MaskHasBit(128.0f);
}

bool Terrain2HasLayer3DiffuseTexture()
{
	return Terrain2MaskHasBit(256.0f);
}

float2 Terrain2GetLayer0UV(float3 WorldPos)
{
	return float2(
		WorldPos.x * gTerrainColorScale.w,
		WorldPos.z * gTerrainDebugParams.w
	);
}

float2 Terrain2GetMaskUV(float3 WorldPos)
{
	return saturate(
		float2(
			WorldPos.x / max(gNearFar.z, 1.0f),
			WorldPos.z / max(gNearFar.w, 1.0f)
		)
	);
}

VS_OUTPUT VSMain(VS_INPUT Input)
{
	VS_OUTPUT Output;

	Output.WorldPos = Input.Position;
	Output.Normal = TerrainSafeNormalize(
		Input.Normal,
		float3(0.0f, 1.0f, 0.0f)
	);
	Output.Position = mul(float4(Input.Position, 1.0f), gViewProj);

	return Output;
}

PS_OUTPUT PSMain(VS_OUTPUT Input)
{
	PS_OUTPUT Output;

	float HeightTint =
	saturate(
		(Input.WorldPos.y - gCameraPos.y + gTerrainDebugParams.x) *
		gTerrainDebugParams.y
	);

	float CameraDistance =
		length(Input.WorldPos - gCameraPos.xyz);

	float DepthLinear =
		saturate(CameraDistance / max(gNearFar.y, 1.0f));

	float3 Normal = TerrainSafeNormalize(
		Input.Normal,
		float3(0.0f, 1.0f, 0.0f)
	);

	float Slope = saturate(1.0f - Normal.y);

	float3 DebugColor = float3(
		gTerrainBaseColor.r + Slope * gTerrainColorScale.r,
		gTerrainBaseColor.g + HeightTint * gTerrainColorScale.g,
		gTerrainBaseColor.b + Normal.y * gTerrainColorScale.b
	);

	float3 FinalColor = DebugColor;

	if (Terrain2HasLayer0DiffuseTexture())
	{
		float2 LayerUV =
			Terrain2GetLayer0UV(
				Input.WorldPos
			);

		float3 Layer0Color =
			gTerrainLayer0DiffuseTexture.Sample(
				gTerrainSampler,
				LayerUV
			).rgb;

		FinalColor = Layer0Color;

		if (Terrain2HasMask0Texture())
		{
			float2 MaskUV =
				Terrain2GetMaskUV(
					Input.WorldPos
				);

			float3 Mask =
				gTerrainMask0Texture.Sample(
					gTerrainSampler,
					MaskUV
				).rgb;

			float MaskR =
				saturate(Mask.r);

			float MaskG =
				saturate(Mask.g);

			float MaskB =
				saturate(Mask.b);

			if (Terrain2HasLayer1DiffuseTexture())
			{
				float3 Layer1Color =
					gTerrainLayer1DiffuseTexture.Sample(
						gTerrainSampler,
						LayerUV
					).rgb;

				FinalColor =
					lerp(
						FinalColor,
						Layer1Color,
						MaskR
					);
			}

			if (Terrain2HasLayer2DiffuseTexture())
			{
				float3 Layer2Color =
					gTerrainLayer2DiffuseTexture.Sample(
						gTerrainSampler,
						LayerUV
					).rgb;

				FinalColor =
					lerp(
						FinalColor,
						Layer2Color,
						MaskG
					);
			}

			if (Terrain2HasLayer3DiffuseTexture())
			{
				float3 Layer3Color =
					gTerrainLayer3DiffuseTexture.Sample(
						gTerrainSampler,
						LayerUV
					).rgb;

				FinalColor =
					lerp(
						FinalColor,
						Layer3Color,
						MaskB
					);
			}
		}
	}

	Output.Color = float4(
		FinalColor,
		1.0f
	);
	
	Output.Normal = float4(Normal * 0.5f + 0.5f, 1.0f);
	Output.DepthLinear = DepthLinear;
	Output.Aux = float4(DepthLinear, HeightTint, Slope, 1.0f);

	return Output;
}
