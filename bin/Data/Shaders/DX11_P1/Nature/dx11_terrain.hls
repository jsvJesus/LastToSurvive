cbuffer FrameCB : register(b0)
{
	row_major float4x4 gViewProj;
	row_major float4x4 gView;
	row_major float4x4 gProj;
	float4 gCameraPos;
	float4 gScreenSize;
	float4 gNearFar;
};

cbuffer TerrainCB : register(b1)
{
	float4 gTerrainBaseColor;
	float4 gTerrainColorScale;
	float4 gTerrainDebugParams;
	float4 gTerrainSize;

	float4 gTerrainLayerScale[13];

	float4 gTerrainAtlasTexTransform;
	float4 gTerrainAtlasWorld;
};

cbuffer ObjectCB : register(b2)
{
	row_major float4x4 gWorld;
	row_major float4x4 gPrevWorld;
	float4 gObjectColor;
	float4 gObjectParams;
};

cbuffer MaterialCB : register(b3)
{
	float4 gDiffuseScale;
	float4 gNormalScale;
	float4 gSpecularGloss;
	float4 gMaterialParams;
};

cbuffer LightCB : register(b4)
{
	float4 gSunDir;
	float4 gSunColor;
	float4 gAmbientColor;
	float4 gFogColor;
	float4 gFogParams;
};

cbuffer ShadowCB : register(b5)
{
	float4 gShadowParams;
	float4 gShadowAtlasParams;
};

cbuffer WaterCB : register(b6)
{
	float4 gWaterColor;
	float4 gWaterParams;
	float4 gWaterUVParams;
};

cbuffer GrassCB : register(b7)
{
	float4 gGrassParams;
	float4 gWindParams;
};

Texture2D gTerrainColorTexture : register(t0);
Texture2D gTerrainNormalTexture : register(t1);
Texture2D gTerrainHeightTexture : register(t2);
Texture2D gTerrainLayer0DiffuseTexture : register(t3);
Texture2D gTerrainLayer0NormalTexture : register(t4);

Texture2D gTerrainMask0Texture : register(t5);
Texture2D gTerrainMask1Texture : register(t6);
Texture2D gTerrainMask2Texture : register(t7);
Texture2D gTerrainMask3Texture : register(t8);

Texture2D gTerrainLayer1DiffuseTexture  : register(t9);
Texture2D gTerrainLayer2DiffuseTexture  : register(t10);
Texture2D gTerrainLayer3DiffuseTexture  : register(t11);
Texture2D gTerrainLayer4DiffuseTexture  : register(t12);
Texture2D gTerrainLayer5DiffuseTexture  : register(t13);
Texture2D gTerrainLayer6DiffuseTexture  : register(t14);
Texture2D gTerrainLayer7DiffuseTexture  : register(t15);
Texture2D gTerrainLayer8DiffuseTexture  : register(t16);
Texture2D gTerrainLayer9DiffuseTexture  : register(t17);
Texture2D gTerrainLayer10DiffuseTexture : register(t18);
Texture2D gTerrainLayer11DiffuseTexture : register(t19);
Texture2D gTerrainLayer12DiffuseTexture : register(t20);

Texture2D gTerrainAtlasDiffuseTexture : register(t21);
Texture2D gTerrainAtlasNormalTexture  : register(t22);

SamplerState gTerrainWrapSampler : register(s0);
SamplerState gTerrainClampSampler : register(s1);

struct VS_INPUT
{
	float3 Position : POSITION;
	float3 Normal : NORMAL;
};

struct VS_OUTPUT
{
	float4 Position : SV_POSITION;
	float3 WorldPos : TEXCOORD0;
	float3 Normal : TEXCOORD1;
};

struct PS_OUTPUT
{
	float4 Color : SV_Target0;
	float4 Normal : SV_Target1;
	float DepthLinear : SV_Target2;
	float4 Aux : SV_Target3;
};

float3 TerrainSafeNormalize(float3 Value, float3 Fallback)
{
	float LenSq = dot(Value, Value);

	if (LenSq <= 0.000001f)
		return Fallback;

	return Value * rsqrt(LenSq);
}

bool Terrain2MaskHasBit(float Bit)
{
	float Mask =
		gTerrainDebugParams.z;

	return fmod(
		floor(Mask / Bit),
		2.0f
	) >= 1.0f;
}

bool Terrain2HasColorTexture()
{
	return Terrain2MaskHasBit(1.0f);
}

bool Terrain2HasNormalTexture()
{
	return Terrain2MaskHasBit(2.0f);
}

bool Terrain2HasHeightTexture()
{
	return Terrain2MaskHasBit(4.0f);
}

bool Terrain2HasLayer0DiffuseTexture()
{
	return Terrain2MaskHasBit(8.0f);
}

bool Terrain2HasLayer0NormalTexture()
{
	return Terrain2MaskHasBit(16.0f);
}

bool Terrain2HasMask0Texture()
{
	return Terrain2MaskHasBit(32.0f);
}

bool Terrain2HasLayer1DiffuseTexture()
{
	return Terrain2MaskHasBit(64.0f);
}

bool Terrain2HasLayer2DiffuseTexture()
{
	return Terrain2MaskHasBit(128.0f);
}

bool Terrain2HasLayer3DiffuseTexture()
{
	return Terrain2MaskHasBit(256.0f);
}

bool Terrain2HasAtlasDiffuseTexture()
{
	return Terrain2MaskHasBit(512.0f);
}

bool Terrain2HasAtlasNormalTexture()
{
	return Terrain2MaskHasBit(1024.0f);
}

float2 Terrain2GetLayerUV(float3 WorldPos, float2 Scale)
{
	// Terrain2::ShaderScale is stored as Scale * 0.5 / terrainSize.
	// The DX9 atlas VS multiplies world position by 2 * ShaderScale.
	return float2(
		WorldPos.x * Scale.x * 2.0f,
		WorldPos.z * Scale.y * 2.0f
	);
}

float2 Terrain2GetLayerUVByIndex(float3 WorldPos, int LayerIndex)
{
	return Terrain2GetLayerUV(
		WorldPos,
		gTerrainLayerScale[LayerIndex].xy
	);
}

float2 Terrain2GetLayer0UV(float3 WorldPos)
{
	return Terrain2GetLayerUVByIndex(
		WorldPos,
		0
	);
}

float2 Terrain2GetTerrainUV(float3 WorldPos)
{
	return saturate(
		float2(
			WorldPos.x * gTerrainSize.z,
			WorldPos.z * gTerrainSize.w
		)
	);
}

float2 Terrain2GetHeightUV(float3 WorldPos)
{
	uint Width = 1;
	uint Height = 1;

	gTerrainHeightTexture.GetDimensions(
		Width,
		Height
	);

	float2 HalfTexel =
		0.5f /
		max(
			float2(
				(float)Width,
				(float)Height
			),
			float2(1.0f, 1.0f)
		);

	return saturate(
		Terrain2GetTerrainUV(WorldPos) +
		HalfTexel
	);
}

float2 Terrain2GetMaskUV(float3 WorldPos)
{
	return Terrain2GetTerrainUV(
		WorldPos
	);
}

float2 Terrain2GetAtlasUV(float3 WorldPos)
{
	float InvWorldDim =
		gTerrainAtlasWorld.w;

	float2 Local01 =
		saturate(
			float2(
				(WorldPos.x - gTerrainAtlasWorld.x) * InvWorldDim,
				(WorldPos.z - gTerrainAtlasWorld.y) * InvWorldDim
			)
		);

	float2 LocalSigned =
		Local01 * 2.0f - 1.0f;

	return LocalSigned * gTerrainAtlasTexTransform.xy +
		gTerrainAtlasTexTransform.zw;
}

VS_OUTPUT VSMain(VS_INPUT Input)
{
	VS_OUTPUT Output;

	float3 WorldPos = Input.Position;

	// Terrain V3/native DX11 terrain sends final world-space CPU heightfield
	// vertices. Re-snapping geometry from the height texture causes filtering
	// mismatch on chunk borders and visible LOD/seam tearing.
	const bool AllowTextureHeightSnap = false;
	if (AllowTextureHeightSnap && Terrain2HasHeightTexture())
	{
		float Height01 =
			gTerrainHeightTexture.SampleLevel(
				gTerrainClampSampler,
				Terrain2GetHeightUV(WorldPos),
				0.0f
			).r;

		WorldPos.y =
			gTerrainDebugParams.x +
			Height01 * gTerrainDebugParams.y;
	}

	Output.WorldPos = WorldPos;
	Output.Normal = TerrainSafeNormalize(
		Input.Normal,
		float3(0.0f, 1.0f, 0.0f)
	);
	Output.Position = mul(float4(WorldPos, 1.0f), gViewProj);

	return Output;
}

float3 Terrain2SampleLayerDiffuse(
	int LayerIndex,
	float3 WorldPos,
	float3 TerrainColorMod
)
{
	float2 UV =
		Terrain2GetLayerUVByIndex(
			WorldPos,
			LayerIndex
		);

	float3 Color = float3(0.0f, 0.0f, 0.0f);

	if (LayerIndex == 0)
	{
		Color =
			gTerrainLayer0DiffuseTexture.Sample(
				gTerrainWrapSampler,
				UV
			).rgb;
	}
	else if (LayerIndex == 1)
	{
		Color =
			gTerrainLayer1DiffuseTexture.Sample(
				gTerrainWrapSampler,
				UV
			).rgb;
	}
	else if (LayerIndex == 2)
	{
		Color =
			gTerrainLayer2DiffuseTexture.Sample(
				gTerrainWrapSampler,
				UV
			).rgb;
	}
	else if (LayerIndex == 3)
	{
		Color =
			gTerrainLayer3DiffuseTexture.Sample(
				gTerrainWrapSampler,
				UV
			).rgb;
	}
	else if (LayerIndex == 4)
	{
		Color =
			gTerrainLayer4DiffuseTexture.Sample(
				gTerrainWrapSampler,
				UV
			).rgb;
	}
	else if (LayerIndex == 5)
	{
		Color =
			gTerrainLayer5DiffuseTexture.Sample(
				gTerrainWrapSampler,
				UV
			).rgb;
	}
	else if (LayerIndex == 6)
	{
		Color =
			gTerrainLayer6DiffuseTexture.Sample(
				gTerrainWrapSampler,
				UV
			).rgb;
	}
	else if (LayerIndex == 7)
	{
		Color =
			gTerrainLayer7DiffuseTexture.Sample(
				gTerrainWrapSampler,
				UV
			).rgb;
	}
	else if (LayerIndex == 8)
	{
		Color =
			gTerrainLayer8DiffuseTexture.Sample(
				gTerrainWrapSampler,
				UV
			).rgb;
	}
	else if (LayerIndex == 9)
	{
		Color =
			gTerrainLayer9DiffuseTexture.Sample(
				gTerrainWrapSampler,
				UV
			).rgb;
	}
	else if (LayerIndex == 10)
	{
		Color =
			gTerrainLayer10DiffuseTexture.Sample(
				gTerrainWrapSampler,
				UV
			).rgb;
	}
	else if (LayerIndex == 11)
	{
		Color =
			gTerrainLayer11DiffuseTexture.Sample(
				gTerrainWrapSampler,
				UV
			).rgb;
	}
	else if (LayerIndex == 12)
	{
		Color =
			gTerrainLayer12DiffuseTexture.Sample(
				gTerrainWrapSampler,
				UV
			).rgb;
	}

	return Color * TerrainColorMod;
}

PS_OUTPUT PSMain(VS_OUTPUT Input)
{
	PS_OUTPUT Output;

	float HeightTint =
	saturate(
		(Input.WorldPos.y - gCameraPos.y + gTerrainDebugParams.x) *
		gTerrainDebugParams.y
	);

	float CameraDistance =
		length(Input.WorldPos - gCameraPos.xyz);

	float DepthLinear =
		saturate(CameraDistance / max(gNearFar.y, 1.0f));

	float3 Normal = TerrainSafeNormalize(
		Input.Normal,
		float3(0.0f, 1.0f, 0.0f)
	);

	if (Terrain2HasNormalTexture())
	{
		Normal =
			TerrainSafeNormalize(
				gTerrainNormalTexture.Sample(
					gTerrainClampSampler,
					Terrain2GetTerrainUV(
						Input.WorldPos
					)
				).xyz * 2.0f - 1.0f,
				Normal
			);
	}

	float Slope = saturate(1.0f - Normal.y);

	float3 DebugColor = float3(
		gTerrainBaseColor.r + Slope * gTerrainColorScale.r,
		gTerrainBaseColor.g + HeightTint * gTerrainColorScale.g,
		gTerrainBaseColor.b + Normal.y * gTerrainColorScale.b
	);

	float3 FinalColor = DebugColor;
	float3 TerrainColorMod = float3(
		1.0f,
		1.0f,
		1.0f
	);

	if (Terrain2HasColorTexture())
	{
		TerrainColorMod =
			gTerrainColorTexture.Sample(
				gTerrainClampSampler,
				Terrain2GetTerrainUV(
					Input.WorldPos
				)
			).rgb;
	}

	float3 MaskDebug = float3(0.0f, 0.0f, 0.0f);
	float MaskSumDebug = 0.0f;

	if (Terrain2HasLayer0DiffuseTexture())
	{
	float2 MaskUV =
		Terrain2GetMaskUV(
			Input.WorldPos
		);

	float3 Mask0 =
		saturate(
			gTerrainMask0Texture.Sample(
				gTerrainClampSampler,
				MaskUV
			).rgb
		);

	float3 Mask1 =
		saturate(
			gTerrainMask1Texture.Sample(
				gTerrainClampSampler,
				MaskUV
			).rgb
		);

	float3 Mask2 =
		saturate(
			gTerrainMask2Texture.Sample(
				gTerrainClampSampler,
				MaskUV
			).rgb
		);

	float3 Mask3 =
		saturate(
			gTerrainMask3Texture.Sample(
				gTerrainClampSampler,
				MaskUV
			).rgb
		);

	// layer0 = base
	// layer1..3   = mask0.rgb
	// layer4..6   = mask1.rgb
	// layer7..9   = mask2.rgb
	// layer10..12 = mask3.rgb
	float W1  = Mask0.r;
	float W2  = Mask0.g;
	float W3  = Mask0.b;

	float W4  = Mask1.r;
	float W5  = Mask1.g;
	float W6  = Mask1.b;

	float W7  = Mask2.r;
	float W8  = Mask2.g;
	float W9  = Mask2.b;

	float W10 = Mask3.r;
	float W11 = Mask3.g;
	float W12 = Mask3.b;

	float PaintedSum =
		W1 + W2 + W3 +
		W4 + W5 + W6 +
		W7 + W8 + W9 +
		W10 + W11 + W12;

	float3 BlendColor =
		Terrain2SampleLayerDiffuse(
			0,
			Input.WorldPos,
			float3(1.0f, 1.0f, 1.0f)
		);

	// Terrain2 generates its atlas by alpha-compositing painted layers in
	// order. Reproduce that behavior for the non-atlas fallback as well.
	BlendColor = lerp(
		BlendColor,
		Terrain2SampleLayerDiffuse(
			1,
			Input.WorldPos,
			float3(1.0f, 1.0f, 1.0f)
		),
		W1
	);
	BlendColor = lerp(
		BlendColor,
		Terrain2SampleLayerDiffuse(
			2,
			Input.WorldPos,
			float3(1.0f, 1.0f, 1.0f)
		),
		W2
	);
	BlendColor = lerp(
		BlendColor,
		Terrain2SampleLayerDiffuse(
			3,
			Input.WorldPos,
			float3(1.0f, 1.0f, 1.0f)
		),
		W3
	);
	BlendColor = lerp(
		BlendColor,
		Terrain2SampleLayerDiffuse(
			4,
			Input.WorldPos,
			float3(1.0f, 1.0f, 1.0f)
		),
		W4
	);
	BlendColor = lerp(
		BlendColor,
		Terrain2SampleLayerDiffuse(
			5,
			Input.WorldPos,
			float3(1.0f, 1.0f, 1.0f)
		),
		W5
	);
	BlendColor = lerp(
		BlendColor,
		Terrain2SampleLayerDiffuse(
			6,
			Input.WorldPos,
			float3(1.0f, 1.0f, 1.0f)
		),
		W6
	);
	BlendColor = lerp(
		BlendColor,
		Terrain2SampleLayerDiffuse(
			7,
			Input.WorldPos,
			float3(1.0f, 1.0f, 1.0f)
		),
		W7
	);
	BlendColor = lerp(
		BlendColor,
		Terrain2SampleLayerDiffuse(
			8,
			Input.WorldPos,
			float3(1.0f, 1.0f, 1.0f)
		),
		W8
	);
	BlendColor = lerp(
		BlendColor,
		Terrain2SampleLayerDiffuse(
			9,
			Input.WorldPos,
			float3(1.0f, 1.0f, 1.0f)
		),
		W9
	);
	BlendColor = lerp(
		BlendColor,
		Terrain2SampleLayerDiffuse(
			10,
			Input.WorldPos,
			float3(1.0f, 1.0f, 1.0f)
		),
		W10
	);
	BlendColor = lerp(
		BlendColor,
		Terrain2SampleLayerDiffuse(
			11,
			Input.WorldPos,
			float3(1.0f, 1.0f, 1.0f)
		),
		W11
	);
	BlendColor = lerp(
		BlendColor,
		Terrain2SampleLayerDiffuse(
			12,
			Input.WorldPos,
			float3(1.0f, 1.0f, 1.0f)
		),
		W12
	);

	FinalColor = saturate(BlendColor * TerrainColorMod);

	// Debug preview.
	// RGB shows combined weights from all 4 mask textures.
	MaskDebug =
		saturate(
			float3(
				W1 + W4 + W7 + W10,
				W2 + W5 + W8 + W11,
				W3 + W6 + W9 + W12
			)
		);

	MaskSumDebug =
		saturate(
			PaintedSum
		);
	}

	if (Terrain2HasAtlasDiffuseTexture())
	{
		float2 AtlasUV =
			Terrain2GetAtlasUV(
				Input.WorldPos
			);

		FinalColor =
			gTerrainAtlasDiffuseTexture.Sample(
				gTerrainClampSampler,
				AtlasUV
			).rgb;

		if (Terrain2HasAtlasNormalTexture())
		{
			Normal =
				TerrainSafeNormalize(
					gTerrainAtlasNormalTexture.Sample(
						gTerrainClampSampler,
						AtlasUV
					).xyz * 2.0f - 1.0f,
					Normal
				);
		}
	}

	Output.Color = float4(
		FinalColor,
		1.0f
	);
	
	Output.Normal = float4(Normal * 0.5f + 0.5f, 1.0f);
	Output.DepthLinear = DepthLinear;
	Output.Aux = float4(
		MaskDebug.r,
		MaskDebug.g,
		MaskDebug.b,
		MaskSumDebug
	);

	return Output;
}
