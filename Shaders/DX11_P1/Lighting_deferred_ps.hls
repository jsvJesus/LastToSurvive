#pragma pack_matrix(row_major)

Texture2D GBufferColor       : register(t0);
Texture2D GBufferNormal      : register(t1);
Texture2D GBufferLinearDepth : register(t2);
Texture2D GBufferAux         : register(t3);

Texture2D ShadowMap0         : register(t4);
Texture2D ShadowMap1         : register(t5);
Texture2D ShadowMap2         : register(t6);
Texture2D ShadowMap3         : register(t7);
Texture2D TransparentShadowMap : register(t8);

SamplerState LinearClampSampler : register(s0);
SamplerState ShadowSampler      : register(s1);

#define DX11_LIGHT_POINT 1.0f
#define DX11_LIGHT_SPOT  2.0f
#define DX11_MAX_DEFERRED_LIGHTS 64
#define DX11_MAX_SHADOW_SLICES 4

cbuffer LightingFrameConstants : register(b0)
{
	float4x4 gInvViewProj;

	float4 gCameraPos;
	float4 gCameraForward;

	float4 gSunDirection;
	float4 gSunColorIntensity;

	float4 gAmbientColorIntensity;
	float4 gProbeColorIntensity;

	float4 gFogColorDensity;
	float4 gFogParams;

	float4 gScreenSize;

	// x = opaque shadow enabled
	// y = opaque cascade count
	// z = transparent shadow enabled
	// w = opaque shadow strength
	float4 gShadowParams;

	float4x4 gShadowViewProj[DX11_MAX_SHADOW_SLICES];

	// x = split near
	// y = split far
	// z = compare bias
	// w = shadow texel size
	float4 gShadowCascadeParams[DX11_MAX_SHADOW_SLICES];

	float4x4 gTransparentShadowViewProj;

	// x = compare bias
	// y = texel size
	// z = strength
	// w = enabled
	float4 gTransparentShadowParams;

	// x = debug mode
	// y = ambient/probe enabled
	// z = fog enabled
	// w = spec/gloss enabled
	float4 gOptions;
};

struct DX11ShaderLight
{
	float4 PositionRadius;
	float4 ColorIntensity;
	float4 DirectionAngles;
	float4 Params;
};

cbuffer LightingLightConstants : register(b1)
{
	float4 gLightCount;
	DX11ShaderLight gLights[DX11_MAX_DEFERRED_LIGHTS];
};

struct PS_INPUT
{
	float4 Position : SV_POSITION;
	float2 TexCoord : TEXCOORD0;
};

float3 SafeNormalize(float3 v, float3 fallback)
{
	float lenSq = dot(v, v);

	if (lenSq < 0.000001f)
		return fallback;

	return v * rsqrt(lenSq);
}

float3 DecodeNormal(float4 packedNormal)
{
	float3 normal = packedNormal.xyz * 2.0f - 1.0f;
	return SafeNormalize(normal, float3(0.0f, 1.0f, 0.0f));
}

float DecodeGloss(float4 aux)
{
	return saturate(aux.r);
}

float DecodeSpecular(float4 aux)
{
	return saturate(aux.g);
}

float3 ReconstructWorld(float2 uv, float deviceDepth)
{
	float2 ndc = uv * 2.0f - 1.0f;
	ndc.y = -ndc.y;

	float4 clipPos = float4(ndc, deviceDepth, 1.0f);
	float4 worldPos = mul(clipPos, gInvViewProj);

	if (abs(worldPos.w) > 0.00001f)
		worldPos.xyz /= worldPos.w;

	return worldPos.xyz;
}

float SampleShadowMap(int shadowIndex, float2 uv)
{
	if (shadowIndex == 0)
		return ShadowMap0.SampleLevel(ShadowSampler, uv, 0).r;

	if (shadowIndex == 1)
		return ShadowMap1.SampleLevel(ShadowSampler, uv, 0).r;

	if (shadowIndex == 2)
		return ShadowMap2.SampleLevel(ShadowSampler, uv, 0).r;

	return ShadowMap3.SampleLevel(ShadowSampler, uv, 0).r;
}

float ComputeProjectedShadowPCF(
	int shadowIndex,
	float4 shadowClip,
	float compareBias,
	float texelSize
)
{
	if (shadowClip.w <= 0.00001f)
		return 1.0f;

	float3 shadowNdc =
		shadowClip.xyz / shadowClip.w;

	float2 shadowUV =
		shadowNdc.xy * float2(0.5f, -0.5f) + 0.5f;

	if (
		shadowUV.x <= 0.001f ||
		shadowUV.y <= 0.001f ||
		shadowUV.x >= 0.999f ||
		shadowUV.y >= 0.999f ||
		shadowNdc.z <= 0.0f ||
		shadowNdc.z >= 1.0f
	)
	{
		return 1.0f;
	}

	float receiverDepth =
		shadowNdc.z - compareBias;

	float visibility = 0.0f;

	[unroll]
	for (int y = -1; y <= 1; ++y)
	{
		[unroll]
		for (int x = -1; x <= 1; ++x)
		{
			float2 sampleUV =
				shadowUV +
				float2(
					(float)x,
					(float)y
				) * texelSize;

			float shadowDepth =
				SampleShadowMap(
					shadowIndex,
					sampleUV
				);

			visibility +=
				receiverDepth <= shadowDepth
					? 1.0f
					: 0.0f;
		}
	}

	return visibility / 9.0f;
}

float ComputeTransparentShadowPCF(
	float4 shadowClip,
	float compareBias,
	float texelSize
)
{
	if (shadowClip.w <= 0.00001f)
		return 1.0f;

	float3 shadowNdc =
		shadowClip.xyz / shadowClip.w;

	float2 shadowUV =
		shadowNdc.xy * float2(0.5f, -0.5f) + 0.5f;

	if (
		shadowUV.x <= 0.001f ||
		shadowUV.y <= 0.001f ||
		shadowUV.x >= 0.999f ||
		shadowUV.y >= 0.999f ||
		shadowNdc.z <= 0.0f ||
		shadowNdc.z >= 1.0f
	)
	{
		return 1.0f;
	}

	float receiverDepth =
		shadowNdc.z - compareBias;

	float visibility = 0.0f;

	[unroll]
	for (int y = -1; y <= 1; ++y)
	{
		[unroll]
		for (int x = -1; x <= 1; ++x)
		{
			float2 sampleUV =
				shadowUV +
				float2(
					(float)x,
					(float)y
				) * texelSize;

			float shadowDepth =
				TransparentShadowMap.SampleLevel(
					ShadowSampler,
					sampleUV,
					0
				).r;

			visibility +=
				receiverDepth <= shadowDepth
					? 1.0f
					: 0.0f;
		}
	}

	return visibility / 9.0f;
}

int SelectShadowCascade(float3 worldPos)
{
	if (gShadowParams.x <= 0.0f)
		return -1;

	int cascadeCount =
		min(
			(int)(gShadowParams.y + 0.5f),
			DX11_MAX_SHADOW_SLICES
		);

	if (cascadeCount <= 0)
		return -1;

	float viewDepth =
		dot(
			worldPos - gCameraPos.xyz,
			SafeNormalize(
				gCameraForward.xyz,
				float3(0.0f, 0.0f, 1.0f)
			)
		);

	if (viewDepth <= 0.0f)
		return -1;

	[unroll]
	for (int i = 0; i < DX11_MAX_SHADOW_SLICES; ++i)
	{
		if (i >= cascadeCount)
			break;

		float splitNear =
			gShadowCascadeParams[i].x;

		float splitFar =
			gShadowCascadeParams[i].y;

		if (
			splitFar > splitNear &&
			viewDepth >= splitNear &&
			viewDepth <= splitFar
		)
		{
			return i;
		}
	}

	return -1;
}

float ComputeOpaqueShadowFactor(float3 worldPos)
{
	int cascadeIndex =
		SelectShadowCascade(worldPos);

	if (cascadeIndex < 0)
		return 1.0f;

	float4 shadowClip =
		mul(
			float4(worldPos, 1.0f),
			gShadowViewProj[cascadeIndex]
		);

	float visibility =
		ComputeProjectedShadowPCF(
			cascadeIndex,
			shadowClip,
			gShadowCascadeParams[cascadeIndex].z,
			gShadowCascadeParams[cascadeIndex].w
		);

	return lerp(
		1.0f,
		visibility,
		saturate(gShadowParams.w)
	);
}

float ComputeTransparentShadowFactor(float3 worldPos)
{
	if (
		gShadowParams.z <= 0.0f ||
		gTransparentShadowParams.w <= 0.0f
	)
	{
		return 1.0f;
	}

	float4 shadowClip =
		mul(
			float4(worldPos, 1.0f),
			gTransparentShadowViewProj
		);

	float visibility =
		ComputeTransparentShadowPCF(
			shadowClip,
			gTransparentShadowParams.x,
			gTransparentShadowParams.y
		);

	return lerp(
		1.0f,
		visibility,
		saturate(gTransparentShadowParams.z)
	);
}

float ComputeShadowFactor(float3 worldPos)
{
	float opaqueShadow =
		ComputeOpaqueShadowFactor(worldPos);

	float transparentShadow =
		ComputeTransparentShadowFactor(worldPos);

	return saturate(
		opaqueShadow *
		transparentShadow
	);
}

float3 ApplyDirectionalLight(
	float3 albedo,
	float3 normal,
	float3 viewDir,
	float specular,
	float gloss,
	float shadowFactor
)
{
	float3 lightDir =
		SafeNormalize(
			-gSunDirection.xyz,
			float3(0.0f, 1.0f, 0.0f)
		);

	float ndotl =
		saturate(dot(normal, lightDir));

	float3 diffuse =
		albedo *
		gSunColorIntensity.rgb *
		gSunColorIntensity.a *
		ndotl *
		shadowFactor;

	float3 halfVec =
		SafeNormalize(
			lightDir + viewDir,
			normal
		);

	float specPow =
		lerp(
			16.0f,
			128.0f,
			gloss
		);

	float specTerm =
		pow(
			saturate(dot(normal, halfVec)),
			specPow
		) *
		specular *
		gOptions.w *
		shadowFactor;

	float3 specColor =
		gSunColorIntensity.rgb *
		specTerm *
		gSunColorIntensity.a;

	return diffuse + specColor;
}

float3 ApplyPointLight(
	DX11ShaderLight light,
	float3 worldPos,
	float3 albedo,
	float3 normal,
	float3 viewDir,
	float specular,
	float gloss
)
{
	float3 toLight =
		light.PositionRadius.xyz - worldPos;

	float distanceSq =
		dot(toLight, toLight);

	float radius =
		max(light.PositionRadius.w, 0.001f);

	if (distanceSq > radius * radius)
		return 0.0f;

	float distance =
		sqrt(max(distanceSq, 0.0001f));

	float3 lightDir =
		toLight / distance;

	float attenuation =
		saturate(1.0f - distance / radius);

	attenuation *= attenuation;

	float ndotl =
		saturate(dot(normal, lightDir));

	float3 diffuse =
		albedo *
		light.ColorIntensity.rgb *
		light.ColorIntensity.a *
		ndotl *
		attenuation;

	float3 halfVec =
		SafeNormalize(
			lightDir + viewDir,
			normal
		);

	float specPow =
		lerp(
			16.0f,
			128.0f,
			gloss
		);

	float specTerm =
		pow(
			saturate(dot(normal, halfVec)),
			specPow
		) *
		specular *
		gOptions.w *
		attenuation *
		light.ColorIntensity.a;

	float3 specColor =
		light.ColorIntensity.rgb *
		specTerm;

	return diffuse + specColor;
}

float3 ApplySpotLight(
	DX11ShaderLight light,
	float3 worldPos,
	float3 albedo,
	float3 normal,
	float3 viewDir,
	float specular,
	float gloss
)
{
	float3 toLight =
		light.PositionRadius.xyz - worldPos;

	float distanceSq =
		dot(toLight, toLight);

	float radius =
		max(light.PositionRadius.w, 0.001f);

	if (distanceSq > radius * radius)
		return 0.0f;

	float distance =
		sqrt(max(distanceSq, 0.0001f));

	float3 lightDir =
		toLight / distance;

	float3 spotDir =
		SafeNormalize(
			light.DirectionAngles.xyz,
			float3(0.0f, -1.0f, 0.0f)
		);

	float cosAngle =
		dot(-lightDir, spotDir);

	float innerCos =
		light.DirectionAngles.w;

	float outerCos =
		light.Params.y;

	float spotRange =
		max(innerCos - outerCos, 0.001f);

	float spot =
		saturate((cosAngle - outerCos) / spotRange);

	spot =
		pow(
			spot,
			max(light.Params.z, 0.01f)
		);

	float attenuation =
		saturate(1.0f - distance / radius);

	attenuation *= attenuation;
	attenuation *= spot;

	float ndotl =
		saturate(dot(normal, lightDir));

	float3 diffuse =
		albedo *
		light.ColorIntensity.rgb *
		light.ColorIntensity.a *
		ndotl *
		attenuation;

	float3 halfVec =
		SafeNormalize(
			lightDir + viewDir,
			normal
		);

	float specPow =
		lerp(
			16.0f,
			128.0f,
			gloss
		);

	float specTerm =
		pow(
			saturate(dot(normal, halfVec)),
			specPow
		) *
		specular *
		gOptions.w *
		attenuation *
		light.ColorIntensity.a *
		light.Params.w;

	float3 specColor =
		light.ColorIntensity.rgb *
		specTerm;

	return diffuse + specColor;
}

float3 ApplyFog(float3 color, float deviceDepth)
{
	if (gOptions.z <= 0.0f)
		return color;

	float fogStart =
		gFogParams.x;

	float fogEnd =
		max(
			gFogParams.y,
			fogStart + 1.0f
		);

	float fogT =
		saturate(
			(deviceDepth * fogEnd - fogStart) /
			(fogEnd - fogStart)
		);

	fogT =
		saturate(
			fogT *
			gFogColorDensity.a
		);

	return lerp(
		color,
		gFogColorDensity.rgb,
		fogT
	);
}

float3 ApplyLocalLights(
	float3 worldPos,
	float3 albedo,
	float3 normal,
	float3 viewDir,
	float specular,
	float gloss
)
{
	float3 result = 0.0f;

	int lightCount =
		min(
			(int)gLightCount.x,
			DX11_MAX_DEFERRED_LIGHTS
		);

	[loop]
	for (int i = 0; i < lightCount; ++i)
	{
		DX11ShaderLight light =
			gLights[i];

		if (light.Params.x == DX11_LIGHT_POINT)
		{
			result +=
				ApplyPointLight(
					light,
					worldPos,
					albedo,
					normal,
					viewDir,
					specular,
					gloss
				);
		}
		else if (light.Params.x == DX11_LIGHT_SPOT)
		{
			result +=
				ApplySpotLight(
					light,
					worldPos,
					albedo,
					normal,
					viewDir,
					specular,
					gloss
				);
		}
	}

	return result;
}

float3 ApplyTemporaryToneMap(float3 color)
{
	color = max(color, 0.0f);

	color *= 0.38f;

	color =
		color /
		(1.0f + color);

	color =
		pow(
			saturate(color),
			1.0f / 2.2f
		);

	return saturate(color);
}

float4 main(PS_INPUT input) : SV_Target
{
	float2 uv =
		input.TexCoord;

	float4 gColor =
		GBufferColor.Sample(
			LinearClampSampler,
			uv
		);

	float4 gNormal =
		GBufferNormal.Sample(
			LinearClampSampler,
			uv
		);

	float4 gDepth =
		GBufferLinearDepth.Sample(
			LinearClampSampler,
			uv
		);

	float4 gAux =
		GBufferAux.Sample(
			LinearClampSampler,
			uv
		);

	float3 albedo =
		saturate(gColor.rgb);

	float3 normal =
		DecodeNormal(gNormal);

	float deviceDepth =
		saturate(gDepth.r);

	float3 worldPos =
		ReconstructWorld(
			uv,
			deviceDepth
		);

	float3 viewDir =
		SafeNormalize(
			gCameraPos.xyz - worldPos,
			float3(0.0f, 0.0f, 1.0f)
		);

	float gloss =
		DecodeGloss(gAux);

	float specular =
		DecodeSpecular(gAux);

	float shadowFactor =
		ComputeShadowFactor(worldPos);

	float3 ambientLight = 0.0f;

	if (gOptions.y > 0.0f)
	{
		ambientLight +=
			albedo *
			gAmbientColorIntensity.rgb *
			gAmbientColorIntensity.a;

		ambientLight +=
			albedo *
			gProbeColorIntensity.rgb *
			gProbeColorIntensity.a;
	}

	float3 directLight =
		ApplyDirectionalLight(
			albedo,
			normal,
			viewDir,
			specular,
			gloss,
			shadowFactor
		);

	float3 localLights =
		ApplyLocalLights(
			worldPos,
			albedo,
			normal,
			viewDir,
			specular,
			gloss
		);

	float3 finalColor =
		ambientLight +
		directLight +
		localLights;

	finalColor =
		ApplyFog(
			finalColor,
			deviceDepth
		);

	int debugMode =
		(int)(gOptions.x + 0.5f);

	if (debugMode == 1)
		return float4(albedo, 1.0f);

	if (debugMode == 2)
		return float4(normal * 0.5f + 0.5f, 1.0f);

	if (debugMode == 3)
		return float4(deviceDepth.xxx, 1.0f);

	if (debugMode == 4)
		return float4(gloss, specular, gAux.b, 1.0f);

	if (debugMode == 5)
		return float4(saturate(directLight + localLights), 1.0f);

	if (debugMode == 6)
		return float4(saturate(ambientLight), 1.0f);

	if (debugMode == 7)
		return float4(shadowFactor.xxx, 1.0f);

	return float4(
		ApplyTemporaryToneMap(finalColor),
		1.0f
	);
}