#pragma pack_matrix(row_major)

Texture2D GBufferColor       : register(t0);
Texture2D GBufferNormal      : register(t1);
Texture2D GBufferLinearDepth : register(t2);
Texture2D GBufferAux         : register(t3);

SamplerState LinearClampSampler : register(s0);

#define DX11_LIGHT_POINT 1.0f
#define DX11_LIGHT_SPOT  2.0f
#define DX11_MAX_DEFERRED_LIGHTS 64

cbuffer LightingFrameConstants : register(b0)
{
	float4x4 gInvViewProj;

	float4 gCameraPos;

	float4 gSunDirection;
	float4 gSunColorIntensity;

	float4 gAmbientColorIntensity;
	float4 gProbeColorIntensity;

	float4 gFogColorDensity;
	float4 gFogParams;

	float4 gScreenSize;

	float4 gShadowParams;

	// x = debug mode
	// y = ambient/probe enabled
	// z = fog enabled
	// w = spec/gloss enabled
	float4 gOptions;
};

struct DX11ShaderLight
{
	float4 PositionRadius;
	float4 ColorIntensity;
	float4 DirectionAngles;
	float4 Params;
};

cbuffer LightingLightConstants : register(b1)
{
	float4 gLightCount;
	DX11ShaderLight gLights[DX11_MAX_DEFERRED_LIGHTS];
};

struct PS_INPUT
{
	float4 Position : SV_POSITION;
	float2 TexCoord : TEXCOORD0;
};

float3 SafeNormalize(float3 v, float3 fallback)
{
	float lenSq = dot(v, v);

	if (lenSq < 0.000001f)
		return fallback;

	return v * rsqrt(lenSq);
}

float3 DecodeNormal(float4 packedNormal)
{
	float3 normal = packedNormal.xyz * 2.0f - 1.0f;
	return SafeNormalize(normal, float3(0.0f, 1.0f, 0.0f));
}

float DecodeGloss(float4 aux)
{
	return saturate(aux.r);
}

float DecodeSpecular(float4 aux)
{
	return saturate(aux.g);
}

float3 ReconstructWorld(float2 uv, float deviceDepth)
{
	float2 ndc = uv * 2.0f - 1.0f;
	ndc.y = -ndc.y;

	float4 clipPos = float4(ndc, deviceDepth, 1.0f);
	float4 worldPos = mul(clipPos, gInvViewProj);

	if (abs(worldPos.w) > 0.00001f)
		worldPos.xyz /= worldPos.w;

	return worldPos.xyz;
}

float3 ApplyDirectionalLight(
	float3 albedo,
	float3 normal,
	float3 viewDir,
	float specular,
	float gloss,
	float shadowFactor
)
{
	float3 lightDir = SafeNormalize(-gSunDirection.xyz, float3(0.0f, 1.0f, 0.0f));

	float ndotl = saturate(dot(normal, lightDir));

	float3 diffuse =
		albedo *
		gSunColorIntensity.rgb *
		gSunColorIntensity.a *
		ndotl *
		shadowFactor;

	float3 halfVec = SafeNormalize(lightDir + viewDir, normal);

	float specPow = lerp(16.0f, 128.0f, gloss);

	float specTerm =
		pow(saturate(dot(normal, halfVec)), specPow) *
		specular *
		gOptions.w *
		shadowFactor;

	float3 specColor =
		gSunColorIntensity.rgb *
		specTerm *
		gSunColorIntensity.a;

	return diffuse + specColor;
}

float3 ApplyPointLight(
	DX11ShaderLight light,
	float3 worldPos,
	float3 albedo,
	float3 normal,
	float3 viewDir,
	float specular,
	float gloss
)
{
	float3 toLight = light.PositionRadius.xyz - worldPos;
	float distanceSq = dot(toLight, toLight);
	float radius = max(light.PositionRadius.w, 0.001f);

	if (distanceSq > radius * radius)
		return 0.0f;

	float distance = sqrt(max(distanceSq, 0.0001f));
	float3 lightDir = toLight / distance;

	float attenuation = saturate(1.0f - distance / radius);
	attenuation *= attenuation;

	float ndotl = saturate(dot(normal, lightDir));

	float3 diffuse =
		albedo *
		light.ColorIntensity.rgb *
		light.ColorIntensity.a *
		ndotl *
		attenuation;

	float3 halfVec = SafeNormalize(lightDir + viewDir, normal);
	float specPow = lerp(16.0f, 128.0f, gloss);

	float specTerm =
		pow(saturate(dot(normal, halfVec)), specPow) *
		specular *
		gOptions.w *
		attenuation *
		light.ColorIntensity.a;

	float3 specColor =
		light.ColorIntensity.rgb *
		specTerm;

	return diffuse + specColor;
}

float3 ApplySpotLight(
	DX11ShaderLight light,
	float3 worldPos,
	float3 albedo,
	float3 normal,
	float3 viewDir,
	float specular,
	float gloss
)
{
	float3 toLight = light.PositionRadius.xyz - worldPos;
	float distanceSq = dot(toLight, toLight);
	float radius = max(light.PositionRadius.w, 0.001f);

	if (distanceSq > radius * radius)
		return 0.0f;

	float distance = sqrt(max(distanceSq, 0.0001f));
	float3 lightDir = toLight / distance;

	float3 spotDir = SafeNormalize(light.DirectionAngles.xyz, float3(0.0f, -1.0f, 0.0f));

	float cosAngle = dot(-lightDir, spotDir);
	float innerCos = light.DirectionAngles.w;
	float outerCos = light.Params.y;

	float spotRange = max(innerCos - outerCos, 0.001f);

	float spot = saturate((cosAngle - outerCos) / spotRange);
	spot = pow(spot, max(light.Params.z, 0.01f));

	float attenuation = saturate(1.0f - distance / radius);
	attenuation *= attenuation;
	attenuation *= spot;

	float ndotl = saturate(dot(normal, lightDir));

	float3 diffuse =
		albedo *
		light.ColorIntensity.rgb *
		light.ColorIntensity.a *
		ndotl *
		attenuation;

	float3 halfVec = SafeNormalize(lightDir + viewDir, normal);
	float specPow = lerp(16.0f, 128.0f, gloss);

	float specTerm =
		pow(saturate(dot(normal, halfVec)), specPow) *
		specular *
		gOptions.w *
		attenuation *
		light.ColorIntensity.a *
		light.Params.w;

	float3 specColor =
		light.ColorIntensity.rgb *
		specTerm;

	return diffuse + specColor;
}

float3 ApplyFog(float3 color, float deviceDepth)
{
	if (gOptions.z <= 0.0f)
		return color;

	float fogStart = gFogParams.x;
	float fogEnd = max(gFogParams.y, fogStart + 1.0f);

	float fogT = saturate((deviceDepth * fogEnd - fogStart) / (fogEnd - fogStart));
	fogT = saturate(fogT * gFogColorDensity.a);

	return lerp(color, gFogColorDensity.rgb, fogT);
}

float3 ApplyLocalLights(
	float3 worldPos,
	float3 albedo,
	float3 normal,
	float3 viewDir,
	float specular,
	float gloss
)
{
	float3 result = 0.0f;

	int lightCount = min((int)gLightCount.x, DX11_MAX_DEFERRED_LIGHTS);

	[loop]
	for (int i = 0; i < lightCount; ++i)
	{
		DX11ShaderLight light = gLights[i];

		if (light.Params.x == DX11_LIGHT_POINT)
		{
			result += ApplyPointLight(
				light,
				worldPos,
				albedo,
				normal,
				viewDir,
				specular,
				gloss
			);
		}
		else if (light.Params.x == DX11_LIGHT_SPOT)
		{
			result += ApplySpotLight(
				light,
				worldPos,
				albedo,
				normal,
				viewDir,
				specular,
				gloss
			);
		}
	}

	return result;
}

float3 ApplyTemporaryToneMap(float3 color)
{
	color = max(color, 0.0f);

	// Временная экспозиция для DX11 world path.
	// Потом это нужно будет вынести в нормальный post-process.
	color *= 0.38f;

	// Simple Reinhard tone map.
	color = color / (1.0f + color);

	// Gamma correction для обычного backbuffer.
	color = pow(saturate(color), 1.0f / 2.2f);

	return saturate(color);
}

float4 main(PS_INPUT input) : SV_Target
{
	float2 uv = input.TexCoord;

	float4 gColor = GBufferColor.Sample(LinearClampSampler, uv);
	float4 gNormal = GBufferNormal.Sample(LinearClampSampler, uv);
	float4 gDepth = GBufferLinearDepth.Sample(LinearClampSampler, uv);
	float4 gAux = GBufferAux.Sample(LinearClampSampler, uv);

	float3 albedo = saturate(gColor.rgb);
	float3 normal = DecodeNormal(gNormal);

	float deviceDepth = saturate(gDepth.r);
	float3 worldPos = ReconstructWorld(uv, deviceDepth);

	float3 viewDir = SafeNormalize(gCameraPos.xyz - worldPos, float3(0.0f, 0.0f, 1.0f));

	float gloss = DecodeGloss(gAux);
	float specular = DecodeSpecular(gAux);

	float shadowFactor = saturate(gShadowParams.x);

	float3 ambientLight = 0.0f;

	if (gOptions.y > 0.0f)
	{
		ambientLight +=
			albedo *
			gAmbientColorIntensity.rgb *
			gAmbientColorIntensity.a;

		ambientLight +=
			albedo *
			gProbeColorIntensity.rgb *
			gProbeColorIntensity.a;
	}

	float3 directLight =
		ApplyDirectionalLight(
			albedo,
			normal,
			viewDir,
			specular,
			gloss,
			shadowFactor
		);

	float3 localLights =
		ApplyLocalLights(
			worldPos,
			albedo,
			normal,
			viewDir,
			specular,
			gloss
		);

	float3 finalColor =
		ambientLight +
		directLight +
		localLights;

	finalColor = ApplyFog(finalColor, deviceDepth);

	int debugMode = (int)(gOptions.x + 0.5f);

	if (debugMode == 1)
		return float4(albedo, 1.0f);

	if (debugMode == 2)
		return float4(normal * 0.5f + 0.5f, 1.0f);

	if (debugMode == 3)
		return float4(deviceDepth.xxx, 1.0f);

	if (debugMode == 4)
		return float4(gloss, specular, gAux.b, 1.0f);

	if (debugMode == 5)
		return float4(saturate(directLight + localLights), 1.0f);

	if (debugMode == 6)
		return float4(saturate(ambientLight), 1.0f);

	return float4(ApplyTemporaryToneMap(finalColor), 1.0f);
}