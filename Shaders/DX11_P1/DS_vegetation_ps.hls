Texture2D DiffuseTexture       : register(t0);
Texture2D NormalTexture        : register(t1);
Texture2D GlossTexture         : register(t2);
Texture2D EnvPowerTexture      : register(t3);
Texture2D SelfIllumTexture     : register(t4);
Texture2D DetailNormalTexture  : register(t5);
Texture2D SSSTexture           : register(t6);
Texture2D SpecularPowerTexture : register(t7);

SamplerState MaterialSampler : register(s0);

cbuffer MaterialConstants : register(b0)
{
	float4 Material_Params;
	float4 Mat_Diffuse;
	float4 Mat_Specular;
	float4 Mat_Glow;
	float4 Mat_Options;
};

struct VegetationVSOutput
{
	float4 Position : SV_POSITION;
	float2 TexCoord : TEXCOORD0;
	float3 Normal : TEXCOORD1;
	float3 Tangent : TEXCOORD2;
	float3 Binormal : TEXCOORD3;
	float3 WorldPos : TEXCOORD4;
	float Depth : TEXCOORD5;
	float RandomColor : TEXCOORD6;
};

struct GBufferOutput
{
	float4 Color : SV_TARGET0;
	float4 Normal : SV_TARGET1;
	float4 Depth : SV_TARGET2;
	float4 Aux : SV_TARGET3;
};

float3 SafeNormalize(float3 v, float3 fallback)
{
	float lenSq = dot(v, v);

	if (lenSq < 0.000001f)
		return fallback;

	return v * rsqrt(lenSq);
}

float3 SampleNormal(float2 uv)
{
	float3 normalMap = NormalTexture.Sample(MaterialSampler, uv).xyz * 2.0f - 1.0f;

	float detailScale = max(Mat_Glow.z, 0.001f);
	float detailAmount = saturate(Mat_Glow.w);

	float3 detailNormal =
		DetailNormalTexture.Sample(MaterialSampler, uv * detailScale * 5.0f).xyz * 2.0f - 1.0f;

	normalMap.xy += detailNormal.xy * detailAmount * 2.0f;

	return SafeNormalize(normalMap, float3(0.0f, 0.0f, 1.0f));
}

GBufferOutput main(VegetationVSOutput input, bool isFrontFace : SV_IsFrontFace)
{
	GBufferOutput output;

	float3 geomNormal = SafeNormalize(input.Normal, float3(0.0f, 1.0f, 0.0f));

	if (!isFrontFace)
		geomNormal = -geomNormal;

	float4 diffuse = DiffuseTexture.Sample(MaterialSampler, input.TexCoord);

	clip(diffuse.a - Mat_Options.y);

	float randomValue = saturate(input.RandomColor);

	// Старые levels могут дать randomColor = 0.
	// Не даём растительности уйти в полностью чёрный GBuffer.
	float vegetationTint =
		randomValue <= 0.001f
			? 1.0f
			: lerp(0.75f, 1.15f, randomValue);

	diffuse.rgb *= Mat_Diffuse.rgb * vegetationTint;

	float4 glossSample = GlossTexture.Sample(MaterialSampler, input.TexCoord);

	float3 tangent = SafeNormalize(input.Tangent, float3(1.0f, 0.0f, 0.0f));
	float3 binormal = SafeNormalize(input.Binormal, cross(geomNormal, tangent));

	float3 tangentNormal = SampleNormal(input.TexCoord);

	float3 worldNormal =
		SafeNormalize(
			mul(
				tangentNormal,
				float3x3(
					tangent,
					binormal,
					geomNormal
				)
			),
			geomNormal
		);

	float selfIllum = SelfIllumTexture.Sample(MaterialSampler, input.TexCoord).r;
	float chromness = EnvPowerTexture.Sample(MaterialSampler, input.TexCoord).r * Material_Params.y;
	float sss = SSSTexture.Sample(MaterialSampler, input.TexCoord).g;

	float gloss = saturate(glossSample.r);

	// У растительности spec сильно режем, чтобы листья не горели.
	float specular =
		saturate(
			(Mat_Specular.r + Mat_Specular.g + Mat_Specular.b) *
			0.33333334f *
			0.08f
		);

	output.Color = float4(saturate(diffuse.rgb), saturate(diffuse.a));
	output.Normal = float4(worldNormal * 0.5f + 0.5f, saturate(selfIllum * Mat_Glow.x));
	output.Depth = float4(saturate(input.Depth), 0.0f, 0.0f, 0.0f);
	output.Aux = float4(gloss, specular, saturate(sss), saturate(chromness));

	return output;
}