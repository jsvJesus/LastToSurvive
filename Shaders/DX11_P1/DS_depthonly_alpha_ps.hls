Texture2D DiffuseTexture : register(t0);
SamplerState MaterialSampler : register(s0);

cbuffer MaterialConstants : register(b0)
{
	float4 Material_Params;
	float4 Mat_Diffuse;
	float4 Mat_Specular;
	float4 Mat_Glow;
	float4 Mat_Options;
};

struct DepthOnlyPSInput
{
	float4 Position : SV_POSITION;
	float2 TexCoord : TEXCOORD0;
};

void main(DepthOnlyPSInput input)
{
	float alpha = DiffuseTexture.Sample(MaterialSampler, input.TexCoord).a;
	clip(alpha - Mat_Options.y);
}
