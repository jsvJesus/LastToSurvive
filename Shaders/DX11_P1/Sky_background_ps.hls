#pragma pack_matrix(row_major)

cbuffer SkyConstants : register(b0)
{
	float4x4 gInvViewProj;

	float4 gCameraPos;

	float4 gSunDirection;
	float4 gSunColorIntensity;

	float4 gHorizonColor;
	float4 gZenithColor;

	float4 gFogColorDensity;
	float4 gCloudParams;

	float4 gMoonParams;
	float4 gOptions;
};

struct PS_INPUT
{
	float4 Position : SV_POSITION;
	float2 TexCoord : TEXCOORD0;
};

float3 SafeNormalize(float3 v, float3 fallback)
{
	float lenSq = dot(v, v);

	if (lenSq < 0.000001f)
		return fallback;

	return v * rsqrt(lenSq);
}

float Hash21(float2 p)
{
	p = frac(p * float2(123.34f, 456.21f));
	p += dot(p, p + 45.32f);
	return frac(p.x * p.y);
}

float Noise2(float2 uv)
{
	float2 i = floor(uv);
	float2 f = frac(uv);

	float a = Hash21(i);
	float b = Hash21(i + float2(1.0f, 0.0f));
	float c = Hash21(i + float2(0.0f, 1.0f));
	float d = Hash21(i + float2(1.0f, 1.0f));

	float2 u = f * f * (3.0f - 2.0f * f);

	return lerp(
		lerp(a, b, u.x),
		lerp(c, d, u.x),
		u.y
	);
}

float FBM(float2 uv)
{
	float value = 0.0f;
	float amp = 0.5f;

	value += Noise2(uv) * amp;
	uv *= 2.03f;
	amp *= 0.5f;

	value += Noise2(uv + 17.7f) * amp;
	uv *= 2.01f;
	amp *= 0.5f;

	value += Noise2(uv + 41.3f) * amp;
	uv *= 2.07f;
	amp *= 0.5f;

	value += Noise2(uv + 91.1f) * amp;

	return saturate(value);
}

float3 ReconstructWorldDirection(float2 uv)
{
	float2 ndc = uv * 2.0f - 1.0f;
	ndc.y = -ndc.y;

	float4 clipPos = float4(ndc, 1.0f, 1.0f);
	float4 worldPos = mul(clipPos, gInvViewProj);

	if (abs(worldPos.w) > 0.00001f)
		worldPos.xyz /= worldPos.w;

	return SafeNormalize(worldPos.xyz - gCameraPos.xyz, float3(0.0f, 0.0f, 1.0f));
}

float3 ApplySkyToneMap(float3 color)
{
	color = max(color, 0.0f);

	// Такой же временный LDR подход, как в текущем DX11 lighting.
	color *= 0.85f;
	color = color / (1.0f + color);
	color = pow(saturate(color), 1.0f / 2.2f);

	return saturate(color);
}

float3 BuildClouds(float3 skyColor, float3 viewDir, float horizonMask)
{
	if (gOptions.z <= 0.0f)
		return skyColor;

	float cloudAmount = saturate(gCloudParams.x);
	float cloudScale = max(gCloudParams.y, 0.01f);
	float cloudTime = gCloudParams.z;
	float cloudSoftness = max(gCloudParams.w, 0.001f);

	// Не рисуем облака слишком близко к горизонту и ниже горизонта.
	float upperSky = saturate((viewDir.y - 0.08f) * 2.4f);

	if (upperSky <= 0.001f)
		return skyColor;

	float2 cloudUV =
		viewDir.xz /
		max(viewDir.y + 0.35f, 0.15f);

	cloudUV *= cloudScale * 2.2f;
	cloudUV += float2(cloudTime, cloudTime * 0.37f);

	float cloudNoise = FBM(cloudUV);

	float cloudMask =
		smoothstep(
			1.0f - cloudAmount,
			1.0f - cloudAmount + cloudSoftness,
			cloudNoise
		);

	cloudMask *= upperSky;
	cloudMask *= 1.0f - horizonMask * 0.55f;

	float3 cloudColor = float3(0.78f, 0.80f, 0.78f);

	return lerp(skyColor, cloudColor, saturate(cloudMask * 0.42f));
}

float4 main(PS_INPUT input) : SV_Target
{
	float3 viewDir = ReconstructWorldDirection(input.TexCoord);

	float skyHeight = saturate(viewDir.y * 0.5f + 0.5f);

	// Более плотный горизонт, более тёмный зенит.
	float gradientT = smoothstep(0.0f, 1.0f, skyHeight);
	float3 skyColor =
		lerp(
			gHorizonColor.rgb,
			gZenithColor.rgb,
			gradientT
		);

	float horizonMask =
		saturate(1.0f - abs(viewDir.y) * 5.0f);

	if (gOptions.w > 0.0f)
	{
		skyColor =
			lerp(
				skyColor,
				gFogColorDensity.rgb,
				horizonMask * gFogColorDensity.a
			);
	}

	if (gOptions.y > 0.0f)
	{
		float3 sunDir =
			SafeNormalize(
				-gSunDirection.xyz,
				float3(0.0f, 1.0f, 0.0f)
			);

		float sunDot = saturate(dot(viewDir, sunDir));

		float sunDisk = pow(sunDot, 1800.0f);
		float sunGlow = pow(sunDot, 18.0f);

		float3 sunColor =
			gSunColorIntensity.rgb *
			gSunColorIntensity.a;

		skyColor += sunColor * sunGlow * 0.28f;
		skyColor += sunColor * sunDisk * 4.0f;

		if (gMoonParams.x > 0.0f)
		{
			float3 moonDir = -sunDir;
			float moonDot = saturate(dot(viewDir, moonDir));

			float moonDisk =
				pow(
					moonDot,
					max(gMoonParams.y, 1.0f)
				);

			float moonGlow =
				pow(
					moonDot,
					max(gMoonParams.z, 1.0f)
				);

			float3 moonColor =
				float3(0.62f, 0.68f, 0.78f) *
				gMoonParams.w;

			skyColor += moonColor * moonGlow * 0.35f;
			skyColor += moonColor * moonDisk * 2.4f;
		}
	}

	skyColor =
		BuildClouds(
			skyColor,
			viewDir,
			horizonMask
		);

	return float4(ApplySkyToneMap(skyColor), 1.0f);
}