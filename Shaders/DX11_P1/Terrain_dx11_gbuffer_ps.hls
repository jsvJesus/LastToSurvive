#pragma pack_matrix(row_major)

Texture2D TerrainColorModTexture          : register(t0);
Texture2D TerrainDetailNormalTexture      : register(t1);

Texture2D TerrainBaseDiffuseTexture       : register(t2);
Texture2D TerrainBaseNormalTexture        : register(t3);

Texture2D TerrainMaskTextures[3]          : register(t4);
Texture2D TerrainLayerDiffuseTextures[8]  : register(t7);
Texture2D TerrainLayerNormalTextures[8]   : register(t15);

SamplerState TerrainClampSampler : register(s0);
SamplerState TerrainWrapSampler  : register(s1);

cbuffer TerrainConstants : register(b0)
{
	float4x4 gWorldViewProj;

	float4 gTerrainParams;
	float4 gTerrainLayerParams;
	float4 gTerrainDetailParams;
	float4 gTerrainDebugParams;

	float4 gTerrainSplatParams;
	float4 gTerrainBaseLayerParams;
	float4 gTerrainPaintLayerParams[8];
	float4 gTerrainPaintLayerMaskParams[8];
};

struct PS_INPUT
{
	float4 Position  : SV_POSITION;
	float3 WorldPos  : TEXCOORD0;
	float3 Normal    : TEXCOORD1;
	float2 TexCoord  : TEXCOORD2;
	float4 LayerData : TEXCOORD3;
	float  ClipDepth : TEXCOORD4;
};

struct PS_OUTPUT
{
	float4 Color       : SV_Target0;
	float4 Normal      : SV_Target1;
	float4 LinearDepth : SV_Target2;
	float4 Aux         : SV_Target3;
};

float3 SafeNormalize(float3 v, float3 fallback)
{
	float lenSq = dot(v, v);

	if (lenSq < 0.000001f)
		return fallback;

	return v * rsqrt(lenSq);
}

float4 BuildSplatWeights(float height01, float slope)
{
	float grass = saturate(1.0f - slope * 2.35f);
	float rock  = saturate(slope * 2.75f);
	float dirt  = saturate(1.0f - abs(height01 - 0.42f) * 2.25f);
	float sand  = saturate(1.0f - height01 * 5.0f);

	float4 w = float4(grass, dirt, rock, sand);
	w = max(w, 0.001f);

	return w / dot(w, 1.0f);
}

float3 BuildProceduralAlbedo(float4 weights, float height01, float slope)
{
	float3 grassColor = float3(0.16f, 0.24f, 0.11f);
	float3 dirtColor  = float3(0.29f, 0.23f, 0.17f);
	float3 rockColor  = float3(0.32f, 0.31f, 0.29f);
	float3 sandColor  = float3(0.38f, 0.33f, 0.23f);

	float3 albedo =
		grassColor * weights.x +
		dirtColor  * weights.y +
		rockColor  * weights.z +
		sandColor  * weights.w;

	albedo *= lerp(0.92f, 1.06f, height01);
	albedo *= lerp(1.00f, 0.88f, slope);

	return saturate(albedo);
}

float3 DecodeNormalOffset(Texture2D normalTex, float2 uv)
{
	float3 packedNormal =
		normalTex.Sample(
			TerrainWrapSampler,
			uv
		).xyz;

	float3 tangentNormal =
		packedNormal * 2.0f - 1.0f;

	return float3(
		tangentNormal.x,
		0.0f,
		tangentNormal.y
	);
}

float GetMaskChannel(float3 maskValue, float channelIdx)
{
	if (channelIdx < 0.5f)
		return maskValue.r;

	if (channelIdx < 1.5f)
		return maskValue.g;

	return maskValue.b;
}

float3 SampleMaskRGB(float maskIdx, float2 uv)
{
	if (maskIdx < 0.5f)
		return TerrainMaskTextures[0].Sample(TerrainClampSampler, uv).rgb;

	if (maskIdx < 1.5f)
		return TerrainMaskTextures[1].Sample(TerrainClampSampler, uv).rgb;

	return TerrainMaskTextures[2].Sample(TerrainClampSampler, uv).rgb;
}

float3 ApplyColorModTexture(float3 albedo, float2 uv)
{
	float textureBlend =
		saturate(gTerrainDebugParams.y);

	if (textureBlend <= 0.001f)
		return albedo;

	float3 colorMod =
		saturate(
			TerrainColorModTexture.Sample(
				TerrainClampSampler,
				uv
			).rgb
		);

	float3 tint =
		lerp(
			float3(1.0f, 1.0f, 1.0f),
			saturate(colorMod * 1.35f),
			0.75f
		);

	float3 tintedAlbedo =
		saturate(albedo * tint);

	return saturate(
		lerp(
			albedo,
			tintedAlbedo,
			textureBlend
		)
	);
}

float3 ApplyDetailNormal(float3 normal, float3 worldPos)
{
	float detailAmount =
		saturate(gTerrainDebugParams.w);

	if (detailAmount <= 0.001f)
		return normal;

	float detailScale =
		max(gTerrainDetailParams.x, 0.001f);

	float2 detailUV =
		worldPos.xz / detailScale;

	float3 detailOffset =
		DecodeNormalOffset(
			TerrainDetailNormalTexture,
			detailUV
		);

	normal =
		SafeNormalize(
			normal + detailOffset * detailAmount * 0.18f,
			normal
		);

	return normal;
}

void BuildLayeredTerrainMaterial(
	PS_INPUT input,
	float3 geometricNormal,
	out float3 outAlbedo,
	out float3 outNormal,
	out float outGloss,
	out float outSpec
)
{
	float2 baseUV =
		input.WorldPos.xz *
		max(gTerrainBaseLayerParams.xy, float2(0.000001f, 0.000001f));

	float3 baseAlbedo =
		saturate(
			TerrainBaseDiffuseTexture.Sample(
				TerrainWrapSampler,
				baseUV
			).rgb
		);

	float baseSpecPow =
		max(gTerrainBaseLayerParams.z, 1.0f);

	float2 maskUV =
		saturate(input.TexCoord);

	float layerWeightSum = 0.0f;
	float3 layerAlbedoSum = float3(0.0f, 0.0f, 0.0f);
	float3 normalOffsetSum = float3(0.0f, 0.0f, 0.0f);
	float specPowSum = 0.0f;

	float normalBlend =
		saturate(gTerrainDebugParams.z);

	float activeLayerCount =
		max(gTerrainSplatParams.y, 0.0f);

	[unroll]
	for (int i = 0; i < 8; ++i)
	{
		float layerActive =
			gTerrainPaintLayerParams[i].w *
			gTerrainPaintLayerMaskParams[i].z;

		if (layerActive > 0.5f && i < activeLayerCount)
		{
			float maskIdx =
				gTerrainPaintLayerMaskParams[i].x;

			float channelIdx =
				gTerrainPaintLayerMaskParams[i].y;

			float3 maskValue =
				SampleMaskRGB(
					maskIdx,
					maskUV
				);

			float weight =
				saturate(
					GetMaskChannel(
						maskValue,
						channelIdx
					)
				);

			if (weight > 0.0001f)
			{
				float2 layerUV =
					input.WorldPos.xz *
					max(gTerrainPaintLayerParams[i].xy, float2(0.000001f, 0.000001f));

				float3 layerAlbedo =
					saturate(
						TerrainLayerDiffuseTextures[i].Sample(
							TerrainWrapSampler,
							layerUV
						).rgb
					);

				layerAlbedoSum += layerAlbedo * weight;
				layerWeightSum += weight;

				if (normalBlend > 0.001f)
				{
					normalOffsetSum +=
						DecodeNormalOffset(
							TerrainLayerNormalTextures[i],
							layerUV
						) * weight;
				}

				specPowSum +=
					max(gTerrainPaintLayerParams[i].z, 1.0f) *
					weight;
			}
		}
	}

	float baseWeight =
		saturate(1.0f - layerWeightSum);

	float totalWeight =
		max(baseWeight + layerWeightSum, 0.0001f);

	outAlbedo =
		saturate(
			(baseAlbedo * baseWeight + layerAlbedoSum) /
			totalWeight
		);

	float specPow =
		(baseSpecPow * baseWeight + specPowSum) /
		totalWeight;

	if (normalBlend > 0.001f)
	{
		normalOffsetSum +=
			DecodeNormalOffset(
				TerrainBaseNormalTexture,
				baseUV
			) * baseWeight;

		outNormal =
			SafeNormalize(
				geometricNormal +
				normalOffsetSum * normalBlend * 0.35f,
				geometricNormal
			);
	}
	else
	{
		outNormal = geometricNormal;
	}

	float spec01 =
		saturate(specPow / 128.0f);

	outGloss =
		lerp(0.12f, 0.65f, spec01);

	outSpec =
		lerp(0.035f, 0.16f, spec01);
}

PS_OUTPUT main(PS_INPUT input)
{
	PS_OUTPUT output;

	float3 normal =
		SafeNormalize(
			input.Normal,
			float3(0.0f, 1.0f, 0.0f)
		);

	float height01 =
		saturate(input.LayerData.x);

	float slope =
		saturate(input.LayerData.y);

	float3 albedo;
	float gloss;
	float spec;

	if (gTerrainSplatParams.x > 0.5f)
	{
		BuildLayeredTerrainMaterial(
			input,
			normal,
			albedo,
			normal,
			gloss,
			spec
		);
	}
	else
	{
		float4 weights =
			BuildSplatWeights(
				height01,
				slope
			);

		albedo =
			BuildProceduralAlbedo(
				weights,
				height01,
				slope
			);

		gloss =
			lerp(0.12f, 0.30f, weights.z);

		spec =
			lerp(0.035f, 0.12f, weights.z);
	}

	albedo =
		ApplyColorModTexture(
			albedo,
			input.TexCoord
		);

	normal =
		ApplyDetailNormal(
			normal,
			input.WorldPos
		);

	output.Color =
		float4(
			saturate(albedo),
			1.0f
		);

	output.Normal =
		float4(
			normal * 0.5f + 0.5f,
			1.0f
		);

	output.LinearDepth =
		float4(
			saturate(input.ClipDepth),
			saturate(input.ClipDepth),
			saturate(input.ClipDepth),
			1.0f
		);

	output.Aux =
		float4(
			saturate(gloss),
			saturate(spec),
			saturate(slope),
			1.0f
		);

	return output;
}