#pragma pack_matrix(row_major)

Texture2D TerrainColorTexture        : register(t0);
Texture2D TerrainNormalTexture       : register(t1);
Texture2D TerrainDetailNormalTexture : register(t2);

SamplerState TerrainClampSampler : register(s0);
SamplerState TerrainWrapSampler  : register(s1);

cbuffer TerrainConstants : register(b0)
{
	float4x4 gWorldViewProj;

	float4 gTerrainParams;
	float4 gTerrainLayerParams;
	float4 gTerrainDetailParams;
	float4 gTerrainDebugParams;
};

struct PS_INPUT
{
	float4 Position  : SV_POSITION;
	float3 WorldPos  : TEXCOORD0;
	float3 Normal    : TEXCOORD1;
	float2 TexCoord  : TEXCOORD2;
	float4 LayerData : TEXCOORD3;
	float  ClipDepth : TEXCOORD4;
};

struct PS_OUTPUT
{
	float4 Color       : SV_Target0;
	float4 Normal      : SV_Target1;
	float4 LinearDepth : SV_Target2;
	float4 Aux         : SV_Target3;
};

float3 SafeNormalize(float3 v, float3 fallback)
{
	float lenSq = dot(v, v);

	if (lenSq < 0.000001f)
		return fallback;

	return v * rsqrt(lenSq);
}

float4 BuildSplatWeights(float height01, float slope)
{
	float grass = saturate(1.0f - slope * 2.35f);
	float rock  = saturate(slope * 2.75f);
	float dirt  = saturate(1.0f - abs(height01 - 0.42f) * 2.25f);
	float sand  = saturate(1.0f - height01 * 5.0f);

	float4 w = float4(grass, dirt, rock, sand);
	w = max(w, 0.001f);

	return w / dot(w, 1.0f);
}

float3 BuildProceduralAlbedo(float4 weights, float height01, float slope)
{
	float3 grassColor = float3(0.16f, 0.24f, 0.11f);
	float3 dirtColor  = float3(0.29f, 0.23f, 0.17f);
	float3 rockColor  = float3(0.32f, 0.31f, 0.29f);
	float3 sandColor  = float3(0.38f, 0.33f, 0.23f);

	float3 albedo =
		grassColor * weights.x +
		dirtColor  * weights.y +
		rockColor  * weights.z +
		sandColor  * weights.w;

	// Слабая высотная коррекция, без дорогого noise.
	albedo *= lerp(0.92f, 1.06f, height01);
	albedo *= lerp(1.00f, 0.88f, slope);

	return saturate(albedo);
}

float3 ApplyTerrainColorTexture(float3 proceduralAlbedo, float2 uv)
{
	float textureBlend =
		saturate(gTerrainDebugParams.y);

	if (textureBlend <= 0.001f)
		return proceduralAlbedo;

	float3 textureAlbedo =
		saturate(
			TerrainColorTexture.Sample(
				TerrainClampSampler,
				uv
			).rgb
		);

	// NumPad 7 -> 1.00:
	// raw texture debug mode.
	// Если тут земля белая/серая — значит сама Terrain2 color texture такая.
	if (textureBlend >= 0.999f)
		return textureAlbedo;

	float textureLuma =
		dot(
			textureAlbedo,
			float3(0.2126f, 0.7152f, 0.0722f)
		);

	// Бело-серую terrain texture не даём смешивать на 100%,
	// но теперь режем не так жёстко, чтобы NumPad 7 был заметен.
	float washedOut =
		smoothstep(
			0.62f,
			0.92f,
			textureLuma
		);

	float safeBlend =
		textureBlend *
		lerp(
			1.0f,
			0.45f,
			washedOut
		);

	// Используем texture как tint, а не как полноценный albedo.
	float3 tint =
		lerp(
			float3(1.0f, 1.0f, 1.0f),
			saturate(textureAlbedo * 1.35f),
			0.75f
		);

	float3 tintedAlbedo =
		saturate(
			proceduralAlbedo * tint
		);

	return saturate(
		lerp(
			proceduralAlbedo,
			tintedAlbedo,
			safeBlend
		)
	);
}

float3 ApplyTerrainNormalTexture(float3 normal, float2 uv)
{
	float normalBlend = saturate(gTerrainDebugParams.z);

	if (normalBlend <= 0.001f)
		return normal;

	float3 packedNormal =
		TerrainNormalTexture.Sample(
			TerrainClampSampler,
			uv
		).xyz;

	float3 sampledNormal =
		packedNormal * 2.0f - 1.0f;

	sampledNormal =
		SafeNormalize(
			sampledNormal,
			normal
		);

	return SafeNormalize(
		lerp(
			normal,
			sampledNormal,
			normalBlend
		),
		normal
	);
}

float3 ApplyDetailNormal(float3 normal, float2 uv, float3 worldPos)
{
	float detailAmount =
		saturate(gTerrainDebugParams.w);

	if (detailAmount <= 0.001f)
		return normal;

	float detailScale =
		max(gTerrainDetailParams.x, 0.001f);

	float2 detailUV =
		worldPos.xz / detailScale;

	float3 detailPacked =
		TerrainDetailNormalTexture.Sample(
			TerrainWrapSampler,
			detailUV
		).xyz;

	float3 detailNormal =
		detailPacked * 2.0f - 1.0f;

	normal =
		SafeNormalize(
			normal +
			float3(
				detailNormal.x,
				0.0f,
				detailNormal.y
			) * detailAmount * 0.18f,
			normal
		);

	return normal;
}

PS_OUTPUT main(PS_INPUT input)
{
	PS_OUTPUT output;

	float3 normal =
		SafeNormalize(
			input.Normal,
			float3(0.0f, 1.0f, 0.0f)
		);

	float height01 =
		saturate(input.LayerData.x);

	float slope =
		saturate(input.LayerData.y);

	float4 weights =
		BuildSplatWeights(
			height01,
			slope
		);

	float3 albedo =
		BuildProceduralAlbedo(
			weights,
			height01,
			slope
		);

	albedo =
		ApplyTerrainColorTexture(
			albedo,
			input.TexCoord
		);

	normal =
		ApplyTerrainNormalTexture(
			normal,
			input.TexCoord
		);

	normal =
		ApplyDetailNormal(
			normal,
			input.TexCoord,
			input.WorldPos
		);

	float gloss =
		lerp(0.12f, 0.30f, weights.z);

	float spec =
		lerp(0.035f, 0.12f, weights.z);

	output.Color =
		float4(
			saturate(albedo),
			1.0f
		);

	output.Normal =
		float4(
			normal * 0.5f + 0.5f,
			1.0f
		);

	output.LinearDepth =
		float4(
			saturate(input.ClipDepth),
			saturate(input.ClipDepth),
			saturate(input.ClipDepth),
			1.0f
		);

	output.Aux =
		float4(
			saturate(gloss),
			saturate(spec),
			saturate(weights.z),
			1.0f
		);

	return output;
}