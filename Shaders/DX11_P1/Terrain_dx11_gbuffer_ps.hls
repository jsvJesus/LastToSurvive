#pragma pack_matrix(row_major)

Texture2D TerrainColorTexture        : register(t0);
Texture2D TerrainNormalTexture       : register(t1);
Texture2D TerrainDetailNormalTexture : register(t2);

SamplerState TerrainClampSampler : register(s0);
SamplerState TerrainWrapSampler  : register(s1);

cbuffer TerrainConstants : register(b0)
{
	float4x4 gWorldViewProj;

	float4 gTerrainParams;
	float4 gTerrainLayerParams;
	float4 gTerrainDetailParams;
	float4 gTerrainDebugParams;
};

struct PS_INPUT
{
	float4 Position  : SV_POSITION;
	float3 WorldPos  : TEXCOORD0;
	float3 Normal    : TEXCOORD1;
	float2 TexCoord  : TEXCOORD2;
	float4 LayerData : TEXCOORD3;
	float  ClipDepth : TEXCOORD4;
};

struct PS_OUTPUT
{
	float4 Color       : SV_Target0;
	float4 Normal      : SV_Target1;
	float4 LinearDepth : SV_Target2;
	float4 Aux         : SV_Target3;
};

float3 SafeNormalize(float3 v, float3 fallback)
{
	float lenSq = dot(v, v);

	if (lenSq < 0.000001f)
		return fallback;

	return v * rsqrt(lenSq);
}

float Hash21(float2 p)
{
	p = frac(p * float2(123.34f, 456.21f));
	p += dot(p, p + 45.32f);
	return frac(p.x * p.y);
}

float Noise2(float2 uv)
{
	float2 i = floor(uv);
	float2 f = frac(uv);

	float a = Hash21(i);
	float b = Hash21(i + float2(1.0f, 0.0f));
	float c = Hash21(i + float2(0.0f, 1.0f));
	float d = Hash21(i + float2(1.0f, 1.0f));

	float2 u = f * f * (3.0f - 2.0f * f);

	return lerp(
		lerp(a, b, u.x),
		lerp(c, d, u.x),
		u.y
	);
}

float4 BuildSplatWeights(float height01, float slope, float noise)
{
	float grass = saturate(1.0f - slope * 2.0f);
	float rock = saturate(slope * 2.5f);
	float dirt = saturate(1.0f - abs(height01 - 0.45f) * 2.0f);
	float sand = saturate(1.0f - height01 * 4.0f);

	grass *= lerp(0.75f, 1.25f, noise);
	dirt  *= lerp(1.15f, 0.85f, noise);
	rock  *= lerp(0.90f, 1.20f, noise);

	float4 w = float4(grass, dirt, rock, sand);
	w = max(w, 0.001f);

	return w / dot(w, 1.0f);
}

float3 BuildProceduralAlbedo(float4 weights, float2 uv)
{
	float3 grassColor = float3(0.20f, 0.28f, 0.16f);
	float3 dirtColor  = float3(0.30f, 0.24f, 0.18f);
	float3 rockColor  = float3(0.34f, 0.34f, 0.32f);
	float3 sandColor  = float3(0.42f, 0.36f, 0.24f);

	float3 albedo =
		grassColor * weights.x +
		dirtColor  * weights.y +
		rockColor  * weights.z +
		sandColor  * weights.w;

	float detail =
		Noise2(uv * gTerrainDetailParams.x * 2.0f);

	albedo *= lerp(0.86f, 1.14f, detail);

	return albedo;
}

float3 ApplyTerrainNormalTexture(float3 normal, float2 uv)
{
	if (gTerrainDebugParams.z <= 0.5f)
		return normal;

	float3 packedNormal =
		TerrainNormalTexture.Sample(
			TerrainClampSampler,
			uv
		).xyz;

	float3 sampledNormal =
		packedNormal * 2.0f - 1.0f;

	sampledNormal =
		SafeNormalize(
			sampledNormal,
			normal
		);

	// Terrain2 normal texture may not be perfect world-space parity yet,
	// so blend softly instead of replacing normal completely.
	return SafeNormalize(
		lerp(normal, sampledNormal, 0.35f),
		normal
	);
}

float3 ApplyDetailNormal(float3 normal, float2 uv)
{
	float detailScale =
		max(gTerrainDetailParams.x, 0.001f);

	float detailAmount =
		saturate(gTerrainDetailParams.y);

	if (gTerrainDebugParams.w > 0.5f)
	{
		float3 detailPacked =
			TerrainDetailNormalTexture.Sample(
				TerrainWrapSampler,
				uv * detailScale
			).xyz;

		float3 detailNormal =
			detailPacked * 2.0f - 1.0f;

		// Detail normal is applied as small world XZ perturbation.
		normal =
			SafeNormalize(
				normal +
				float3(detailNormal.x, 0.0f, detailNormal.y) *
				detailAmount *
				0.18f,
				normal
			);

		return normal;
	}

	float n0 = Noise2(uv * detailScale);
	float n1 = Noise2(uv * detailScale + 17.23f);

	float3 proceduralDetail =
		SafeNormalize(
			float3(n0 - 0.5f, 1.0f, n1 - 0.5f),
			float3(0.0f, 1.0f, 0.0f)
		);

	return SafeNormalize(
		lerp(
			normal,
			SafeNormalize(normal + proceduralDetail * 0.35f, normal),
			detailAmount
		),
		normal
	);
}

PS_OUTPUT main(PS_INPUT input)
{
	PS_OUTPUT output;

	float3 normal =
		SafeNormalize(
			input.Normal,
			float3(0.0f, 1.0f, 0.0f)
		);

	float height01 = saturate(input.LayerData.x);
	float slope = saturate(input.LayerData.y);

	float noise =
		Noise2(input.TexCoord * 96.0f);

	float4 weights =
		BuildSplatWeights(
			height01,
			slope,
			noise
		);

	float3 proceduralAlbedo =
		BuildProceduralAlbedo(
			weights,
			input.TexCoord
		);

	float3 textureAlbedo =
		TerrainColorTexture.Sample(
			TerrainClampSampler,
			input.TexCoord
		).rgb;

	textureAlbedo = saturate(textureAlbedo);

	float useColorTexture =
		saturate(gTerrainDebugParams.y);

	// v1 parity:
	// use Terrain2 color texture if available,
	// but keep some procedural modulation so it does not become flat.
	float3 albedo =
		lerp(
			proceduralAlbedo,
			textureAlbedo,
			useColorTexture * 0.92f
		);

	if (useColorTexture > 0.5f)
	{
		float fineNoise =
			Noise2(input.TexCoord * gTerrainDetailParams.x * 3.0f);

		albedo *= lerp(0.94f, 1.06f, fineNoise);
	}

	normal =
		ApplyTerrainNormalTexture(
			normal,
			input.TexCoord
		);

	normal =
		ApplyDetailNormal(
			normal,
			input.TexCoord
		);

	float gloss =
		lerp(0.16f, 0.40f, weights.z);

	float spec =
		lerp(0.06f, 0.18f, weights.z);

	// Slightly reduce wet/glossy look for terrain v1.
	gloss *= 0.85f;
	spec *= 0.75f;

	output.Color =
		float4(
			saturate(albedo),
			1.0f
		);

	output.Normal =
		float4(
			normal * 0.5f + 0.5f,
			1.0f
		);

	output.LinearDepth =
		float4(
			saturate(input.ClipDepth),
			saturate(input.ClipDepth),
			saturate(input.ClipDepth),
			1.0f
		);

	output.Aux =
		float4(
			saturate(gloss),
			saturate(spec),
			saturate(weights.z),
			1.0f
		);

	return output;
}