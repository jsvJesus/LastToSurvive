#include "SYSTEM/Common.hls"

#ifndef DX11_FILLBUFFER_SHARED_ONLY
cbuffer MeshConstants : register(b0)
{
	float4x4 WorldViewProj;
	float4x4 World;
	float4 PositionScale;
	float4 TexcoordScale;

	// x = positive device-depth bias for special mesh paths.
	// y = 1.0 when road path is active.
	// z/w reserved.
	float4 PathParams;
};

struct FillBufferVSInput
{
	float4 Position : POSITION;
	float2 TexCoord : TEXCOORD0;
	float4 Normal : NORMAL;
	float4 Tangent : TANGENT;
};
#endif

struct FillBufferVSOutput
{
	float4 Position : SV_POSITION;
	float2 TexCoord : TEXCOORD0;
	float3 Normal : TEXCOORD1;
	float3 Tangent : TEXCOORD2;
	float3 Binormal : TEXCOORD3;
	float3 WorldPos : TEXCOORD4;
	float Depth : TEXCOORD5;
};

#ifndef DX11_FILLBUFFER_SHARED_ONLY
FillBufferVSOutput main(FillBufferVSInput input)
{
	FillBufferVSOutput output;

	float4 localPos = float4(input.Position.xyz * PositionScale.xyz, 1.0f);
	float4 worldPos = mul(localPos, World);

	output.Position = mul(localPos, WorldViewProj);

	// Road path:
	// Старый DX9 road path двигал depth через MC_DDEPTH.
	// В DX11 не двигаем world position, двигаем только clip/depth,
	// чтобы дорога не мерцала с terrain.
	if (PathParams.y > 0.5f)
	{
		output.Position.z -= PathParams.x * output.Position.w;
	}

	output.TexCoord = input.TexCoord * TexcoordScale.xy;
	output.Normal = normalize(mul(float4(input.Normal.xyz * 2.0f - 1.0f, 0.0f), World).xyz);
	output.Tangent = normalize(mul(float4(input.Tangent.xyz * 2.0f - 1.0f, 0.0f), World).xyz);
	output.Binormal = normalize(cross(output.Normal, output.Tangent) * (input.Tangent.w * 2.0f - 1.0f));
	output.WorldPos = worldPos.xyz;
	output.Depth = saturate(output.Position.z / max(output.Position.w, 0.00001f));

	return output;
}
#endif