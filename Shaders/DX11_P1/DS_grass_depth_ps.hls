Texture2D gDiffuseTex : register(t0);
Texture2D gMaskTex : register(t2);

SamplerState gLinearWrapSampler : register(s0);
SamplerState gLinearClampSampler : register(s1);

struct PSInput
{
	float4 Position : SV_POSITION;
	float2 Texcoord : TEXCOORD0;
	float4 WorldFadeAlpha : TEXCOORD1;
	float4 TintParams : TEXCOORD2;
	float2 HeightMaskUV : TEXCOORD3;
};

float4 main(PSInput input) : SV_Target0
{
	float4 albedo = gDiffuseTex.Sample(gLinearWrapSampler, input.Texcoord);
	float mask = gMaskTex.Sample(gLinearClampSampler, input.HeightMaskUV).r;

	float alphaRef = input.TintParams.x;
	float fade = input.WorldFadeAlpha.w;

	clip(mask - 0.01f);
	clip(albedo.a * fade - alphaRef);

	return float4(input.Position.z / input.Position.w, 0.0f, 0.0f, 1.0f);
}