Texture2D gDiffuseTex : register(t0);
SamplerState gLinearSampler : register(s0);

cbuffer GrassConstants : register(b0)
{
	float4x4 gViewProj;
	float4 gCameraPos_Time;
	float4 gParams;
};

struct PSInput
{
	float4 Position : SV_POSITION;
	float2 Texcoord : TEXCOORD0;
	float4 WorldFadeAlpha : TEXCOORD1;
	float4 TintParams : TEXCOORD2;
};

struct PSOutput
{
	float4 Color : SV_Target0;
	float4 Normal : SV_Target1;
	float4 Depth : SV_Target2;
	float4 Aux : SV_Target3;
};

PSOutput main(PSInput input)
{
	float4 albedo = gDiffuseTex.Sample(gLinearSampler, input.Texcoord);

	float alphaRef = input.TintParams.x;
	float fade = input.WorldFadeAlpha.w;

	clip(albedo.a * fade - alphaRef);

	PSOutput output;

	float tintStrength = input.TintParams.y;
	float bladeHeight = input.TintParams.z;

	float3 grassTint = lerp(albedo.rgb, albedo.rgb * float3(0.78f, 0.92f, 0.72f), saturate(tintStrength * 0.35f));
	grassTint *= lerp(0.75f, 1.08f, bladeHeight);

	output.Color = float4(grassTint, 0.35f);

	float3 n = normalize(float3(0.0f, 1.0f, 0.15f));
	output.Normal = float4(n * 0.5f + 0.5f, 0.0f);

	output.Depth = float4(input.Position.z / input.Position.w, 0.0f, 0.0f, 1.0f);

	output.Aux = float4(1.0f, 0.0f, 0.0f, 0.0f);

	return output;
}