#include "SYSTEM/Common.hls"

cbuffer MeshConstants : register(b0)
{
	float4x4 WorldViewProj;
	float4x4 World;
	float4 PositionScale;
	float4 TexcoordScale;
};

struct VegetationVSInput
{
	float4 Position : POSITION;
	float2 TexCoord : TEXCOORD0;
	float4 Normal : NORMAL;
	float4 Tangent : TANGENT;
	float4 InstancePosAngle : TEXCOORD3;
	float4 InstanceScaleRandom : TEXCOORD4;
	float4 InstanceAnim : TEXCOORD5;
	float4 InstanceOptions : TEXCOORD6;
};

struct VegetationVSOutput
{
	float4 Position : SV_POSITION;
	float2 TexCoord : TEXCOORD0;
	float3 Normal : TEXCOORD1;
	float3 Tangent : TEXCOORD2;
	float3 Binormal : TEXCOORD3;
	float3 WorldPos : TEXCOORD4;
	float Depth : TEXCOORD5;
	float RandomColor : TEXCOORD6;
};

float3 RotateY(float3 v, float angle)
{
	float s = sin(angle);
	float c = cos(angle);
	return float3(v.x * c + v.z * s, v.y, -v.x * s + v.z * c);
}

VegetationVSOutput main(VegetationVSInput input)
{
	VegetationVSOutput output;

	float3 localPos = input.Position.xyz * PositionScale.xyz;
	localPos *= input.InstanceScaleRandom.xyz;
	float3 worldPos = RotateY(localPos, input.InstancePosAngle.w) + input.InstancePosAngle.xyz;

	float3 normal = normalize(RotateY(input.Normal.xyz * 2.0f - 1.0f, input.InstancePosAngle.w));
	float3 tangent = normalize(RotateY(input.Tangent.xyz * 2.0f - 1.0f, input.InstancePosAngle.w));

	output.Position = mul(float4(worldPos, 1.0f), WorldViewProj);
	output.TexCoord = input.TexCoord * TexcoordScale.xy;
	output.Normal = normal;
	output.Tangent = tangent;
	output.Binormal = normalize(cross(output.Normal, output.Tangent) * (input.Tangent.w * 2.0f - 1.0f));
	output.WorldPos = worldPos;
	output.Depth = output.Position.w;
	output.RandomColor = input.InstanceScaleRandom.w;
	return output;
}
