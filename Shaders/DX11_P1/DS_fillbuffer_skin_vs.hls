#include "SYSTEM/Common.hls"

cbuffer MeshConstants : register(b0)
{
	float4x4 WorldViewProj;
	float4x4 World;
	float4 PositionScale;
	float4 TexcoordScale;

	// x = positive device-depth bias for special mesh paths.
	// y = 1.0 when road path is active.
	// z/w reserved.
	float4 PathParams;
};

cbuffer SkinningConstants : register(b1)
{
	float4x4 BoneMatrices[73];
};

struct FillBufferSkinVSInput
{
	float4 Position : POSITION;
	float2 TexCoord : TEXCOORD0;
	float4 Normal : NORMAL;
	float4 Tangent : TANGENT;
	float4 BlendWeights : BLENDWEIGHT;
	uint4 BlendIndices : BLENDINDICES;
};

struct FillBufferVSOutput
{
	float4 Position : SV_POSITION;
	float2 TexCoord : TEXCOORD0;
	float3 Normal : TEXCOORD1;
	float3 Tangent : TEXCOORD2;
	float3 Binormal : TEXCOORD3;
	float3 WorldPos : TEXCOORD4;
	float Depth : TEXCOORD5;
};

float4 SkinPosition(float4 position, uint4 indices, float4 weights)
{
	float4 result = 0.0f;
	result += mul(position, BoneMatrices[indices.x]) * weights.x;
	result += mul(position, BoneMatrices[indices.y]) * weights.y;
	result += mul(position, BoneMatrices[indices.z]) * weights.z;
	result += mul(position, BoneMatrices[indices.w]) * weights.w;
	return result;
}

float3 SkinVector(float3 inputVector, uint4 indices, float4 weights)
{
	float3 result = 0.0f;
	result += mul(float4(inputVector, 0.0f), BoneMatrices[indices.x]).xyz * weights.x;
	result += mul(float4(inputVector, 0.0f), BoneMatrices[indices.y]).xyz * weights.y;
	result += mul(float4(inputVector, 0.0f), BoneMatrices[indices.z]).xyz * weights.z;
	result += mul(float4(inputVector, 0.0f), BoneMatrices[indices.w]).xyz * weights.w;
	return result;
}

FillBufferVSOutput main(FillBufferSkinVSInput input)
{
	FillBufferVSOutput output;

	float4 localPos = float4(input.Position.xyz * PositionScale.xyz, 1.0f);
	float3 localNormal = input.Normal.xyz * 2.0f - 1.0f;
	float4 tangentSample = input.Tangent * 2.0f - 1.0f;
	float3 localTangent = tangentSample.xyz;

	float4 skinnedPos = SkinPosition(localPos, input.BlendIndices, input.BlendWeights);
	skinnedPos.w = 1.0f;

	float3 skinnedNormal = normalize(SkinVector(localNormal, input.BlendIndices, input.BlendWeights));
	float3 skinnedTangent = normalize(SkinVector(localTangent, input.BlendIndices, input.BlendWeights));

	float4 worldPos = mul(skinnedPos, World);

	output.Position = mul(skinnedPos, WorldViewProj);

	// На практике дороги static, но cbuffer должен совпадать с C++ struct.
	// Оставляем такую же поддержку path bias, чтобы layout не разъехался.
	if (PathParams.y > 0.5f)
	{
		output.Position.z -= PathParams.x * output.Position.w;
	}

	output.TexCoord = input.TexCoord * TexcoordScale.xy;
	output.Normal = normalize(mul(float4(skinnedNormal, 0.0f), World).xyz);
	output.Tangent = normalize(mul(float4(skinnedTangent, 0.0f), World).xyz);
	output.Binormal = normalize(cross(output.Normal, output.Tangent) * tangentSample.w);
	output.WorldPos = worldPos.xyz;
	output.Depth = saturate(output.Position.z / max(output.Position.w, 0.00001f));

	return output;
}