#pragma pack_matrix(row_major)

cbuffer TerrainConstants : register(b0)
{
	float4x4 gWorldViewProj;

	float4 gTerrainParams;
	float4 gTerrainLayerParams;
	float4 gTerrainDetailParams;
	float4 gTerrainDebugParams;

	float4 gTerrainSplatParams;
	float4 gTerrainBaseLayerParams;
	float4 gTerrainPaintLayerParams[8];
	float4 gTerrainPaintLayerMaskParams[8];
};

struct VS_INPUT
{
	float3 Position  : POSITION;
	float3 Normal    : NORMAL;
	float2 TexCoord  : TEXCOORD0;
	float4 LayerData : COLOR0;
};

struct VS_OUTPUT
{
	float4 Position  : SV_POSITION;
	float3 WorldPos  : TEXCOORD0;
	float3 Normal    : TEXCOORD1;
	float2 TexCoord  : TEXCOORD2;
	float4 LayerData : TEXCOORD3;
	float  ClipDepth : TEXCOORD4;
};

VS_OUTPUT main(VS_INPUT input)
{
	VS_OUTPUT output;

	float4 worldPos = float4(input.Position, 1.0f);
	float4 clipPos = mul(worldPos, gWorldViewProj);

	output.Position = clipPos;
	output.WorldPos = input.Position;
	output.Normal = normalize(input.Normal);
	output.TexCoord = input.TexCoord;
	output.LayerData = input.LayerData;
	output.ClipDepth = saturate(clipPos.z / max(clipPos.w, 0.00001f));

	return output;
}