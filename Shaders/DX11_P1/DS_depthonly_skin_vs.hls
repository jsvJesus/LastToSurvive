cbuffer MeshConstants : register(b0)
{
	float4x4 WorldViewProj;
	float4x4 World;
	float4 PositionScale;
	float4 TexcoordScale;
};

cbuffer SkinningConstants : register(b1)
{
	float4x4 BoneMatrices[73];
};

struct DepthOnlySkinVSInput
{
	float4 Position : POSITION;
	float2 TexCoord : TEXCOORD0;
	float4 Normal : NORMAL;
	float4 Tangent : TANGENT;
	float4 BlendWeights : BLENDWEIGHT;
	uint4 BlendIndices : BLENDINDICES;
};

struct DepthOnlyVSOutput
{
	float4 Position : SV_POSITION;
	float2 TexCoord : TEXCOORD0;
};

float4 SkinPosition(float4 position, uint4 indices, float4 weights)
{
	float4 result = 0.0f;
	result += mul(position, BoneMatrices[indices.x]) * weights.x;
	result += mul(position, BoneMatrices[indices.y]) * weights.y;
	result += mul(position, BoneMatrices[indices.z]) * weights.z;
	result += mul(position, BoneMatrices[indices.w]) * weights.w;
	return result;
}

DepthOnlyVSOutput main(DepthOnlySkinVSInput input)
{
	DepthOnlyVSOutput output;
	float4 localPos = float4(input.Position.xyz * PositionScale.xyz, 1.0f);
	float4 skinnedPos = SkinPosition(localPos, input.BlendIndices, input.BlendWeights);
	skinnedPos.w = 1.0f;
	output.Position = mul(skinnedPos, WorldViewProj);
	output.TexCoord = input.TexCoord * TexcoordScale.xy;
	return output;
}
