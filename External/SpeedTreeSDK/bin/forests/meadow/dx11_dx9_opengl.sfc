//
//	Grass
//

// live grass, near
grass_population
{
	%GRASS_NEAR_DENSITY% %GRASS_NEAR_LOD% %GRASS_NEAR_CELL_SIZE% %GRASS_HUE_VARIATION%
	filename "%PATH_COMPILED_ASSETS%/grasses/elephant_grass.srt"
	area %SETTING_RANDOM_AREA%
	scalar_range %GRASS_SCALAR_RANGE%
	mask_filename "%PATH_TERRAIN%/population_mask_grass.tga" mask_channel red 
	ambient_image_scalar %SETTING_AMBIENT_IMAGE_SCALAR% // forward rendering only
}

// live grass, mid
grass_population
{
	%GRASS_MID_DENSITY% %GRASS_MID_LOD% %GRASS_MID_CELL_SIZE% %GRASS_HUE_VARIATION%
	filename "%PATH_COMPILED_ASSETS%/grasses/elephant_grass.srt"
	area %SETTING_RANDOM_AREA%
	scalar_range %GRASS_SCALAR_RANGE%
	mask_filename "%PATH_TERRAIN%/population_mask_grass.tga" mask_channel red 
	ambient_image_scalar %SETTING_AMBIENT_IMAGE_SCALAR% // forward rendering only
}

// dead grass, near
grass_population
{
	%GRASS_NEAR_DENSITY% %GRASS_NEAR_LOD% %GRASS_NEAR_CELL_SIZE% %GRASS_HUE_VARIATION%
	filename "%PATH_COMPILED_ASSETS%/grasses/elephant_grass_dead.srt"
	area %SETTING_RANDOM_AREA%
	scalar_range %GRASS_SCALAR_RANGE%
	mask_filename "%PATH_TERRAIN%/population_mask_grass.tga" mask_channel green
	ambient_image_scalar %SETTING_AMBIENT_IMAGE_SCALAR% // forward rendering only
}

// dead grass, mid
grass_population
{
	%GRASS_MID_DENSITY% %GRASS_MID_LOD% %GRASS_MID_CELL_SIZE% %GRASS_HUE_VARIATION%
	filename "%PATH_COMPILED_ASSETS%/grasses/elephant_grass_dead.srt"
	area %SETTING_RANDOM_AREA%
	scalar_range %GRASS_SCALAR_RANGE%
	mask_filename "%PATH_TERRAIN%/population_mask_grass.tga" mask_channel green
	ambient_image_scalar %SETTING_AMBIENT_IMAGE_SCALAR% // forward rendering only
}

// live-to-dead transition grass, near
grass_population
{
	%GRASS_NEAR_DENSITY% %GRASS_NEAR_LOD% %GRASS_NEAR_CELL_SIZE% %GRASS_HUE_VARIATION%
	filename "%PATH_COMPILED_ASSETS%/grasses/elephant_grass_half_dead.srt"
	area %SETTING_RANDOM_AREA%
	scalar_range %GRASS_SCALAR_RANGE%
	mask_filename "%PATH_TERRAIN%/population_mask_grass.tga" mask_channel blue
	ambient_image_scalar %SETTING_AMBIENT_IMAGE_SCALAR% // forward rendering only
}

// live-to-dead transition grass, mid
grass_population
{
	%GRASS_MID_DENSITY% %GRASS_MID_LOD% %GRASS_MID_CELL_SIZE% %GRASS_HUE_VARIATION%
	filename "%PATH_COMPILED_ASSETS%/grasses/elephant_grass_half_dead.srt"
	area %SETTING_RANDOM_AREA%
	scalar_range %GRASS_SCALAR_RANGE%
	mask_filename "%PATH_TERRAIN%/population_mask_grass.tga" mask_channel blue
	ambient_image_scalar %SETTING_AMBIENT_IMAGE_SCALAR% // forward rendering only
}

// grass with flowers, type 1
grass_population
{
	density 0.1 %GRASS_MID_LOD% %GRASS_MID_CELL_SIZE% 
	filename "%PATH_COMPILED_ASSETS%/grasses/elephant_grass_flower_1.srt"
	area %SETTING_RANDOM_AREA%
	scalar_range %GRASS_SCALAR_RANGE%
	mask_filename "%PATH_TERRAIN%/population_mask_flowers.tga" mask_channel red 
	hue_variation { by_pos 0.1 by_vertex 0.0 color 1 1 1 }
	ambient_image_scalar %SETTING_AMBIENT_IMAGE_SCALAR% // forward rendering only
}

// grass with flowers, type 2
grass_population
{
	density 0.1 %GRASS_MID_LOD% %GRASS_MID_CELL_SIZE% 
	filename "%PATH_COMPILED_ASSETS%/grasses/elephant_grass_flower_2.srt"
	area %SETTING_RANDOM_AREA%
	scalar_range %GRASS_SCALAR_RANGE%
	mask_filename "%PATH_TERRAIN%/population_mask_flowers.tga" mask_channel green 
