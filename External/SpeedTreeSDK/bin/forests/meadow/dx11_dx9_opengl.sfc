//
//  SpeedTree Reference Application Forest Config File
//
//	This file describes a SpeedTree forest scene and is parsed by the 
//	SpeedTree SDK reference application. By convention, we use the SFC 
//	extension for these files (SpeedTree Forest Config).
//
//	SFC files are passed via command-line to the reference application,
//	but this is most commonly handled by using the reference application
//	launching utility.
//
//      Copyright (c) 2003-2016 IDV, Inc.
//      All rights reserved in all media.
//
//      IDV, Inc.
//      http://www.idvinc.com
//


//	Path Macros
//
// 	Each macro assumes a current working directory of where the SFC file
//	resides. All paths in the SFC file are relative from that point.

#platform_all
	#define PATH_COMPILED_ASSETS		"compiled_assets/desktop/$RENDER_TYPE$/dx11_and_opengl"
#platform_dx9
	#define PATH_COMPILED_ASSETS		"compiled_assets/desktop/$RENDER_TYPE$/dx9"
#platform_all

#define PATH_POPULATION_DATA			"population"
#define PATH_TERRAIN					"nonvegetation_assets/terrain"
#define PATH_SKY						"nonvegetation_assets/sky"
#define PATH_POST_EFFECTS				"nonvegetation_assets/post_effects"
#define PATH_CAMERA_FILE				"saved_cameras.txt"
#define PATH_AMBIENT_IMAGE_FILE		"nonvegetation_assets/terrain/ambient_image_plate.dds"


//	Forest Settings
//
// 	These macros are used to keep important flags at the top of the file
//	as they can get rather lengthy.

#define SETTING_SHADOWS_ENABLED		1	// shadow flag must match Compiler app setting
#define SETTING_WIND_ENABLED			1	// will disable wind, but to compile assets with wind off to optimize
#define SETTING_BLOOM_ENABLED			1	// currently works in forward rendering path only
#define SETTING_DISTANCE_BLUR_ENABLED	0	// currently works in deferred rendering path only
#define SETTING_DEPTH_PREPASS_ENABLED	0	// assets must be compiled with a depth prepass enabled
#define SETTING_RANDOM_AREA			"0 10560 0 10560" // area [x_min, x_max, y_min, y_max] of randomly-populated area
#define SETTING_AMBIENT_IMAGE_SCALAR	0.5		// all trees share the same ambient scalar
#define SETTING_TREE_LOD_SCALAR		0.75		// global scalar for overall LOD values


//	Shared Grass Settings
//
// 	A lot of values are shared by the grass models; defined here

#define GRASS_NEAR_LOD 				"lod_range 30 90"
#define GRASS_NEAR_CELL_SIZE 			"cell_size 20"
#define GRASS_NEAR_DENSITY			"density 0.18"

#define GRASS_MID_LOD 				"lod_range 250 450"
#define GRASS_MID_CELL_SIZE 			"cell_size 40"
#define GRASS_MID_DENSITY				"density 0.14"

#define GRASS_SCALAR_RANGE			"0.55 0.65"
#define GRASS_HUE_VARIATION			"hue_variation { by_pos -0.0125 by_vertex -0.05 color 1 1 1 } "


//	Misc Shared Settings
#define COMMON_HUE_VARIATION			"{ by_pos 0.015 by_vertex 0.0 color 1 1 1 }"


//
//	Forest Population
//

// random tree population isn't used in this example SFC file, but this is the syntax:
//
//	random_tree_population
//	{
//		filename "%PATH_COMPILED_ASSETS%/my_tree/my_tree.srt" 
//		quantity 100 
//		area %SETTING_RANDOM_AREA%
//		seed 5
//		lod_scalar 1.0
//		scalar_range 0.5 1.5
//		ambient_image_scalar 0.3
//	}


// meadow broadleaves
speedforest_population
{
	speedforest_filename "%PATH_POPULATION_DATA%/meadow_broadleaf_1.instances"
	srt_filename "%PATH_COMPILED_ASSETS%/meadow_broadleaves/meadow_broadleaf_1.srt"
	follow_terrain true
	lod_scalar 0.75
	hue_variation { by_pos 0.025 by_vertex 0.075 color 1 1 1 }
	ambient_image_scalar %SETTING_AMBIENT_IMAGE_SCALAR% // forward rendering only
}

speedforest_population
{
	speedforest_filename "%PATH_POPULATION_DATA%/meadow_broadleaf_2.instances"
	srt_filename "%PATH_COMPILED_ASSETS%/meadow_broadleaves/meadow_broadleaf_2.srt"
	follow_terrain true
	lod_scalar 0.75
	hue_variation { by_pos 0.025 by_vertex 0.075 color 1 1 1 }
	ambient_image_scalar %SETTING_AMBIENT_IMAGE_SCALAR% // forward rendering only
}

