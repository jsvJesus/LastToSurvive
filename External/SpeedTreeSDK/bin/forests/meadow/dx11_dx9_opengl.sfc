	ambient_image_scalar %SETTING_AMBIENT_IMAGE_SCALAR% // forward rendering only
}


//
//	Configuration settings
//

world
{
	// camera-related
	near_clip 0.25
	far_clip 5280	
	fov 55
	3dtree_cell_size 600
	
	// LOD
	tree_lod_scalar %SETTING_TREE_LOD_SCALAR%
	
	// population
	tree_surface_adhesion 0.1
	grass_surface_adhesion 0.9
	random_population_scalar 1
	grass_density_scalar 1.0
	
	// alpha thickness
	alpha_test_scalar_3d 0.2
	alpha_test_scalar_grass 0.8
	alpha_test_scalar_billboard 0.2
}

fog
{
	linear 100 5280
	color 0.54 0.63 0.765
	density 0.0000005
}

terrain
{
	// general
	shader_path "%PATH_TERRAIN%/$RENDER_TYPE$"
	max_resolution 33
	lod_levels 4
	cell_size 500
	tiles 1
	
	// height map
	height_map_filename "%PATH_TERRAIN%/heightmap.tga"
	height_map_size 10560 10560 600
	
	// splat map
	splat_map_filename "%PATH_TERRAIN%/splats.dds"
	
	// lighting
	ambient 0.8 0.8 0.8
	diffuse 0.7 0.7 0.7
	ambient_occlusion_brightness 0.0
	ambient_occlusion_distance 25.0
	ambient_image_scalar %SETTING_AMBIENT_IMAGE_SCALAR%
	normal_map_filename "%PATH_TERRAIN%/heightmap_normals.dds"

	splat_layer_0
	{
		filename "%PATH_TERRAIN%/ground.dds"
		repeat 600
		approx_color 0.41 0.35 0.31
	}
	
	splat_layer_1
	{
		filename "%PATH_TERRAIN%/green_far.dds"
		repeat 20
		approx_color 0.30 0.31 0.17
	}
	
	splat_layer_2
	{
		filename "%PATH_TERRAIN%/dead_far.dds"
		repeat 100
		approx_color 0.266 0.337 0.1333
	}
}

lighting
{	
	forward
	{
		ambient 0.2 0.2 0.2
		specular 1.8 1.8 1.8
		diffuse 1.7 1.7 1.7
		transmission 1 1 1
	}

	deferred
	{
		ambient 0.4 0.4 0.4
		specular 0.95 0.95 0.95
		diffuse 1.75 1.75 1.75
		transmission 1 1 1
	}

	direction 0.19 -0.68 -0.7

	bloom
	{
	    enabled %SETTING_BLOOM_ENABLED%
	    downsample 6
	    bright_pass 0.25
	    bright_floor 0.1
	    blur 40
	    bloom_effect_scalar 0.6
	    main_effect_scalar 0.92
	    sky_bleed 0.2
	}

	image_based_ambient_lighting
	{
		filename %PATH_AMBIENT_IMAGE_FILE%
	}

	// lerp to these colors when the sun is lower in the sky
	twilight
	{
		horizon_color 0.98 0.51 0.12
		ambient 0.1 0.1 0.1
		diffuse 0.9 0.48 0.0
		transmission 0.4 0.4 0.4
		specular 0.45 0.35 0.35
	}
}

shadows
{
	enabled %SETTING_SHADOWS_ENABLED%
	resolution 2048
	num_maps 3
	map_distances 170 420 750 5000
	map_update_intervals 1 2 3 4
	fade 0.2
	behind_camera_dist 5000
} 

wind
{
 	// if the tree shaders were compiled with wind enabled, turning it off here will keep them still,
	// but they'll still execute the wind vertex shader code
	enabled %SETTING_WIND_ENABLED%
 	gusting false
	strength 0.5
	direction 1 0 0
}

sky
{
	shader_path "%PATH_SKY%"
	color 0.6 0.7 0.85

	sun_size 0.0025
	sun_spread_exponent 100

	texture "%PATH_SKY%/skydome.dds"
	
	// lerp to these colors when the sun is lower in the sky
	twilight
	{
		sun_size 0.005
		sun_spread_exponent 50
		color 0.1 0.05 0.3
	}
}

navigation
{
	camera_file "%PATH_CAMERA_FILE%"
	follow_height 10
	translate_scalar 50
	rotate_scalar 0.002
}

forward_render
{
	depth_prepass %SETTING_DEPTH_PREPASS_ENABLED%
	post_effects_shader_path "%PATH_POST_EFFECTS%"
}

deferred_render
{
	depth_prepass %SETTING_DEPTH_PREPASS_ENABLED%
	post_effects_shader_path "%PATH_POST_EFFECTS%"
	distance_blur %SETTING_DISTANCE_BLUR_ENABLED%
}

// parameters for running in demo mode at trade shows
demo
{
	camera_time 5 5
	camera_speed 1 2
	sun_speed 0.04
	keyboard_lock false
	cameras_editable true

	// internal development tool
	hand_tuned_name0 "sky red"
	hand_tuned_value0 1.0 0.0 2.0 0.005 // value, min clamp, max clamp, adjustment speed
}

overlays
{
	shader_path "%PATH_POST_EFFECTS%"

	// position (0,0) is the bottom-left of the screen, (1,1) is top-right
	// size is [0,1] and controls the width of the logo as a percent of the screen's width (image aspect ratio is locked)
	// anchor controls which corner of image will be placed at pos
	//  [0 1 2]
	//  [3 4 5]
	//  [6 7 8]

	//overlay { filename "%PATH_POST_EFFECTS%/SpeedTree_Logo.dds" pos 0.98 -0.025 size 0.2 anchor 8 }
}
