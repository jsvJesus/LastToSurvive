<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTemplate x:Key="AppSelectButtonTemplate" TargetType="Button">
    <Border x:Name="BackgroundBorder" Padding="{TemplateBinding Padding}" BorderBrush="#A2944E0F" CornerRadius="2,2,2,2">
      <Border.Background>
        <SolidColorBrush Color="#FF2F3F4F"/>
      </Border.Background>
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="BackgroundBorder" Property="Background" Value="#FF778899"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="BackgroundBorder" Property="Background" Value="#FF708090"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
</ResourceDictionary>