<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  Height="78"
  Background="#FF4D5052"
  Foreground="#FFE1E9ED" d:DesignWidth="1920" d:DesignHeight="1080">
  <Grid Height="78" Margin="0,0,0,1000">
    <Image x:Name="MainMenu_Background" Source="Assets/MainMenu/Top_Bar.png" Stretch="None">
      <Image.Resources>
        <ResourceDictionary/>
      </Image.Resources>
    </Image>
    <Image x:Name="Image_LVL_Badge" Source="Assets/MainMenu/badge_lvl/topbar_lvl_badge.png" Width="67" Height="62" Margin="12,9,1842,7"/>
    <TextBlock x:Name="Text_Val_LVL" Text="5" Width="50" Height="50" Margin="0,0,1830,0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,10,0,10" FontFamily="Play" FontSize="24" TextAlignment="Center" TextWrapping="Wrap"/>
    <TextBlock x:Name="Text_Val_CharacterName" Text="ES3N1N" Width="125" Height="50" Margin="94,27,1701,27" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,10,0,0" FontSize="24" TextAlignment="Center" TextWrapping="Wrap"/>
    <Image x:Name="Image_Money_ZG" Source="Assets/MainMenu/btn_money/btn_money_zc.png" Height="36" Margin="0,0,1404,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <TextBlock x:Name="Text_Val_Money_ZG" Text="999999999" Width="75" Height="20" Margin="0,0,1293,0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5,0,5,0" Foreground="#FFFFFFFF" FontFamily="Play" FontSize="14" FontWeight="Light" TextAlignment="Right" TextWrapping="Wrap">
      <TextBlock.Background>
        <ImageBrush ImageSource="Assets/MainMenu/topbar_money_bg.png"/>
      </TextBlock.Background>
    </TextBlock>
    <Image x:Name="Image_Money_ZD" Source="Assets/MainMenu/btn_money/btn_money_zd.png" Height="36" Margin="0,0,1164,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <TextBlock x:Name="Text_Val_Money_ZD" Text="999999999" Width="75" Height="20" Margin="0,0,1053,0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5,0,5,0" Foreground="#FFFFFFFF" FontFamily="Play" FontSize="14" FontWeight="Light" TextAlignment="Right" TextWrapping="Wrap">
      <TextBlock.Background>
        <ImageBrush ImageSource="Assets/MainMenu/topbar_money_bg.png"/>
      </TextBlock.Background>
    </TextBlock>
    <Image x:Name="Image_Money_ZD001" Source="Assets/MainMenu/btn_money/btn_money_zlt.png" Height="36" Margin="0,0,924,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <TextBlock x:Name="Text_Val_Money_ZLT" Text="999999999" Width="75" Height="20" Margin="0,0,813,0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5,0,5,0" Foreground="#FFFFFFFF" FontFamily="Play" FontSize="14" FontWeight="Light" TextAlignment="Right" TextWrapping="Wrap">
      <TextBlock.Background>
        <ImageBrush ImageSource="Assets/MainMenu/topbar_money_bg.png"/>
      </TextBlock.Background>
    </TextBlock>
    <Button x:Name="nav_home" Content="HOME" Width="150" Height="43" Margin="0,0,470,0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,2,8,2" FontFamily="Exo 2" FontSize="24">
      <Button.Background>
        <ImageBrush ImageSource="Assets/MainMenu/btn_tabs/button_top_bar.png"/>
      </Button.Background>
    </Button>
    <Button x:Name="nav_skills" Content="SKILLS" Width="150" Height="43" Margin="0,1,130,0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,2,8,2" FontFamily="Exo 2" FontSize="24">
      <Button.Background>
        <ImageBrush ImageSource="Assets/MainMenu/btn_tabs/button_top_bar.png"/>
      </Button.Background>
    </Button>
    <Button x:Name="nav_equipment" Content="EQUIPMENT" ClickMode="Hover" Width="150" Height="43" Margin="209,1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,2,8,2" FontFamily="Exo 2" FontSize="24">
      <Button.Background>
        <ImageBrush ImageSource="Assets/MainMenu/btn_tabs/button_top_bar.png"/>
      </Button.Background>
      <Button.CommandTarget>
        <Button/>
      </Button.CommandTarget>
    </Button>
    <Button x:Name="nav_shop" Content="SHOP" Width="150" Height="43" Margin="549,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,2,8,2" FontFamily="Exo 2" FontSize="24">
      <Button.Background>
        <ImageBrush ImageSource="Assets/MainMenu/btn_tabs/button_top_bar.png"/>
      </Button.Background>
    </Button>
    <Button x:Name="nav_clan" Content="CLAN" Width="150" Height="43" Margin="890,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,2,8,2" FontFamily="Exo 2" FontSize="24">
      <Button.Background>
        <ImageBrush ImageSource="Assets/MainMenu/btn_tabs/button_top_bar.png"/>
      </Button.Background>
    </Button>
    <Button x:Name="nav_friends" Content="FRIENDS" Width="150" Height="43" Margin="1230,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,2,8,2" FontFamily="Exo 2" FontSize="24">
      <Button.Background>
        <ImageBrush ImageSource="Assets/MainMenu/btn_tabs/button_top_bar.png"/>
      </Button.Background>
    </Button>
    <Button x:Name="btn_changename" Width="48" Height="58" Margin="1708,10,164,10" ToolTip="CHANGE NAME" ToolTipService.Placement="Bottom" ToolTipService.InitialShowDelay="100">
      <Button.Background>
        <ImageBrush ImageSource="Assets/MainMenu/btn_actions/btn_change_name.png"/>
      </Button.Background>
    </Button>
    <Button x:Name="btn_rating" Width="48" Height="58" Margin="1756,10,116,10" ToolTip="RATING" ToolTipService.Placement="Bottom" ToolTipService.InitialShowDelay="100">
      <Button.Background>
        <ImageBrush ImageSource="Assets/MainMenu/btn_actions/btn_rating.png"/>
      </Button.Background>
    </Button>
    <Button x:Name="btn_options" Width="48" Height="58" Margin="1804,10,68,10" ToolTip="OPTIONS" ToolTipService.Placement="Bottom" ToolTipService.InitialShowDelay="100">
      <Button.Background>
        <ImageBrush ImageSource="Assets/MainMenu/btn_actions/btn_settings.png"/>
      </Button.Background>
    </Button>
    <Button x:Name="btn_frontend_exit" Width="48" Height="58" Margin="1852,10,20,10" ToolTip="EXIT" ToolTipService.Placement="Bottom" ToolTipService.InitialShowDelay="100">
      <Button.Background>
        <ImageBrush ImageSource="Assets/MainMenu/btn_actions/btn_frontend_exit.png"/>
      </Button.Background>
    </Button>
  </Grid>
</Window>