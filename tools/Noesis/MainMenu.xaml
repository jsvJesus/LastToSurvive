<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:noesis="clr-namespace:NoesisGUIExtensions"
  mc:Ignorable="d"
  Height="78"
  Background="#FF4D5052"
  Foreground="#FFE1E9ED" d:DesignWidth="1920" d:DesignHeight="1080">
  <Grid x:Name="MainMenu" Height="78" Margin="0,0,0,1002">
    <Image x:Name="MainMenu_Background" Source="Assets/MainMenu/top_panel/top_panel_bg.png" Stretch="None">
      <Image.Resources>
        <ResourceDictionary/>
      </Image.Resources>
    </Image>
    <Grid x:Name="MainMenu_Left_Money" d:IsLocked="True">
      <Grid x:Name="Money_ZC" Width="164" Margin="56,0,1700,0">
        <Image x:Name="Image_money_zc" Source="Assets/MainMenu/btn_money/btn_money_zlt.png" Width="64" Height="64" Margin="0,7,100,7"/>
        <Button x:Name="Button_buy_money_zc" Width="14" Height="14" Margin="45,32,105,32">
          <Button.Background>
            <ImageBrush ImageSource="Assets/MainMenu/top_panel/Btn/button_plus.png"/>
          </Button.Background>
        </Button>
        <TextBlock x:Name="Text_val_money_zc" Text="999999999" Width="100" Height="32" Margin="64,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,5,0,5" FontFamily="Exo 2" FontSize="18" TextAlignment="Center" TextWrapping="Wrap" d:IsLocked="True"/>
      </Grid>
      <Grid x:Name="Money_ZD" Width="164" Margin="241,0,1515,0" d:IsLocked="True">
        <Image x:Name="Image_money_zd" Source="Assets/MainMenu/btn_money/btn_money_zd.png" Width="64" Height="64" Margin="0,7,100,7"/>
        <Button x:Name="Button_buy_money_zd" Content="Button" Width="14" Height="14" Margin="45,32,105,32">
          <Button.Background>
            <ImageBrush ImageSource="Assets/MainMenu/top_panel/Btn/button_plus.png"/>
          </Button.Background>
        </Button>
        <TextBlock x:Name="Text_val_money_zd" Text="999999999" Width="100" Height="32" Margin="64,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,5,0,5" FontFamily="Exo 2" FontSize="18" TextAlignment="Center" TextWrapping="Wrap"/>
      </Grid>
    </Grid>
    <Grid x:Name="MainMenu_Center_Buttons" Width="1000" d:IsLocked="True">
      <Button Content="HOME" Width="200" Height="78" Margin="0,0,800,0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,0,0,0" FontFamily="Play" FontSize="24">
        <Button.Background>
          <ImageBrush ImageSource="Assets/MainMenu/top_panel/Btn/Button_1.png"/>
        </Button.Background>
      </Button>
      <Button Content="SKILLS" Width="200" Height="78" Margin="0,0,400,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Play" FontSize="24">
        <Button.Background>
          <ImageBrush ImageSource="Assets/MainMenu/top_panel/Btn/Button_2.png"/>
        </Button.Background>
      </Button>
      <Button Content="EQUIPMENT" Width="200" Height="78" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Play" FontSize="24">
        <Button.Background>
          <ImageBrush ImageSource="Assets/MainMenu/top_panel/Btn/Button_3.png"/>
        </Button.Background>
      </Button>
      <Button Content="SHOP" Width="200" Height="78" Margin="400,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Play" FontSize="24">
        <Button.Background>
          <ImageBrush ImageSource="Assets/MainMenu/top_panel/Btn/Button_4.png"/>
        </Button.Background>
      </Button>
      <Button Content="CLAN" Width="200" Height="78" Margin="800,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Play" FontSize="24">
        <Button.Background>
          <ImageBrush ImageSource="Assets/MainMenu/top_panel/Btn/Button_5.png"/>
        </Button.Background>
      </Button>
    </Grid>
    <Grid x:Name="MainMenu_Left_Actions">
      <Button x:Name="nav_awards" Width="64" Height="78" Margin="1594,0,262,0" ToolTip="AWARDS" ToolTipService.Placement="Bottom" ToolTipService.InitialShowDelay="150">
        <Button.Background>
          <ImageBrush/>
        </Button.Background>
        <Image x:Name="Image_Awards" Source="Assets/MainMenu/top_panel/Btn/awards.png" Width="32" Height="32"/>
      </Button>
      <Button x:Name="naw_rating" Width="64" Height="78" Margin="1658,0,198,0" ToolTip="RATING" ToolTipService.Placement="Bottom" ToolTipService.InitialShowDelay="150">
        <Button.Background>
          <ImageBrush/>
        </Button.Background>
        <Image x:Name="Image_Rating" Source="Assets/MainMenu/top_panel/Btn/rating.png" Width="32" Height="32"/>
      </Button>
      <Button x:Name="nav_options" Width="64" Height="78" Margin="1722,0,134,0" ToolTip="OPTIONS" ToolTipService.Placement="Bottom" ToolTipService.InitialShowDelay="150">
        <Button.Background>
          <ImageBrush/>
        </Button.Background>
        <Image x:Name="Image_Options" Source="Assets/MainMenu/top_panel/Btn/options.png" Width="32" Height="32"/>
      </Button>
      <Button x:Name="nav_exit" Width="64" Height="78" Margin="1786,0,70,0" BorderBrush="{x:Null}" ToolTip="EXIT" ToolTipService.Placement="Bottom" ToolTipService.InitialShowDelay="150">
        <Button.Background>
          <ImageBrush/>
        </Button.Background>
        <Image x:Name="Image_Exit" Source="Assets/MainMenu/top_panel/Btn/exit.png" Width="32" Height="32"/>
      </Button>
    </Grid>
  </Grid>
</Window>