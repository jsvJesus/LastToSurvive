      <Button.Background>
        <ImageBrush ImageSource="Assets/MainMenu/ShowPopupWindow/button_popup_1.png"/>
      </Button.Background>
    </Button>
    <Button x:Name="button_popup_2" Content="BACK" Width="140" Height="33" Margin="310,177,150,30">
      <Button.Background>
        <ImageBrush ImageSource="Assets/MainMenu/ShowPopupWindow/button_popup_2.png"/>
      </Button.Background>
    </Button>
  </Grid>
