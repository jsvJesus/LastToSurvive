    <Image x:Name="button_arrov_prev_left" Source="Assets/MainMenu/ShowPopupWindow/button_arrov_prev_left.png" Width="9" Margin="193,115,399,114"/>
    <Image x:Name="button_arrov_prev_right" Source="Assets/MainMenu/ShowPopupWindow/button_arrov_prev_right.png" Width="9" Margin="293,115,299,114"/>
    <Image x:Name="btn_money_zlt" Source="Assets/MainMenu/btn_money/btn_money_zlt.png" Width="24" Height="24" Margin="204,108,373,108"/>
